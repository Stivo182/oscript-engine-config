&Тест
Процедура ТестДолжен_ПеречитатьПоявившийсяНеобязательныйCFG() Экспорт

    // Подготовка
    ПутьCFG = ОбъединитьПути(_Каталог, "optional-created.cfg");
    Построитель = Новый ПостроительКонфигурацииИнтерпретатора;
    Построитель.ДобавитьНеобязательныйФайлКонфигурации(ПутьCFG);
    ПустаяКонфигурация = Построитель.Построить();

    // Действие
    ЗаписатьТекст(ПутьCFG, "value=created");
    Конфигурация = Построитель.Построить();

    // Проверка
    Ожидаем.Что(ПустаяКонфигурация.Содержит("value")).Равно(Ложь);
    Ожидаем.Что(Конфигурация.ПолучитьЗначение("value")).Равно("created");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропуститьОтсутствующийАвтоматическийCFG() Экспорт

    // Действие
    Результат = ВыполнитьДочернийСценарий(Неопределено);

    // Проверка
    Ожидаем.Что(Результат).Равно("OK");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОбернутьОшибкуПоврежденногоАвтоматическогоCFG() Экспорт

    // Действие
    Результат = ВыполнитьДочернийСценарий("=invalid");

    // Проверка
    Ожидаем.Что(Результат).Равно(КодыОшибокКонфигурацииИнтерпретатора.РасчетКонфигурацииНеВыполнен());

КонецПроцедуры

&Тест
Процедура ТестДолжен_СформироватьСтандартныеИсточникиКакРучнуюПоследовательность() Экспорт

    // Подготовка
    УстановитьПеременнуюСреды("OSCRIPT_CONFIG", "manual=value");
    АвтоматическийПостроитель = Новый ПостроительКонфигурацииИнтерпретатора;
    АвтоматическийПостроитель.ДобавитьСтандартныеИсточники();
    РучнойПостроитель = Новый ПостроительКонфигурацииИнтерпретатора;
    ДобавитьСуществующийCFGТекущегоЗапуска(РучнойПостроитель);
    РучнойПостроитель.ДобавитьТекущееОкружение(ТекущийКаталог());

    // Действие
    Автоматическая = АвтоматическийПостроитель.Построить();
    Ручная = РучнойПостроитель.Построить();

    // Проверка
    Ожидаем.Что(Автоматическая.ВСтрокуОкружения()).Равно(Ручная.ВСтрокуОкружения());

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьПовторныйИсточник() Экспорт

    // Действие
    Конфигурация = Новый ПостроительКонфигурацииИнтерпретатора()
        .ДобавитьНастройкиОкружения("value=duplicate", _РабочийКаталог)
        .ДобавитьНастройкиОкружения("value=middle", _РабочийКаталог)
        .ДобавитьНастройкиОкружения("value=duplicate", _РабочийКаталог)
        .Построить();

    // Проверка
    Ожидаем.Что(Конфигурация.ПолучитьЗначение("value")).Равно("duplicate");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПостроитьПослеИсправленияИсточника() Экспорт

    // Подготовка
    ПутьCFG = ОбъединитьПути(_Каталог, "recoverable.cfg");
    Построитель = Новый ПостроительКонфигурацииИнтерпретатора;
    Построитель.ДобавитьФайлКонфигурации(ПутьCFG);
    Ошибка = ПолучитьОшибкуПостроения(Построитель);

    // Действие
    ЗаписатьТекст(ПутьCFG, "value=recovered");
    Конфигурация = Построитель.Построить();

    // Проверка
    Ожидаем.Что(Ошибка = Неопределено).Равно(Ложь);
    Ожидаем.Что(Конфигурация.ПолучитьЗначение("value")).Равно("recovered");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеИзменитьПредыдущийРезультатПослеОшибки() Экспорт

    // Подготовка
    ПутьCFG = ОбъединитьПути(_Каталог, "mutable.cfg");
    ЗаписатьТекст(ПутьCFG, "value=valid");
    Построитель = Новый ПостроительКонфигурацииИнтерпретатора;
    Построитель.ДобавитьФайлКонфигурации(ПутьCFG);
    Конфигурация = Построитель.Построить();

    // Действие
    ЗаписатьТекст(ПутьCFG, "=invalid");
    Ошибка = ПолучитьОшибкуПостроения(Построитель);

    // Проверка
    Ожидаем.Что(Ошибка = Неопределено).Равно(Ложь);
    Ожидаем.Что(Конфигурация.ПолучитьЗначение("value")).Равно("valid");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВозвращатьНезависимыеРезультатыПостроения() Экспорт

    // Подготовка
    Построитель = Новый ПостроительКонфигурацииИнтерпретатора;
    Построитель.ДобавитьНастройкиОкружения("value=source", _РабочийКаталог);
    ПерваяКонфигурация = Построитель.Построить();

    // Действие
    ПерваяКонфигурация.Установить("value", "changed");
    ВтораяКонфигурация = Построитель.Построить();

    // Проверка
    Ожидаем.Что(ПерваяКонфигурация.ПолучитьЗначение("value")).Равно("changed");
    Ожидаем.Что(ВтораяКонфигурация.ПолучитьЗначение("value")).Равно("source");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеИзменитьСостояниеПроцесса() Экспорт

    // Подготовка
    ПутьCFG = ОбъединитьПути(_Каталог, "unchanged.cfg");
    ЗаписатьТекст(ПутьCFG, "value=source");
    УстановитьПеременнуюСреды("OSCRIPT_CONFIG", "environment=value");
    УстановитьТекущийКаталог(_РабочийКаталог);
    Построитель = Новый ПостроительКонфигурацииИнтерпретатора;
    Построитель
        .ДобавитьФайлКонфигурации(ПутьCFG)
        .ДобавитьСтандартныеИсточники();

    // Действие
    Построитель.Построить();

    // Проверка
    Ожидаем.Что(ПолучитьПеременнуюСреды("OSCRIPT_CONFIG")).Равно("environment=value");
    Ожидаем.Что(ТекущийКаталог()).Равно(_РабочийКаталог);
    Ожидаем.Что(ПрочитатьТекст(ПутьCFG)).Равно("value=source");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьОшибкуПостроения(Построитель)

    Ошибка = Неопределено;
    Попытка
        Построитель.Построить();
    Исключение
        Ошибка = ИнформацияОбОшибке();
    КонецПопытки;

    Возврат Ошибка;

КонецФункции

Процедура ДобавитьСуществующийCFGТекущегоЗапуска(Построитель)

    КаталогДвижка = Новый Файл(ОбъединитьПути(КаталогПрограммы(), "..")).ПолноеИмя;
    СистемныйCFG = ОбъединитьПути(КаталогДвижка, "bin", "oscript.cfg");
    Если Новый Файл(СистемныйCFG).Существует() Тогда
        Построитель.ДобавитьФайлКонфигурации(СистемныйCFG);
    КонецЕсли;

    ВходнойCFG = ОбъединитьПути(СтартовыйСценарий().Каталог, "oscript.cfg");
    Если Новый Файл(ВходнойCFG).Существует() Тогда
        Построитель.ДобавитьФайлКонфигурации(ВходнойCFG);
    КонецЕсли;

КонецПроцедуры

Функция ВыполнитьДочернийСценарий(ТекстCFG)

    КаталогИсходников = Новый Файл(
        ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src")
    ).ПолноеИмя;
    КаталогМодулей = Новый Файл(
        ОбъединитьПути(КаталогИсходников, "..", "oscript_modules")
    ).ПолноеИмя;
    ПутьСценария = ОбъединитьПути(_КаталогТочкиВхода, "main.os");
    ПутьРезультата = ОбъединитьПути(_Каталог, "result.txt");

    ТекстСценария = СтрШаблон(
        "#Использовать ""%1""
        |#Использовать errors
        |
        |ПутьCFG = ОбъединитьПути(СтартовыйСценарий().Каталог, ""oscript.cfg"");
        |CFGСоздан = АргументыКоманднойСтроки.Количество() > 1;
        |Если CFGСоздан Тогда
        |    Документ = Новый ТекстовыйДокумент;
        |    Документ.УстановитьТекст(АргументыКоманднойСтроки[1]);
        |    Документ.Записать(ПутьCFG);
        |КонецЕсли;
        |
        |Попытка
        |    Конфигурация = Новый ПостроительКонфигурацииИнтерпретатора()
        |        .ДобавитьСтандартныеИсточники()
        |        .Построить();
        |    Результат = ""OK"";
        |Исключение
        |    Результат = ДиагностикаОшибок.КодОшибки(ИнформацияОбОшибке());
        |КонецПопытки;
        |
        |Если CFGСоздан Тогда
        |    УдалитьФайлы(ПутьCFG);
        |КонецЕсли;
        |
        |Документ = Новый ТекстовыйДокумент;
        |Документ.УстановитьТекст(Результат);
        |Документ.Записать(АргументыКоманднойСтроки[0]);",
        КаталогИсходников
    );
    ЗаписатьТекст(ПутьСценария, ТекстСценария);

    УстановитьПеременнуюСреды("OSCRIPT_CONFIG", "lib.system=" + КаталогМодулей);
    СтрокаЗапуска = СтрШаблон("oscript ""%1"" ""%2""", ПутьСценария, ПутьРезультата);
    Если ТекстCFG <> Неопределено Тогда
        СтрокаЗапуска = СтрокаЗапуска + " """ + ТекстCFG + """";
    КонецЕсли;

    Процесс = СоздатьПроцесс(СтрокаЗапуска, _РабочийКаталог);
    Процесс.Запустить();
    Процесс.ОжидатьЗавершения();

    Ожидаем.Что(Процесс.КодВозврата, "Код возврата дочернего сценария").Равно(0);

    Возврат ПрочитатьТекст(ПутьРезультата);

КонецФункции

Процедура ЗаписатьТекст(Путь, Текст)
    Документ = Новый ТекстовыйДокумент;
    Документ.УстановитьТекст(Текст);
    Документ.Записать(Путь);
КонецПроцедуры

Функция ПрочитатьТекст(Путь)
    Документ = Новый ТекстовыйДокумент;
    Документ.Прочитать(Путь);
    Возврат СокрЛП(Документ.ПолучитьТекст());
КонецФункции

#КонецОбласти
