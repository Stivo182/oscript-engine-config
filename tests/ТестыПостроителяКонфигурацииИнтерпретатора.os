#Использовать asserts
#Использовать errors
#Использовать tempfiles
#Использовать "../src"
#Использовать "../src/internal"

Перем _ВременныеФайлы; // МенеджерВременныхФайлов
Перем _Каталог; // Строка
Перем _КаталогТочкиВхода; // Строка
Перем _РабочийКаталог; // Строка
Перем _ИсходноеОкружение; // Строка, Неопределено
Перем _ИсходныйКаталог; // Строка

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередВсеми
Процедура ПередВсеми() Экспорт
    _ВременныеФайлы = Новый МенеджерВременныхФайлов;
КонецПроцедуры

&ПередКаждым
Процедура ПередКаждым() Экспорт

    _ИсходноеОкружение = ПолучитьПеременнуюСреды("OSCRIPT_CONFIG");
    _ИсходныйКаталог = ТекущийКаталог();
    _Каталог = _ВременныеФайлы.СоздатьКаталог();
    УстановитьТекущийКаталог(_Каталог);
    _Каталог = ТекущийКаталог();
    УстановитьТекущийКаталог(_ИсходныйКаталог);
    _КаталогТочкиВхода = ОбъединитьПути(_Каталог, "entry");
    _РабочийКаталог = ОбъединитьПути(_Каталог, "cwd");

    СоздатьКаталог(_КаталогТочкиВхода);
    СоздатьКаталог(_РабочийКаталог);

КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт

    УстановитьПеременнуюСреды("OSCRIPT_CONFIG", _ИсходноеОкружение);
    УстановитьТекущийКаталог(_ИсходныйКаталог);

    Ожидаем.Что(ПолучитьПеременнуюСреды("OSCRIPT_CONFIG")).Равно(_ИсходноеОкружение);
    Ожидаем.Что(ТекущийКаталог()).Равно(_ИсходныйКаталог);

    _ВременныеФайлы.Удалить();

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_ПостроитьПустуюКонфигурацию() Экспорт

    // Подготовка
    УстановитьПеременнуюСреды("OSCRIPT_CONFIG", "unexpected=value");
    Построитель = Новый ПостроительКонфигурацииИнтерпретатора;

    // Действие
    Конфигурация = Построитель.Построить();

    // Проверка
    Ожидаем.Что(Конфигурация.Ключи().Количество()).Равно(0);
    Ожидаем.Что(Новый ЛокаторБиблиотекПоКонфигурации(Конфигурация).ПолучитьКаталогиПоиска().Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПрименитьФайлыКонфигурацииВПорядкеДобавления() Экспорт

    // Подготовка
    ПервыйCFG = ОбъединитьПути(_Каталог, "first.cfg");
    ВторойCFG = ОбъединитьПути(_Каталог, "second.cfg");
    ЗаписатьТекст(ПервыйCFG, "shared=first");
    ЗаписатьТекст(ВторойCFG, "shared=second");
    Построитель = Новый ПостроительКонфигурацииИнтерпретатора;

    // Действие
    НастроенныйПостроитель = Построитель
        .ДобавитьФайлКонфигурации(ПервыйCFG)
        .ДобавитьФайлКонфигурации(ВторойCFG);
    Конфигурация = НастроенныйПостроитель.Построить();

    // Проверка
    Ожидаем.Что(НастроенныйПостроитель = Построитель).Равно(Истина);
    Ожидаем.Что(Конфигурация.ПолучитьЗначение("shared")).Равно("second");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПрименитьЯвноеОкружениеВПорядкеДобавления() Экспорт

    // Подготовка
    ПутьCFG = ОбъединитьПути(_Каталог, "source.cfg");
    ЗаписатьТекст(ПутьCFG, "shared=cfg");
    Построитель = Новый ПостроительКонфигурацииИнтерпретатора;

    // Действие
    Конфигурация = Построитель
        .ДобавитьФайлКонфигурации(ПутьCFG)
        .ДобавитьНастройкиОкружения(
            "shared=environment;lib.additional=relative-lib",
            _РабочийКаталог
        )
        .Построить();

    // Проверка
    Ожидаем.Что(Конфигурация.ПолучитьЗначение("shared")).Равно("environment");
    Ожидаем.Что(Новый ЛокаторБиблиотекПоКонфигурации(Конфигурация).ПолучитьКаталогиПоиска()[0])
        .Равно(ОбъединитьПути(_РабочийКаталог, "relative-lib"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВставитьСтандартныеИсточникиВПозициюВызова() Экспорт

    // Подготовка
    УстановитьПеременнуюСреды("OSCRIPT_CONFIG", "shared=current");
    Построитель = Новый ПостроительКонфигурацииИнтерпретатора;

    // Действие
    Конфигурация = Построитель
        .ДобавитьНастройкиОкружения("shared=before", _РабочийКаталог)
        .ДобавитьСтандартныеИсточники()
        .ДобавитьНастройкиОкружения("shared=after", _РабочийКаталог)
        .Построить();

    // Проверка
    Ожидаем.Что(Конфигурация.ПолучитьЗначение("shared")).Равно("after");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаменитьКлючБезУчетаРегистраИБазуПути() Экспорт

    // Подготовка
    ПервыйКаталог = ОбъединитьПути(_Каталог, "first");
    ВторойКаталог = ОбъединитьПути(_Каталог, "second");
    СоздатьКаталог(ПервыйКаталог);
    СоздатьКаталог(ВторойКаталог);
    ПервыйCFG = ОбъединитьПути(ПервыйКаталог, "oscript.cfg");
    ВторойCFG = ОбъединитьПути(ВторойКаталог, "oscript.cfg");
    ЗаписатьТекст(ПервыйCFG, "Lib.Additional=first-lib");
    ЗаписатьТекст(ВторойCFG, "lib.additional=second-lib");

    // Действие
    Конфигурация = Новый ПостроительКонфигурацииИнтерпретатора()
        .ДобавитьФайлКонфигурации(ПервыйCFG)
        .ДобавитьФайлКонфигурации(ВторойCFG)
        .Построить();

    // Проверка
    Ожидаем.Что(Конфигурация.Ключи()[0]).Равно("lib.additional");
    Ожидаем.Что(Новый ЛокаторБиблиотекПоКонфигурации(Конфигурация).ПолучитьКаталогиПоиска()[0])
        .Равно(ОбъединитьПути(ВторойКаталог, "second-lib"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПеречитатьФайлКонфигурации() Экспорт

    // Подготовка
    ПутьCFG = ОбъединитьПути(_Каталог, "source.cfg");
    ЗаписатьТекст(ПутьCFG, "value=first");
    Построитель = Новый ПостроительКонфигурацииИнтерпретатора;
    Построитель.ДобавитьФайлКонфигурации(ПутьCFG);
    ПерваяКонфигурация = Построитель.Построить();

    // Действие
    ЗаписатьТекст(ПутьCFG, "value=second");
    ВтораяКонфигурация = Построитель.Построить();

    // Проверка
    Ожидаем.Что(ПерваяКонфигурация.ПолучитьЗначение("value")).Равно("first");
    Ожидаем.Что(ВтораяКонфигурация.ПолучитьЗначение("value")).Равно("second");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗафиксироватьОтносительныйПутьCFGПриДобавлении() Экспорт

    // Подготовка
    ПутьCFG = ОбъединитьПути(_РабочийКаталог, "relative.cfg");
    ЗаписатьТекст(ПутьCFG, "value=source");
    УстановитьТекущийКаталог(_РабочийКаталог);
    Построитель = Новый ПостроительКонфигурацииИнтерпретатора;
    Построитель.ДобавитьФайлКонфигурации("relative.cfg");

    // Действие
    УстановитьТекущийКаталог(_КаталогТочкиВхода);
    Конфигурация = Построитель.Построить();

    // Проверка
    Ожидаем.Что(Конфигурация.ПолучитьЗначение("value")).Равно("source");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("ЯвноеПустое")
&ИсточникЗначение("ТекущееПустое")
&ИсточникЗначение("ТекущееОтсутствует")
Процедура ТестДолжен_ПропуститьПустоеИОтсутствующееОкружение(Случай) Экспорт

    // Подготовка
    Построитель = Новый ПостроительКонфигурацииИнтерпретатора;
    Если Случай = "ЯвноеПустое" Тогда
        Построитель.ДобавитьНастройкиОкружения("", _РабочийКаталог);
    Иначе
        УстановитьПеременнуюСреды(
            "OSCRIPT_CONFIG",
            ?(Случай = "ТекущееПустое", "", Неопределено)
        );
        Построитель.ДобавитьТекущееОкружение(_РабочийКаталог);
    КонецЕсли;

    // Действие
    Конфигурация = Построитель.Построить();

    // Проверка
    Ожидаем.Что(Конфигурация.Ключи().Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПеречитатьТекущееОкружениеСФиксированнойЯвнойБазой() Экспорт

    // Подготовка
    УстановитьПеременнуюСреды("OSCRIPT_CONFIG", "value=first;lib.additional=first-lib");
    Построитель = Новый ПостроительКонфигурацииИнтерпретатора;
    Построитель.ДобавитьТекущееОкружение(_РабочийКаталог);
    ПерваяКонфигурация = Построитель.Построить();

    // Действие
    УстановитьПеременнуюСреды("OSCRIPT_CONFIG", "value=second;lib.additional=second-lib");
    УстановитьТекущийКаталог(_КаталогТочкиВхода);
    ВтораяКонфигурация = Построитель.Построить();

    // Проверка
    Ожидаем.Что(ПерваяКонфигурация.ПолучитьЗначение("value")).Равно("first");
    Ожидаем.Что(ВтораяКонфигурация.ПолучитьЗначение("value")).Равно("second");
    Ожидаем.Что(Новый ЛокаторБиблиотекПоКонфигурации(ВтораяКонфигурация).ПолучитьКаталогиПоиска()[0])
        .Равно(ОбъединитьПути(_РабочийКаталог, "second-lib"));

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Явное")
&ИсточникЗначение("Текущее")
Процедура ТестДолжен_ИспользоватьТекущийКаталогДляОкруженияБезЯвнойБазы(ВидИсточника) Экспорт

    // Подготовка
    Построитель = Новый ПостроительКонфигурацииИнтерпретатора;
    Если ВидИсточника = "Явное" Тогда
        Построитель.ДобавитьНастройкиОкружения("lib.additional=relative-lib");
    Иначе
        УстановитьПеременнуюСреды("OSCRIPT_CONFIG", "lib.additional=relative-lib");
        Построитель.ДобавитьТекущееОкружение();
    КонецЕсли;
    УстановитьТекущийКаталог(_КаталогТочкиВхода);

    // Действие
    Конфигурация = Построитель.Построить();

    // Проверка
    Ожидаем.Что(Новый ЛокаторБиблиотекПоКонфигурации(Конфигурация).ПолучитьКаталогиПоиска()[0])
        .Равно(ОбъединитьПути(_КаталогТочкиВхода, "relative-lib"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПеречитатьТекущееОкружениеВместеСТекущимКаталогом() Экспорт

    // Подготовка
    УстановитьТекущийКаталог(_РабочийКаталог);
    УстановитьПеременнуюСреды("OSCRIPT_CONFIG", "value=first;lib.additional=first-lib");
    Построитель = Новый ПостроительКонфигурацииИнтерпретатора;
    Построитель.ДобавитьСтандартныеИсточники();
    ПерваяКонфигурация = Построитель.Построить();

    // Действие
    УстановитьТекущийКаталог(_КаталогТочкиВхода);
    УстановитьПеременнуюСреды("OSCRIPT_CONFIG", "value=second;lib.additional=second-lib");
    ВтораяКонфигурация = Построитель.Построить();

    // Проверка
    Ожидаем.Что(ПерваяКонфигурация.ПолучитьЗначение("value")).Равно("first");
    Ожидаем.Что(Новый ЛокаторБиблиотекПоКонфигурации(ПерваяКонфигурация).ПолучитьКаталогиПоиска()[0])
        .Равно(ОбъединитьПути(_РабочийКаталог, "first-lib"));
    Ожидаем.Что(ВтораяКонфигурация.ПолучитьЗначение("value")).Равно("second");
    Ожидаем.Что(Новый ЛокаторБиблиотекПоКонфигурации(ВтораяКонфигурация).ПолучитьКаталогиПоиска()[0])
        .Равно(ОбъединитьПути(_КаталогТочкиВхода, "second-lib"));

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Файл", 1, "argument.invalid_type")
&ИсточникЗначение("Файл", "", "argument.required")
&ИсточникЗначение("НеобязательныйФайл", 1, "argument.invalid_type")
&ИсточникЗначение("НеобязательныйФайл", "", "argument.required")
&ИсточникЗначение("ЯвноеОкружение", 1, "argument.invalid_type")
&ИсточникЗначение("ТекущееОкружение", 1, "argument.invalid_type")
Процедура ТестДолжен_ПроверитьАргументыИсточников(Метод, Значение, Код) Экспорт

    // Подготовка
    Построитель = Новый ПостроительКонфигурацииИнтерпретатора;
    Ошибка = Неопределено;

    // Действие
    Попытка
        Если Метод = "Файл" Тогда
            Построитель.ДобавитьФайлКонфигурации(Значение);
        ИначеЕсли Метод = "НеобязательныйФайл" Тогда
            Построитель.ДобавитьНеобязательныйФайлКонфигурации(Значение);
        ИначеЕсли Метод = "ЯвноеОкружение" Тогда
            Построитель.ДобавитьНастройкиОкружения(Значение, _РабочийКаталог);
        Иначе
            Построитель.ДобавитьТекущееОкружение(Значение);
        КонецЕсли;
    Исключение
        Ошибка = ИнформацияОбОшибке();
    КонецПопытки;

    // Проверка
    Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно(Код);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("ЯвноеОкружение", "missing")
&ИсточникЗначение("ТекущееОкружение", "missing")
&ИсточникЗначение("ЯвноеОкружение", "file")
&ИсточникЗначение("ТекущееОкружение", "file")
Процедура ТестДолжен_ОтклонитьНедопустимыйРабочийКаталог(Метод, ВидПути) Экспорт

    // Подготовка
    Путь = ОбъединитьПути(_Каталог, ВидПути);
    Если ВидПути = "file" Тогда
        ЗаписатьТекст(Путь, "content");
    КонецЕсли;
    Построитель = Новый ПостроительКонфигурацииИнтерпретатора;
    Ошибка = Неопределено;

    // Действие
    Попытка
        Если Метод = "ЯвноеОкружение" Тогда
            Построитель.ДобавитьНастройкиОкружения("", Путь);
        Иначе
            Построитель.ДобавитьТекущееОкружение(Путь);
        КонецЕсли;
    Исключение
        Ошибка = ИнформацияОбОшибке();
    КонецПопытки;

    // Проверка
    Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно("argument.invalid_value");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Отсутствует")
&ИсточникЗначение("Каталог")
&ИсточникЗначение("Поврежден")
Процедура ТестДолжен_ОбернутьОшибкуОбязательногоCFG(Случай) Экспорт

    // Подготовка
    ПутьCFG = ОбъединитьПути(_Каталог, "required.cfg");
    Если Случай = "Каталог" Тогда
        СоздатьКаталог(ПутьCFG);
    ИначеЕсли Случай = "Поврежден" Тогда
        ЗаписатьТекст(ПутьCFG, "=invalid");
    КонецЕсли;
    Построитель = Новый ПостроительКонфигурацииИнтерпретатора;
    Построитель.ДобавитьФайлКонфигурации(ПутьCFG);

    // Действие
    Ошибка = ПолучитьОшибкуПостроения(Построитель);

    // Проверка
    Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка))
        .Равно(КодыОшибокКонфигурацииИнтерпретатора.РасчетКонфигурацииНеВыполнен());

КонецПроцедуры

