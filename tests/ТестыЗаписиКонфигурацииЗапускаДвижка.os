    Ожидаем.Что(НайтиФайлы(_Каталог, "*").Количество()).Равно(0);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("42", """БезПреобразования""", "argument.invalid_type")
&ИсточникЗначение("""""", """БезПреобразования""", "argument.required")
&ИсточникЗначение(""" """, """БезПреобразования""", "argument.required")
&ИсточникЗначение("Путь", "42", "argument.invalid_type")
Процедура ТестДолжен_ПроверитьАргументыДоЗаписи(ВыражениеПути, ВыражениеПреобразования, Код) Экспорт

    // Подготовка
    Путь = ОбъединитьПути(_Каталог, "oscript.cfg");
    Конфигурация = Новый КонфигурацияЗапускаДвижка();
    Ошибка = Неопределено;

    // Действие
    Попытка
        Конфигурация.ЗаписатьВФайл(Вычислить(ВыражениеПути), Вычислить(ВыражениеПреобразования));
    Исключение
        Ошибка = ИнформацияОбОшибке();
    КонецПопытки;

    // Проверка
    Ожидаем.Что(Ошибка).Заполнено();
    Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно(Код);
    Ожидаем.Что(НайтиФайлы(_Каталог, "*").Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеПроверятьДопустимостьРежимаПутей() Экспорт

    // Подготовка
    Путь = ОбъединитьПути(_Каталог, "oscript.cfg");
    Конфигурация = Новый КонфигурацияЗапускаДвижка();
