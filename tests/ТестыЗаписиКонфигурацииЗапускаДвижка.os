&ПараметризованныйТест
&ИсточникЗначение("", "value")
&ИсточникЗначение(" ", "value")
&ИсточникЗначение(" key", "value")
&ИсточникЗначение("key ", "value")
&ИсточникЗначение("key=other", "value")
&ИсточникЗначение("#comment", "value")
&ИсточникЗначение("ПС", "value")
&ИсточникЗначение("ВК", "value")
&ИсточникЗначение("key", "ПС")
&ИсточникЗначение("key", "ВК")
&ИсточникЗначение("key", " value")
&ИсточникЗначение("key", "value ")
&ИсточникЗначение("key", "ТАБ")
&ИсточникЗначение("key", "NBSP")
&ИсточникЗначение("lib.system", " value ")
Процедура ТестДолжен_ОтклонитьНепредставимуюПаруДоИзмененияЦелевогоФайла(Ключ, Значение) Экспорт

    // Подготовка
    Ключ = СпециальныеСимволы(Ключ);
    Значение = СпециальныеСимволы(Значение);
    Путь = ОбъединитьПути(_Каталог, "oscript.cfg");
    ЗаписатьТекст(Путь, "old=value");
    Байты = Base64Строка(Новый ДвоичныеДанные(Путь));
    Конфигурация = Новый КонфигурацияЗапускаДвижка();
    Конфигурация.Установить(Ключ, Значение);

    // Действие
    Ошибка = ОшибкаЗаписи(Конфигурация, Путь);

    // Проверка
    ПроверитьОшибкуЗаписи(Ошибка, Путь);
    Ожидаем.Что(ДиагностикаОшибок.Содержит(Ошибка, КодыОшибокEngineConfig.НекорректнаяКонфигурация())).Равно(Истина);
    Ожидаем.Что(Base64Строка(Новый ДвоичныеДанные(Путь))).Равно(Байты);
    Ожидаем.Что(НайтиФайлы(_Каталог, "*").Количество()).Равно(1);
    Ожидаем.Что(Конфигурация.ПолучитьЗначение(Ключ)).Равно(Значение);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("БезПреобразования")
&ИсточникЗначение("ВАбсолютные")
&ИсточникЗначение("ОтносительноФайла")
Процедура ТестДолжен_ПреобразоватьТолькоПутиБиблиотекБезМутации(Преобразование) Экспорт

    // Подготовка
    База = ОбъединитьПути(_Каталог, "base");
    Назначение = ОбъединитьПути(_Каталог, "output", "nested");
    СоздатьКаталог(Назначение);
    Путь = ОбъединитьПути(Назначение, "oscript.cfg");
    Конфигурация = Новый КонфигурацияЗапускаДвижка();
    Конфигурация.УстановитьБазовыйКаталог(База);
    Абсолютный = ОбъединитьПути(_Каталог, "rooted");
    Дополнительные = "first; ;" + Абсолютный + ";first";
    Конфигурация.Установить("LiB.System", "../system");
    Конфигурация.Установить("LIB.ADDITIONAL", Дополнительные);
    Конфигурация.Установить("other.path", "../literal");
    Системный = "../system";

    Если Преобразование = ПреобразованияПутейКонфигурацииЗапускаДвижка.ВАбсолютные() Тогда
        Системный = ОбъединитьПути(_Каталог, "system");
        Первый = ОбъединитьПути(База, "first");
        Дополнительные = Первый + ";" + Абсолютный + ";" + Первый;
    ИначеЕсли Преобразование = ПреобразованияПутейКонфигурацииЗапускаДвижка.ОтносительноФайла() Тогда
        Системный = ОбъединитьПути("..", "..", "system");
        Первый = ОбъединитьПути("..", "..", "base", "first");
        Дополнительные = Первый + ";" + ОбъединитьПути("..", "..", "rooted") + ";" + Первый;
    КонецЕсли;

    // Действие
    Конфигурация.ЗаписатьВФайл(Путь, Преобразование);
    Конфигурация.ЗаписатьВФайл(Путь, Преобразование);

    // Проверка
    ФайлКонфигурации = Новый ФайлКонфигурацииЗапускаДвижка(Путь);
    Прочитанные = ФайлКонфигурации.Прочитать();
    Ожидаем.Что(Прочитанные.Найти("lib.system", "НормализованныйКлюч").Значение).Равно(Системный);
    Ожидаем.Что(Прочитанные.Найти("lib.additional", "НормализованныйКлюч").Значение).Равно(Дополнительные);
    Ожидаем.Что(Прочитанные.Найти("other.path", "НормализованныйКлюч").Значение).Равно("../literal");
    Ожидаем.Что(Конфигурация.ПолучитьЗначение("lib.system")).Равно("../system");
    Ожидаем.Что(Конфигурация.ПолучитьЗначение("lib.additional")).Равно("first; ;" + Абсолютный + ";first");
    Ожидаем.Что(НайтиФайлы(Назначение, "*").Количество()).Равно(1);
    Ожидаем.Что(Новый Файл(База).Существует()).Равно(Ложь);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(".")
&ИсточникЗначение("..")
&ИсточникЗначение("child")
