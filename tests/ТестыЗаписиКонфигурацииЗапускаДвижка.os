    // Проверка
    ПроверитьОшибкуЗаписи(Ошибка, Путь);
    Ожидаем.Что(Новый Файл(Путь).ЭтоКаталог()).Равно(Истина);
    Ожидаем.Что(ПрочитатьТекст(ВложенныйФайл)).Равно("keep");
    Ожидаем.Что(НайтиФайлы(_Каталог, "*").Количество()).Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьСистемнуюПричинуОшибкиЗаписи() Экспорт

    // Подготовка
    Путь = ОбъединитьПути(_Каталог, "missing", "oscript.cfg");
    Конфигурация = Новый КонфигурацияЗапускаДвижка();
    Конфигурация.Установить("key", "secret-value");

