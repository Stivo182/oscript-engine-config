&Тест
Процедура ТестДолжен_ОставитьАбсолютныйПутьДругогоДиска() Экспорт

    // Подготовка
    Если Сред(_Каталог, 2, 1) <> ":" Тогда
        Возврат;
    КонецЕсли;

    ДругойДиск = ?(ВРег(Лев(_Каталог, 1)) = "Z", "Y", "Z");
    Абсолютный = ДругойДиск + ":\engine-config-missing\library";
    Конфигурация = Новый КонфигурацияЗапускаДвижка();
    Конфигурация.УстановитьБазовыйКаталог(_Каталог);
    Конфигурация.Установить("lib.system", Абсолютный);
    Конфигурация.Установить("lib.additional", Абсолютный + ";local");
    Путь = ОбъединитьПути(_Каталог, "oscript.cfg");

    // Действие
    Конфигурация.ЗаписатьВФайл(Путь, ПреобразованияПутейКонфигурацииЗапускаДвижка.ОтносительноФайла());

    // Проверка
    Ожидаем.Что(ПрочитатьТекст(Путь)).Равно("lib.additional=" + Абсолютный + ";local" + Символы.ПС + "lib.system=" + Абсолютный);

КонецПроцедуры

