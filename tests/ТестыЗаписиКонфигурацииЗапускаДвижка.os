#Использовать asserts
#Использовать errors
#Использовать tempfiles
#Использовать "../src"
#Использовать "../src/internal"

Перем _ВременныеФайлы; // МенеджерВременныхФайлов
Перем _Каталог; // Строка
Перем _ИсходныйКаталог; // Строка
Перем _ИсходноеОкружение; // Строка, Неопределено

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередВсеми
Процедура ПередВсеми() Экспорт

    _ВременныеФайлы = Новый МенеджерВременныхФайлов;

    _ИсходныйКаталог = ТекущийКаталог();
    _ИсходноеОкружение = ПолучитьПеременнуюСреды("OSCRIPT_CONFIG");

КонецПроцедуры

&ПередКаждым
Процедура ПередКаждым() Экспорт

    _Каталог = _ВременныеФайлы.СоздатьКаталог();

КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
    Ожидаем.Что(ТекущийКаталог()).Равно(_ИсходныйКаталог);
    Ожидаем.Что(ПолучитьПеременнуюСреды("OSCRIPT_CONFIG")).Равно(_ИсходноеОкружение);
КонецПроцедуры

&ПослеВсех
Процедура ПослеВсех() Экспорт
    Если _ВременныеФайлы <> Неопределено Тогда
        _ВременныеФайлы.Удалить();
    КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_ЗаписатьОтсортированныеБайтыUTF8БезBOMИCR() Экспорт

    // Подготовка
    Конфигурация = Новый КонфигурацияЗапускаДвижка();
    Конфигурация.Установить("zeta", "Ж値");
    Конфигурация.Установить("Beta", "two=2;three");
    Конфигурация.Установить("ALPHA", "old");
    Конфигурация.Установить("alpha", "");
    Путь = ОбъединитьПути(_Каталог, "oscript.cfg");

    // Действие
    Конфигурация.ЗаписатьВФайл(Путь);

    // Проверка
    Данные = Новый ДвоичныеДанные(Путь);
    Ожидаем.Что(Base64Строка(Данные)).Равно("YWxwaGE9CkJldGE9dHdvPTI7dGhyZWUKemV0YT3QluWApA==");

    Байты = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Данные);
    Ожидаем.Что(Байты[0] = 239 И Байты[1] = 187 И Байты[2] = 191).Равно(Ложь);

    КоличествоLF = 0;
    Для Индекс = 0 По Байты.Размер - 1 Цикл
        Ожидаем.Что(Байты[Индекс] = 13).Равно(Ложь);
        Если Байты[Индекс] = 10 Тогда
            КоличествоLF = КоличествоLF + 1;
        КонецЕсли;
    КонецЦикла;

    Ожидаем.Что(КоличествоLF).Равно(2);
    Ожидаем.Что(НайтиФайлы(_Каталог, "*").Количество()).Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПолностьюЗаменитьКомментарииИДублиСуществующегоCFG() Экспорт

    // Подготовка
    Путь = ОбъединитьПути(_Каталог, "oscript.cfg");
    ЗаписатьТекст(Путь, "# comment" + Символы.ВК + Символы.ПС + "Key=first" + Символы.ПС + "Key=second");
