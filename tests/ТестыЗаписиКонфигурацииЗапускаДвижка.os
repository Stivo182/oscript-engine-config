&ПараметризованныйТест
&ИсточникЗначение(Ложь, "engine-config")
&ИсточникЗначение(Истина, "engine-config")
Процедура ТестДолжен_СохранитьФайлОткатаИОстановитьсяДоЗаписи(ЕстьЦелевойФайл, Префикс) Экспорт

    // Подготовка
    Путь = ОбъединитьПути(_Каталог, "oscript.cfg");
    Откат = ОбъединитьПути(_Каталог, ".oscript.cfg." + Префикс + "-rollback-old");
    ЗаписатьТекст(Откат, "recovery=value");
    Если ЕстьЦелевойФайл Тогда
        ЗаписатьТекст(Путь, "old=value");
    КонецЕсли;

    Конфигурация = Новый КонфигурацияЗапускаДвижка();
    Конфигурация.Установить("new", "value");

    // Действие
    Ошибка = ОшибкаЗаписи(Конфигурация, Путь);

    // Проверка
    ПроверитьОшибкуЗаписи(Ошибка, Путь);
    Ожидаем.Что(ДиагностикаОшибок.ДанныеОшибки(Ошибка).ПутьОтката).Равно(Откат);
    Ожидаем.Что(ПрочитатьТекст(Откат)).Равно("recovery=value");
    Ожидаем.Что(Новый Файл(Путь).Существует()).Равно(ЕстьЦелевойФайл);

    Если ЕстьЦелевойФайл Тогда
        Ожидаем.Что(ПрочитатьТекст(Путь)).Равно("old=value");
    КонецЕсли;

    Ожидаем.Что(НайтиФайлы(_Каталог, "*").Количество()).Равно(?(ЕстьЦелевойФайл, 2, 1));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьКаталогНазначенияБезПеремещенияЕгоФайлов() Экспорт

    // Подготовка
    Путь = ОбъединитьПути(_Каталог, "oscript.cfg");
