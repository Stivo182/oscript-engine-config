КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОшибкаЗаписи(Конфигурация, Путь)

    Попытка
        Конфигурация.ЗаписатьВФайл(Путь);
    Исключение
        Возврат ИнформацияОбОшибке();
    КонецПопытки;
    Возврат Неопределено;

КонецФункции

Процедура ПроверитьОшибкуЗаписи(Ошибка, Путь)
    Ожидаем.Что(Ошибка).Заполнено();
    Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно(КодыОшибокEngineConfig.ЗаписьКонфигурацииНеВыполнена());
    Ожидаем.Что(ДиагностикаОшибок.ДанныеОшибки(Ошибка).Путь).Равно(Путь);
КонецПроцедуры

Функция СпециальныеСимволы(Текст)

    Если Текст = "ПС" Тогда
        Возврат "before" + Символы.ПС + "after";
    ИначеЕсли Текст = "ВК" Тогда
        Возврат "before" + Символы.ВК + "after";
    ИначеЕсли Текст = "ТАБ" Тогда
        Возврат Символы.Таб + "value";
    ИначеЕсли Текст = "NBSP" Тогда
        Возврат "value" + Символ(160);
    КонецЕсли;

    Возврат Текст;

КонецФункции

Процедура ЗаписатьТекст(Путь, Текст)
    Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8NoBOM, Символы.ПС);
    Запись.Записать(Текст);
    Запись.Закрыть();
КонецПроцедуры

Функция ПрочитатьТекст(Путь)
    Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
    Текст = Чтение.Прочитать();
    Чтение.Закрыть();
    Возврат Текст;
КонецФункции

#КонецОбласти
