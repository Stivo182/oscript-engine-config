#Использовать asserts
#Использовать errors
#Использовать tempfiles
#Использовать "../src"
#Использовать "../src/internal"

Перем _ВременныеФайлы; // МенеджерВременныхФайлов
Перем _Каталог; // Строка
Перем _ИсходноеОкружение; // Строка, Неопределено
Перем _ИсходныйКаталог; // Строка

#Область ОбработчикиСобытий

// Использует один временный каталог и восстанавливает состояние процесса после каждого теста.
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередВсеми
Процедура ПередВсеми() Экспорт
    _ВременныеФайлы = Новый МенеджерВременныхФайлов;
    _Каталог = _ВременныеФайлы.СоздатьКаталог();
КонецПроцедуры

&ПередКаждым
Процедура ПередКаждым() Экспорт
    _ИсходноеОкружение = ПолучитьПеременнуюСреды("OSCRIPT_CONFIG");
    _ИсходныйКаталог = ТекущийКаталог();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
    УстановитьПеременнуюСреды("OSCRIPT_CONFIG", _ИсходноеОкружение);
    УстановитьТекущийКаталог(_ИсходныйКаталог);
КонецПроцедуры

&ПослеВсех
Процедура ПослеВсех() Экспорт
    Если _ВременныеФайлы <> Неопределено Тогда
        _ВременныеФайлы.Удалить();
    КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_КавычитьВсеЗначенияИУдваиватьКавычки() Экспорт

    // Подготовка
    Конфигурация = Новый КонфигурацияЗапускаДвижка();
    Конфигурация.Установить("empty", "");
    Конфигурация.Установить("b", "a""b");
    Конфигурация.Установить("a", "one;two");

    // Действие
    СтрокаОкружения = Конфигурация.ВСтрокуОкружения();

    // Проверка
    Ожидаем.Что(СтрокаОкружения).Равно("a=""one;two"";b=""a""""b"";empty=""""");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("ordinary")
&ИсточникЗначение("")
&ИсточникЗначение("a""b""""c")
&ИсточникЗначение("one;two=three")
&ИсточникЗначение("  значимое значение Ж値  ")
&ИсточникЗначение("'quoted'\path")
&ИсточникЗначение("ТАБ_ПС_ВК")
Процедура ТестДолжен_СохранитьЗначениеПриПовторномРазборе(Значение) Экспорт

    // Подготовка
    Если Значение = "ТАБ_ПС_ВК" Тогда
        Значение = Символы.Таб + "first" + Символы.ПС + "second" + Символы.ВК + Символ(160);
    КонецЕсли;

    Конфигурация = Новый КонфигурацияЗапускаДвижка();
    Конфигурация.Установить("Key_1.name", Значение);

    // Действие
    Источник = РазобратьОкружение(Конфигурация);

    // Проверка
    Ожидаем.Что(Источник.Количество()).Равно(1);
    Ожидаем.Что(Источник[0].Ключ).Равно("Key_1.name");
    Ожидаем.Что(Источник[0].Значение).Равно(Значение);
    Ожидаем.Что(Конфигурация.ПолучитьЗначение("Key_1.name")).Равно(Значение);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СериализоватьКлючиВСтабильномПорядкеБезУчетаРегистра() Экспорт

    // Подготовка
    Конфигурация = Новый КонфигурацияЗапускаДвижка();
    Конфигурация.Установить("zeta", "3");
    Конфигурация.Установить("Beta", "2");
    Конфигурация.Установить("ALPHA", "old");
    Конфигурация.Установить("alpha", "1");

    // Действие
    СтрокаОкружения = Конфигурация.ВСтрокуОкружения();

    // Проверка
    Ожидаем.Что(СтрокаОкружения).Равно("alpha=""1"";Beta=""2"";zeta=""3""");
    Ожидаем.Что(Конфигурация.ВСтрокуОкружения()).Равно(СтрокаОкружения);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПустуюСтрокуДляПустойКонфигурации() Экспорт
    // Подготовка
    Конфигурация = Новый КонфигурацияЗапускаДвижка();

    // Действие и Проверка
    Ожидаем.Что(Конфигурация.ВСтрокуОкружения()).Равно("");
КонецПроцедуры

&Тест
Процедура ТестДолжен_РазрешитьПутиОтЯвнойБазыБезИзмененияНастроек() Экспорт

    // Подготовка
    База = ОбъединитьПути(_Каталог, "несуществующая база");
    Абсолютный = ОбъединитьПути(_Каталог, "rooted");
    Конфигурация = Новый КонфигурацияЗапускаДвижка();
    Конфигурация.УстановитьБазовыйКаталог(База);
    Конфигурация.Установить("LiB.System", "  ../system Ж値  ");
    Дополнительные = " ; first ; ; " + Абсолютный + " ; first ; ";
    Конфигурация.Установить("LIB.ADDITIONAL", Дополнительные);
    Конфигурация.Установить("other.path", "  ../literal;path  ");

    // Действие
    Источник = РазобратьОкружение(Конфигурация);

    // Проверка
    Ожидаем.Что(ЗначениеНастройки(Источник, "lib.system")).Равно(АбсолютныйПуть(База, "../system Ж値"));
    Первый = АбсолютныйПуть(База, "first");
    Ожидаем.Что(ЗначениеНастройки(Источник, "lib.additional")).Равно(Первый + ";" + Абсолютный + ";" + Первый);
    Ожидаем.Что(ЗначениеНастройки(Источник, "other.path")).Равно("  ../literal;path  ");
    Ожидаем.Что(Конфигурация.ПолучитьЗначение("lib.system")).Равно("  ../system Ж値  ");
    Ожидаем.Что(Конфигурация.ПолучитьЗначение("lib.additional")).Равно(Дополнительные);
    Ожидаем.Что(Новый Файл(База).Существует()).Равно(Ложь);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьАбсолютныйСистемныйПуть() Экспорт

    // Подготовка
    Путь = ОбъединитьПути(_Каталог, "rooted; system");
    Конфигурация = Новый КонфигурацияЗапускаДвижка();
    Конфигурация.УстановитьБазовыйКаталог(ОбъединитьПути(_Каталог, "other base"));
    Конфигурация.Установить("lib.system", "  " + Путь + "  ");

    // Действие
    Источник = РазобратьОкружение(Конфигурация);

    // Проверка
    Ожидаем.Что(ЗначениеНастройки(Источник, "lib.system")).Равно(Путь);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьРазделительСпискаВРазрешенномДополнительномПути() Экспорт

    // Подготовка
    Конфигурация = Новый КонфигурацияЗапускаДвижка();
    Конфигурация.УстановитьБазовыйКаталог(ОбъединитьПути(_Каталог, "base;other"));
    Конфигурация.Установить("lib.additional", "local");
    Ошибка = Неопределено;

    // Действие
    Попытка
        Конфигурация.ВСтрокуОкружения();
    Исключение
        Ошибка = ИнформацияОбОшибке();
    КонецПопытки;

    // Проверка
    Ожидаем.Что(Ошибка).Заполнено();
    Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно(КодыОшибокEngineConfig.НекорректнаяКонфигурация());
    Ожидаем.Что(Конфигурация.ПолучитьЗначение("lib.additional")).Равно("local");
    Ожидаем.Что(ПолучитьПеременнуюСреды("OSCRIPT_CONFIG")).Равно(_ИсходноеОкружение);
    Ожидаем.Что(ТекущийКаталог()).Равно(_ИсходныйКаталог);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("")
&ИсточникЗначение(" ; ; ")
Процедура ТестДолжен_РазрешитьПустойСистемныйПутьИОтброситьПустыеДополнительные(Дополнительные) Экспорт

    // Подготовка
