КонецПроцедуры

&Тест
Процедура ТестДолжен_ИспользоватьКаталогУстановкиПослеСменыТекущегоКаталога() Экспорт

    // Подготовка
    Конфигурация = Новый КонфигурацияЗапускаДвижка();
    УстановитьТекущийКаталог(_Каталог);
    Конфигурация.Установить("lib.system", "system");
    Конфигурация.Установить("lib.additional", "first;second");
    УстановитьТекущийКаталог(_ИсходныйКаталог);

    // Действие
    Источник = РазобратьОкружение(Конфигурация);

    // Проверка
    Ожидаем.Что(ЗначениеНастройки(Источник, "lib.system")).Равно(АбсолютныйПуть(_Каталог, "system"));
    Ожидаем.Что(ЗначениеНастройки(Источник, "lib.additional"))
        .Равно(АбсолютныйПуть(_Каталог, "first") + ";" + АбсолютныйПуть(_Каталог, "second"));
    Ожидаем.Что(ТекущийКаталог()).Равно(_ИсходныйКаталог);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("СистемныйCFG")
&ИсточникЗначение("ВходнойCFG")
&ИсточникЗначение("Окружение")
&ИсточникЗначение("РучноеЗначение")
Процедура ТестДолжен_РазрешитьПутиОтБазыПобедившегоИсточника(Победитель) Экспорт

    // Подготовка
    Движок = ОбъединитьПути(_Каталог, "engine");
    КаталогВхода = ОбъединитьПути(_Каталог, "entry");
    РабочийКаталог = ОбъединитьПути(_Каталог, "cwd");

    СоздатьКаталог(ОбъединитьПути(Движок, "bin"));
    СоздатьКаталог(ОбъединитьПути(Движок, "lib"));
    СоздатьКаталог(КаталогВхода);
    СоздатьКаталог(РабочийКаталог);

    ТекстCFG = "lib.system=system" + Символы.ПС + "lib.additional=first;second";
    ПутьСистемногоCFG = ОбъединитьПути(Движок, "bin", "oscript.cfg");
    ПутьВходногоCFG = ОбъединитьПути(КаталогВхода, "oscript.cfg");
    ЗаписатьТекст(ПутьСистемногоCFG, ТекстCFG);
    ЗаписатьТекст(ПутьВходногоCFG, ?(Победитель = "СистемныйCFG", "", ТекстCFG));

    БайтыСистемногоCFG = Base64Строка(Новый ДвоичныеДанные(ПутьСистемногоCFG));
    БайтыВходногоCFG = Base64Строка(Новый ДвоичныеДанные(ПутьВходногоCFG));

    Построитель = Новый ПостроительКонфигурацииЗапускаДвижка;
    Построитель
        .ДобавитьФайлКонфигурации(ПутьСистемногоCFG)
        .ДобавитьФайлКонфигурации(ПутьВходногоCFG);

    База = ?(Победитель = "СистемныйCFG", ОбъединитьПути(Движок, "bin"), КаталогВхода);

    Если Победитель = "Окружение" Тогда
        Построитель.ДобавитьНастройкиОкружения(
            "lib.system=system;lib.additional='first;second'",
            РабочийКаталог
        );
        База = РабочийКаталог;
    КонецЕсли;

    Конфигурация = Построитель.Построить();
    Если Победитель = "РучноеЗначение" Тогда
        Конфигурация.УстановитьБазовыйКаталог(РабочийКаталог);
        Конфигурация.Установить("LIB.SYSTEM", "system");
        Конфигурация.Установить("LIB.ADDITIONAL", "first;second");
        База = РабочийКаталог;
    КонецЕсли;

    // Действие
    Источник = РазобратьОкружение(Конфигурация);

    // Проверка
    Ожидаем.Что(ЗначениеНастройки(Источник, "lib.system")).Равно(АбсолютныйПуть(База, "system"));
    Ожидаем.Что(ЗначениеНастройки(Источник, "lib.additional"))
        .Равно(АбсолютныйПуть(База, "first") + ";" + АбсолютныйПуть(База, "second"));
    Ожидаем.Что(Base64Строка(Новый ДвоичныеДанные(ПутьСистемногоCFG))).Равно(БайтыСистемногоCFG);
    Ожидаем.Что(Base64Строка(Новый ДвоичныеДанные(ПутьВходногоCFG))).Равно(БайтыВходногоCFG);
    Ожидаем.Что(ТекущийКаталог()).Равно(_ИсходныйКаталог);
    Ожидаем.Что(ПолучитьПеременнуюСреды("OSCRIPT_CONFIG")).Равно(_ИсходноеОкружение);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("")
&ИсточникЗначение(" Key")
&ИсточникЗначение("Key ")
&ИсточникЗначение("bad key")
&ИсточникЗначение("bad-key")
&ИсточникЗначение("1key")
&ИсточникЗначение("_key")
&ИсточникЗначение("ключ")
&ИсточникЗначение("key=other")
&ИсточникЗначение("ПС")
Процедура ТестДолжен_ОтклонитьНепредставимыйКлючОкружения(Ключ) Экспорт

    // Подготовка
    Если Ключ = "ПС" Тогда
        Ключ = "key" + Символы.ПС;
    КонецЕсли;

    Конфигурация = Новый КонфигурацияЗапускаДвижка();
    Конфигурация.Установить(Ключ, "value");
    Ошибка = Неопределено;

    // Действие
    Попытка
        Конфигурация.ВСтрокуОкружения();
    Исключение
        Ошибка = ИнформацияОбОшибке();
    КонецПопытки;

    // Проверка
    Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно(КодыОшибокEngineConfig.НекорректнаяКонфигурация());

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("ordinary")
&ИсточникЗначение("lib.system")
&ИсточникЗначение("lib.additional")
Процедура ТестДолжен_ОтклонитьНулевойСимволДоПреобразованияЗначения(Ключ) Экспорт

    // Подготовка
    Конфигурация = Новый КонфигурацияЗапускаДвижка();
    Конфигурация.Установить(Ключ, "before" + Символ(0) + "after");
    Ошибка = Неопределено;

    // Действие
    Попытка
        Конфигурация.ВСтрокуОкружения();
    Исключение
        Ошибка = ИнформацияОбОшибке();
    КонецПопытки;

    // Проверка
    Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно(КодыОшибокEngineConfig.НекорректнаяКонфигурация());
    Ожидаем.Что(ПолучитьПеременнуюСреды("OSCRIPT_CONFIG")).Равно(_ИсходноеОкружение);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(Ложь)
&ИсточникЗначение(Истина)
Процедура ТестДолжен_ЯвноУстановитьОкружениеИВосстановитьЕгоПриОшибкеПроверки(ОшибкаПроверки) Экспорт

    // Подготовка
    Конфигурация = Новый КонфигурацияЗапускаДвижка();
    Конфигурация.УстановитьБазовыйКаталог(_Каталог);
    Конфигурация.Установить("lib.system", "system");
    Конфигурация.Установить("value", "one;two=""Ж値""");
    Ошибка = Неопределено;

    // Действие
    Попытка
        Конфигурация.УстановитьВПеременнуюОкружения();

        // Проверка
        Ожидаем.Что(ПолучитьПеременнуюСреды("OSCRIPT_CONFIG")).Равно(Конфигурация.ВСтрокуОкружения());
        Ожидаем.Что(ТекущийКаталог()).Равно(_ИсходныйКаталог);
        Если ОшибкаПроверки Тогда
            Ожидаем.Что("проверка после установки").Равно("намеренная ошибка проверки");
        КонецЕсли;
    Исключение
        Ошибка = ИнформацияОбОшибке();
        УстановитьПеременнуюСреды("OSCRIPT_CONFIG", _ИсходноеОкружение);
    
        Если Не ОшибкаПроверки Тогда
            ВызватьИсключение;
        КонецЕсли;
    КонецПопытки;

    УстановитьПеременнуюСреды("OSCRIPT_CONFIG", _ИсходноеОкружение);

    // Проверка
    Ожидаем.Что(ПолучитьПеременнуюСреды("OSCRIPT_CONFIG")).Равно(_ИсходноеОкружение);
    Если ОшибкаПроверки Тогда
        Ожидаем.Что(Ошибка.Описание).Содержит("намеренная ошибка проверки");
    КонецЕсли;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОбернутьОшибкуУстановкиОкруженияССохранениемПричины() Экспорт

    // Подготовка
    УстановитьПеременнуюСреды("OSCRIPT_CONFIG", "old=value");
    Конфигурация = Новый КонфигурацияЗапускаДвижка();
    Конфигурация.Установить("bad-key", "value");
    Ошибка = Неопределено;

    // Действие
    Попытка
        Конфигурация.УстановитьВПеременнуюОкружения();
    Исключение
        Ошибка = ИнформацияОбОшибке();
        УстановитьПеременнуюСреды("OSCRIPT_CONFIG", _ИсходноеОкружение);
    КонецПопытки;

    // Проверка
    Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно(КодыОшибокEngineConfig.УстановкаОкруженияНеВыполнена());
    Ожидаем.Что(ДиагностикаОшибок.Содержит(Ошибка, КодыОшибокEngineConfig.НекорректнаяКонфигурация())).Равно(Истина);
    Ожидаем.Что(ПолучитьПеременнуюСреды("OSCRIPT_CONFIG")).Равно(_ИсходноеОкружение);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазобратьОкружение(Конфигурация)

    ПредставлениеОкружения = Новый СтрокаОкруженияЗапускаДвижка;

    Возврат ПредставлениеОкружения.Разобрать(Конфигурация.ВСтрокуОкружения(), _Каталог);

КонецФункции

Функция ЗначениеНастройки(Источник, Ключ)
    Возврат Источник.Найти(НРег(Ключ), "НормализованныйКлюч").Значение;
КонецФункции

Функция АбсолютныйПуть(База, Путь)
    Возврат Новый Файл(ОбъединитьПути(База, Путь)).ПолноеИмя;
КонецФункции

Процедура ЗаписатьТекст(Путь, Текст)
    Документ = Новый ТекстовыйДокумент;
    Документ.УстановитьТекст(Текст);
    Документ.Записать(Путь);
КонецПроцедуры

#КонецОбласти
