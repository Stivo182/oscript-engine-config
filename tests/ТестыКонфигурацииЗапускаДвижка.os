#Область Тесты

&Тест
Процедура ТестДолжен_СоздатьПустуюКонфигурацию() Экспорт

    // Действие
    Конфигурация = Новый КонфигурацияЗапускаДвижка();

    // Проверка
    Ожидаем.Что(Конфигурация.Ключи().Количество()).Равно(0);
    Ожидаем.Что(Конфигурация.Содержит("missing")).Равно(Ложь);
    Ожидаем.Что(Конфигурация.Получить("missing")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазличатьОтсутствующееИПустоеЗначение() Экспорт

    // Подготовка
    Конфигурация = Новый КонфигурацияЗапускаДвижка();

    // Действие
    Конфигурация.Установить("empty", "");

    // Проверка
    Ожидаем.Что(Конфигурация.Получить("missing")).Равно(Неопределено);
    Ожидаем.Что(Конфигурация.Получить("EMPTY")).Равно("");
    Ожидаем.Что(Конфигурация.Содержит("Empty")).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаменитьКлючБезУчетаРегистра() Экспорт

    // Подготовка
    Конфигурация = Новый КонфигурацияЗапускаДвижка();
    Конфигурация.Установить("Key", "first");

    // Действие
    Конфигурация.Установить("key", "last");

    // Проверка
    Ожидаем.Что(Конфигурация.Получить("KEY")).Равно("last");
    Ожидаем.Что(Конфигурация.Ключи().Количество()).Равно(1);
    Ожидаем.Что(Конфигурация.Ключи().Получить(0)).Равно("key");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьОтсортированныеКлючиОтдельнымМассивом() Экспорт

    // Подготовка
    Конфигурация = Новый КонфигурацияЗапускаДвижка();
    Конфигурация.Установить("zeta", "1");
    Конфигурация.Установить("Beta", "2");
    Конфигурация.Установить("alpha", "3");

    // Действие
    Ключи = Конфигурация.Ключи();

    // Проверка
    Ожидаем.Что(Ключи).ИмеетТип("Массив");
    Ожидаем.Что(Ключи.Количество()).Равно(3);
    Ожидаем.Что(Ключи[0]).Равно("alpha");
    Ожидаем.Что(Ключи[1]).Равно("Beta");
    Ожидаем.Что(Ключи[2]).Равно("zeta");
    Ключи.Очистить();
    Ожидаем.Что(Конфигурация.Ключи().Количество()).Равно(3);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("KEY", Ложь)
&ИсточникЗначение("missing", Истина)
Процедура ТестДолжен_УдалятьТолькоУказанныйКлюч(УдаляемыйКлюч, КлючОстался) Экспорт

    // Подготовка
    Конфигурация = Новый КонфигурацияЗапускаДвижка();
    Конфигурация.Установить("Key", "value");
    Конфигурация.Установить("Other", "unchanged");

    // Действие
    Конфигурация.Удалить(УдаляемыйКлюч);

    // Проверка
    Ожидаем.Что(Конфигурация.Содержит("key")).Равно(КлючОстался);
    Ожидаем.Что(Конфигурация.Получить("key")).Равно(?(КлючОстался, "value", Неопределено));
    Ожидаем.Что(Конфигурация.Ключи().Количество()).Равно(?(КлючОстался, 2, 1));
    Ожидаем.Что(Конфигурация.Получить("other")).Равно("unchanged");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьПробелыКлючаИЗначения() Экспорт

    // Подготовка
    Конфигурация = Новый КонфигурацияЗапускаДвижка();

    // Действие
    Конфигурация.Установить(" Key ", " value ");
    Конфигурация.Установить("Key", "other");

    // Проверка
    Ожидаем.Что(Конфигурация.Получить(" KEY ")).Равно(" value ");
    Ожидаем.Что(Конфигурация.Получить("key")).Равно("other");
    Ожидаем.Что(Конфигурация.Ключи().Количество()).Равно(2);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьНезависимыеКонфигурации() Экспорт

    // Подготовка
    Первая = Новый КонфигурацияЗапускаДвижка(".");
    Вторая = Новый КонфигурацияЗапускаДвижка();

    // Действие
    Первая.Установить("key", "value");

    // Проверка
    Ожидаем.Что(Вторая.Содержит("key")).Равно(Ложь);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(42)
&ИсточникЗначение(Неопределено)
Процедура ТестДолжен_СохранитьЗначениеПриУстановкеНеверногоТипа(НовоеЗначение) Экспорт

    // Подготовка
    Конфигурация = Новый КонфигурацияЗапускаДвижка();
    Конфигурация.Установить("Key", "old value");
    КодОшибки = Неопределено;

    // Действие
    Попытка
        Конфигурация.Установить("KEY", НовоеЗначение);
    Исключение
        КодОшибки = ДиагностикаОшибок.КодОшибки(ИнформацияОбОшибке());
    КонецПопытки;

    // Проверка
    Ожидаем.Что(КодОшибки).Равно("argument.invalid_type");
    Ожидаем.Что(Конфигурация.Получить("key")).Равно("old value");
    Ожидаем.Что(Конфигурация.Ключи().Получить(0)).Равно("Key");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("42")
&ИсточникЗначение("Истина")
&ИсточникЗначение("Новый Массив")
&ИсточникЗначение("Новый Структура")
&ИсточникЗначение("Новый Структура(""Настройки"", Новый ТаблицаЗначений)")
&ИсточникЗначение("Новый Структура(""БазовыйКаталог,Настройки,КаталогДвижка"", ""."", Новый ТаблицаЗначений)")
&ИсточникЗначение("Новый Структура(""БазовыйКаталог,Настройки,КаталогДвижка,Лишнее"", ""."", Новый ТаблицаЗначений)")
Процедура ТестДолжен_ОтклонитьНеверныйТипБазовогоКаталога(Выражение) Экспорт

    // Подготовка
    Значение = Вычислить(Выражение);
    КодОшибки = Неопределено;

    // Действие
    Попытка
        Конфигурация = Новый КонфигурацияЗапускаДвижка(Значение);
    Исключение
        КодОшибки = ДиагностикаОшибок.КодОшибки(ИнформацияОбОшибке());
    КонецПопытки;

    // Проверка
    Ожидаем.Что(КодОшибки).Равно("argument.invalid_type");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьТретийПараметрМетодаУстановить() Экспорт

    // Подготовка
    Конфигурация = Новый КонфигурацияЗапускаДвижка();
    Ошибка = Неопределено;

    // Действие
    Попытка
        Выполнить("Конфигурация.Установить(""key"", ""value"", ""."");");
    Исключение
        Ошибка = ИнформацияОбОшибке();
    КонецПопытки;

    // Проверка
    Ожидаем.Что(Ошибка).Заполнено();
    Ожидаем.Что(Конфигурация.Содержит("key")).Равно(Ложь);

КонецПроцедуры

&Тест
Процедура ТестДолжен_УстановитьСистемныйКаталогБиблиотек() Экспорт

    // Подготовка
    База = ОбъединитьПути(ТекущийКаталог(), "system-base");
    Конфигурация = Новый КонфигурацияЗапускаДвижка();

    // Действие
    Конфигурация.УстановитьСистемныйКаталогБиблиотек(" system ", База);

    // Проверка
    Ожидаем.Что(Конфигурация.Получить("lib.system")).Равно("system");
    Каталоги = Конфигурация.ПолучитьКаталогиБиблиотек();
    Ожидаем.Что(Каталоги.Количество()).Равно(1);
    Ожидаем.Что(Каталоги[0]).Равно(Новый Файл(ОбъединитьПути(База, "system")).ПолноеИмя);

КонецПроцедуры

&Тест
Процедура ТестДолжен_УстановитьДополнительныеКаталогиБиблиотек() Экспорт

    // Подготовка
    База = ОбъединитьПути(ТекущийКаталог(), "additional-base");
    Конфигурация = Новый КонфигурацияЗапускаДвижка(ТекущийКаталог());
    Каталоги = Новый Массив;
    Каталоги.Добавить("first");
    Каталоги.Добавить("");
    Каталоги.Добавить("   ");
    Каталоги.Добавить(" second ");
    Каталоги.Добавить("first");

    // Действие
    Конфигурация.УстановитьДополнительныеКаталогиБиблиотек(Каталоги, База);

    // Проверка
    Ожидаем.Что(Конфигурация.Получить("lib.additional")).Равно("first;second;first");
    РазрешенныеКаталоги = Конфигурация.ПолучитьКаталогиБиблиотек();
    Ожидаем.Что(РазрешенныеКаталоги.Количество()).Равно(3);
    Ожидаем.Что(РазрешенныеКаталоги[0]).Равно(Новый Файл(ОбъединитьПути(База, "first")).ПолноеИмя);
    Ожидаем.Что(РазрешенныеКаталоги[1]).Равно(Новый Файл(ОбъединитьПути(База, "second")).ПолноеИмя);
    Ожидаем.Что(РазрешенныеКаталоги[2]).Равно(РазрешенныеКаталоги[0]);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДобавитьДополнительныйКаталогБиблиотек() Экспорт

    // Подготовка
    База = ОбъединитьПути(ТекущийКаталог(), "additional-base");
    Конфигурация = Новый КонфигурацияЗапускаДвижка();
    Каталоги = Новый Массив;
    Каталоги.Добавить("first");
    Конфигурация.УстановитьДополнительныеКаталогиБиблиотек(Каталоги, База);

    // Действие
    Конфигурация.ДобавитьДополнительныйКаталогБиблиотек(" second ");
    Конфигурация.ДобавитьДополнительныйКаталогБиблиотек("first");

    // Проверка
    Ожидаем.Что(Конфигурация.Получить("lib.additional")).Равно("first;second;first");
    РазрешенныеКаталоги = Конфигурация.ПолучитьКаталогиБиблиотек();
    Ожидаем.Что(РазрешенныеКаталоги[0]).Равно(Новый Файл(ОбъединитьПути(База, "first")).ПолноеИмя);
    Ожидаем.Что(РазрешенныеКаталоги[1]).Равно(Новый Файл(ОбъединитьПути(База, "second")).ПолноеИмя);
    Ожидаем.Что(РазрешенныеКаталоги[2]).Равно(РазрешенныеКаталоги[0]);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНеверныйТипСпискаДополнительныхКаталоговБиблиотек() Экспорт

    // Подготовка
    Конфигурация = Новый КонфигурацияЗапускаДвижка();
    Конфигурация.Установить("lib.additional", "old");
    КодОшибки = Неопределено;

    // Действие
    Попытка
        Конфигурация.УстановитьДополнительныеКаталогиБиблиотек(42);
    Исключение
        КодОшибки = ДиагностикаОшибок.КодОшибки(ИнформацияОбОшибке());
    КонецПопытки;

    // Проверка
    Ожидаем.Что(КодОшибки).Равно("argument.invalid_type");
    Ожидаем.Что(Конфигурация.Получить("lib.additional")).Равно("old");

КонецПроцедуры

