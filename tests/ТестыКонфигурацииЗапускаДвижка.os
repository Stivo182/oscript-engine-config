&ПараметризованныйТест
&ИсточникЗначение("Источник", "argument.invalid_type")
&ИсточникЗначение("ПереносимыеКлючи", "argument.invalid_type")
&ИсточникЗначение("ЭлементПереносимыхКлючей", "argument.invalid_type")
Процедура ТестДолжен_ПроверитьАргументыДополненияДоИзменения(Случай, Код) Экспорт

    // Подготовка
    Конфигурация = Новый КонфигурацияЗапускаДвижка;
    Конфигурация.Установить("existing", "receiver");
    Источник = Новый КонфигурацияЗапускаДвижка;
    Источник.Установить("new", "source");
    Ошибка = Неопределено;

    // Действие
    Попытка
        Если Случай = "Источник" Тогда
            Конфигурация.Дополнить(42);
        ИначеЕсли Случай = "ПереносимыеКлючи" Тогда
            Конфигурация.Дополнить(Источник, 42);
        ИначеЕсли Случай = "ЭлементПереносимыхКлючей" Тогда
            Ключи = Новый Массив;
            Ключи.Добавить(42);
            Конфигурация.Дополнить(Источник, Ключи);
        КонецЕсли;
    Исключение
        Ошибка = ИнформацияОбОшибке();
    КонецПопытки;

    // Проверка
    Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно(Код);
    Ожидаем.Что(Конфигурация.Ключи().Количество()).Равно(1);
    Ожидаем.Что(Конфигурация.ПолучитьЗначение("existing")).Равно("receiver");

КонецПроцедуры

