    Ожидаем.Что(Конфигурация.Ключи().Найти("Existing") <> Неопределено).Равно(Истина);
    Ожидаем.Что(Конфигурация.Ключи().Найти("New.Option") <> Неопределено).Равно(Истина);
    Ожидаем.Что(Конфигурация.Содержит("lib.additional")).Равно(Ложь);

