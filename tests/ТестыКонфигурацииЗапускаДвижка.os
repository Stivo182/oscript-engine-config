#Область Тесты

&Тест
Процедура ТестДолжен_СоздатьПустуюКонфигурацию() Экспорт

    // Действие
    Конфигурация = Новый КонфигурацияЗапускаДвижка();

    // Проверка
    Ожидаем.Что(Конфигурация.Ключи().Количество()).Равно(0);
    Ожидаем.Что(Конфигурация.Содержит("missing")).Равно(Ложь);
    Ожидаем.Что(Конфигурация.ПолучитьЗначение("missing")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_УстановитьБазовыйКаталогБезПреобразования() Экспорт

    // Подготовка
    БазовыйКаталог = ОбъединитьПути("relative", "base");
    Конфигурация = Новый КонфигурацияЗапускаДвижка();

    // Действие
    Конфигурация.УстановитьБазовыйКаталог(БазовыйКаталог);

    // Проверка
    Ожидаем.Что(Конфигурация.ПолучитьБазовыйКаталог()).Равно(БазовыйКаталог);

КонецПроцедуры

