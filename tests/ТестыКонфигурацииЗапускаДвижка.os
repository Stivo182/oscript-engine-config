    Источник = Новый КонфигурацияЗапускаДвижка;
    Источник.УстановитьБазовыйКаталог("source-base");
    Источник.Установить("new", "source");
    Источник.Установить("lib.additional", "before" + Символ(0) + "after");
    Источник.Установить("lib.system", "before" + Символ(0) + "after");

    // Действие
    Конфигурация.Дополнить(Источник);

    // Проверка
    Ожидаем.Что(Конфигурация.ПолучитьЗначение("existing")).Равно("receiver");
    Ожидаем.Что(Конфигурация.ПолучитьЗначение("new")).Равно("source");
    Ожидаем.Что(Конфигурация.ПолучитьЗначение("lib.additional"))
        .Равно("before" + Символ(0) + "after");
    Ожидаем.Что(Конфигурация.ПолучитьЗначение("lib.system")).Равно("before" + Символ(0) + "after");
    Ожидаем.Что(Конфигурация.ПолучитьНастройку("lib.additional").База).Равно("source-base");
    Ожидаем.Что(Конфигурация.ПолучитьНастройку("lib.system").База).Равно("source-base");

КонецПроцедуры

