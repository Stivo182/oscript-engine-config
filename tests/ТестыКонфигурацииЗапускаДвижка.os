    Ожидаем.Что(Конфигурация.ПолучитьМаксимальныйРазмерДвоичныхДанныхВПамяти()).Равно(Неопределено);
    Ожидаем.Что(Конфигурация.ПолучитьСистемныйКаталогБиблиотек()).Равно(Неопределено);
    Ожидаем.Что(Конфигурация.ПолучитьДополнительныеКаталогиБиблиотек()).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_УстановитьСистемныйКаталогБиблиотек() Экспорт

    // Подготовка
    База = ОбъединитьПути(ТекущийКаталог(), "system-base");
    Конфигурация = Новый КонфигурацияЗапускаДвижка();

    // Действие
    Конфигурация.УстановитьСистемныйКаталогБиблиотек(" system ", База);

    // Проверка
    Ожидаем.Что(Конфигурация.ПолучитьЗначение("lib.system")).Равно("system");
    Ожидаем.Что(Конфигурация.ПолучитьСистемныйКаталогБиблиотек()).Равно("system");
    Каталоги = Новый ЛокаторБиблиотекЗапускаДвижка(Конфигурация).ПолучитьКаталогиПоиска();
    Ожидаем.Что(Каталоги.Количество()).Равно(1);
    Ожидаем.Что(Каталоги[0]).Равно(Новый Файл(ОбъединитьПути(База, "system")).ПолноеИмя);

КонецПроцедуры

&Тест
Процедура ТестДолжен_УстановитьДополнительныеКаталогиБиблиотек() Экспорт

    // Подготовка
    База = ОбъединитьПути(ТекущийКаталог(), "additional-base");
    Конфигурация = Новый КонфигурацияЗапускаДвижка();
    Конфигурация.УстановитьБазовыйКаталог(ТекущийКаталог());
    Каталоги = Новый Массив;
    Каталоги.Добавить("first");
    Каталоги.Добавить("");
    Каталоги.Добавить("   ");
    Каталоги.Добавить(" second ");
    Каталоги.Добавить("first");

    // Действие
    Конфигурация.УстановитьДополнительныеКаталогиБиблиотек(Каталоги, База);

    // Проверка
    Ожидаем.Что(Конфигурация.ПолучитьЗначение("lib.additional")).Равно("first;second;first");
    СохраненныеКаталоги = Конфигурация.ПолучитьДополнительныеКаталогиБиблиотек();
    Ожидаем.Что(СохраненныеКаталоги.Количество()).Равно(3);
    Ожидаем.Что(СохраненныеКаталоги[0]).Равно("first");
    Ожидаем.Что(СохраненныеКаталоги[1]).Равно("second");
    Ожидаем.Что(СохраненныеКаталоги[2]).Равно("first");
    СохраненныеКаталоги.Очистить();
    Ожидаем.Что(Конфигурация.ПолучитьДополнительныеКаталогиБиблиотек().Количество()).Равно(3);
    РазрешенныеКаталоги = Новый ЛокаторБиблиотекЗапускаДвижка(Конфигурация).ПолучитьКаталогиПоиска();
    Ожидаем.Что(РазрешенныеКаталоги.Количество()).Равно(3);
    Ожидаем.Что(РазрешенныеКаталоги[0]).Равно(Новый Файл(ОбъединитьПути(База, "first")).ПолноеИмя);
    Ожидаем.Что(РазрешенныеКаталоги[1]).Равно(Новый Файл(ОбъединитьПути(База, "second")).ПолноеИмя);
    Ожидаем.Что(РазрешенныеКаталоги[2]).Равно(РазрешенныеКаталоги[0]);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДобавитьДополнительныйКаталогБиблиотек() Экспорт

    // Подготовка
    База = ОбъединитьПути(ТекущийКаталог(), "additional-base");
    Конфигурация = Новый КонфигурацияЗапускаДвижка();
    Каталоги = Новый Массив;
    Каталоги.Добавить("first");
    Конфигурация.УстановитьДополнительныеКаталогиБиблиотек(Каталоги, База);

    // Действие
    Конфигурация.ДобавитьДополнительныйКаталогБиблиотек(" second ");
    Конфигурация.ДобавитьДополнительныйКаталогБиблиотек("first");

    // Проверка
    Ожидаем.Что(Конфигурация.ПолучитьЗначение("lib.additional")).Равно("first;second;first");
    РазрешенныеКаталоги = Новый ЛокаторБиблиотекЗапускаДвижка(Конфигурация).ПолучитьКаталогиПоиска();
    Ожидаем.Что(РазрешенныеКаталоги[0]).Равно(Новый Файл(ОбъединитьПути(База, "first")).ПолноеИмя);
    Ожидаем.Что(РазрешенныеКаталоги[1]).Равно(Новый Файл(ОбъединитьПути(База, "second")).ПолноеИмя);
    Ожидаем.Что(РазрешенныеКаталоги[2]).Равно(РазрешенныеКаталоги[0]);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропуститьПустойДобавляемыйКаталогБиблиотек() Экспорт

    // Подготовка
    Конфигурация = Новый КонфигурацияЗапускаДвижка();

    // Действие
    Конфигурация.ДобавитьДополнительныйКаталогБиблиотек("   ");

    // Проверка
    Ожидаем.Что(Конфигурация.Содержит("lib.additional")).Равно(Ложь);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДобавитьПервыйДополнительныйКаталогОтБазыКонфигурации() Экспорт

    // Подготовка
    База = ОбъединитьПути(ТекущийКаталог(), "additional-base");
    Конфигурация = Новый КонфигурацияЗапускаДвижка();
    Конфигурация.УстановитьБазовыйКаталог(База);

    // Действие
    Конфигурация.ДобавитьДополнительныйКаталогБиблиотек(" first ");

    // Проверка
    Ожидаем.Что(Конфигурация.ПолучитьЗначение("lib.additional")).Равно("first");
    Ожидаем.Что(Новый ЛокаторБиблиотекЗапускаДвижка(Конфигурация).ПолучитьКаталогиПоиска()[0])
        .Равно(Новый Файл(ОбъединитьПути(База, "first")).ПолноеИмя);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНеверныйТипСпискаДополнительныхКаталоговБиблиотек() Экспорт

    // Подготовка
    Конфигурация = Новый КонфигурацияЗапускаДвижка();
    Конфигурация.Установить("lib.additional", "old");
    КодОшибки = Неопределено;

    // Действие
    Попытка
        Конфигурация.УстановитьДополнительныеКаталогиБиблиотек(42);
    Исключение
        КодОшибки = ДиагностикаОшибок.КодОшибки(ИнформацияОбОшибке());
    КонецПопытки;

    // Проверка
    Ожидаем.Что(КодОшибки).Равно("argument.invalid_type");
    Ожидаем.Что(Конфигурация.ПолучитьЗначение("lib.additional")).Равно("old");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНеверныйТипДополнительногоКаталогаБиблиотек() Экспорт

    // Подготовка
    Конфигурация = Новый КонфигурацияЗапускаДвижка();
    Конфигурация.Установить("lib.additional", "old");
    Каталоги = Новый Массив;
    Каталоги.Добавить("first");
    Каталоги.Добавить(42);
    КодОшибки = Неопределено;

    // Действие
    Попытка
        Конфигурация.УстановитьДополнительныеКаталогиБиблиотек(Каталоги);
    Исключение
        КодОшибки = ДиагностикаОшибок.КодОшибки(ИнформацияОбОшибке());
    КонецПопытки;

    // Проверка
    Ожидаем.Что(КодОшибки).Равно("argument.invalid_type");
    Ожидаем.Что(Конфигурация.ПолучитьЗначение("lib.additional")).Равно("old");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УстановитьПустойСписокДополнительныхКаталоговБиблиотек() Экспорт

    // Подготовка
    Конфигурация = Новый КонфигурацияЗапускаДвижка();
    Конфигурация.Установить("lib.additional", "old");

    // Действие
    Конфигурация.УстановитьДополнительныеКаталогиБиблиотек(Новый Массив);

    // Проверка
    Ожидаем.Что(Конфигурация.Содержит("lib.additional")).Равно(Истина);
    Ожидаем.Что(Конфигурация.ПолучитьЗначение("lib.additional")).Равно("");
    Ожидаем.Что(Конфигурация.ПолучитьДополнительныеКаталогиБиблиотек()).ИмеетТип("Массив");
    Ожидаем.Что(Конфигурация.ПолучитьДополнительныеКаталогиБиблиотек().Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьРазделительВДополнительномКаталогеБиблиотек() Экспорт

    // Подготовка
    Конфигурация = Новый КонфигурацияЗапускаДвижка();
    Конфигурация.Установить("lib.additional", "old");
    Каталоги = Новый Массив;
    Каталоги.Добавить("first;second");
    КодОшибки = Неопределено;

    // Действие
    Попытка
        Конфигурация.УстановитьДополнительныеКаталогиБиблиотек(Каталоги);
    Исключение
        КодОшибки = ДиагностикаОшибок.КодОшибки(ИнформацияОбОшибке());
    КонецПопытки;

    // Проверка
    Ожидаем.Что(КодОшибки).Равно("argument.invalid_value");
    Ожидаем.Что(Конфигурация.ПолучитьЗначение("lib.additional")).Равно("old");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьСтабильныеРежимыПутей() Экспорт
    // Действие и Проверка
    Ожидаем.Что(РежимыПутейКонфигурацииЗапускаДвижка.КакВИсточнике()).Равно("КакВИсточнике");
    Ожидаем.Что(РежимыПутейКонфигурацииЗапускаДвижка.Абсолютные()).Равно("Абсолютные");
    Ожидаем.Что(РежимыПутейКонфигурацииЗапускаДвижка.ОтносительноФайла()).Равно("ОтносительноФайла");
КонецПроцедуры

