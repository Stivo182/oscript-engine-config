#Использовать asserts
#Использовать errors
#Использовать tempfiles
#Использовать "../src"

Перем _ИсходноеОкружение; // Строка, Неопределено
Перем _ВременныеФайлы; // МенеджерВременныхФайлов

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередВсеми
Процедура ПередВсеми() Экспорт
    _ВременныеФайлы = Новый МенеджерВременныхФайлов;
КонецПроцедуры

&ПередКаждым
Процедура ПередКаждым() Экспорт
    _ИсходноеОкружение = ПолучитьПеременнуюСреды("OSCRIPT_CONFIG");
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
    УстановитьПеременнуюСреды("OSCRIPT_CONFIG", _ИсходноеОкружение);
    _ВременныеФайлы.Удалить();
КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_СоздатьКонфигурациюДляТекущегоЗапуска() Экспорт

    // Подготовка
    УстановитьПеременнуюСреды("OSCRIPT_CONFIG", "factory.current=value");

    // Действие
    Конфигурация = ФабрикаКонфигурацийЗапускаДвижка.СоздатьДляТекущегоЗапуска();

    // Проверка
    Ожидаем.Что(Конфигурация.ПолучитьЗначение("factory.current")).Равно("value");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьКонфигурациюИзФайла() Экспорт

    // Подготовка
    ПутьCFG = ОбъединитьПути(_ВременныеФайлы.СоздатьКаталог(), "factory.cfg");
    Документ = Новый ТекстовыйДокумент;
    Документ.УстановитьТекст("factory.file=value");
    Документ.Записать(ПутьCFG);

    // Действие
    Конфигурация = ФабрикаКонфигурацийЗапускаДвижка.СоздатьИзФайла(ПутьCFG);

    // Проверка
    Ожидаем.Что(Конфигурация.ПолучитьЗначение("factory.file")).Равно("value");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СчитатьФайлОбязательным() Экспорт

    // Подготовка
    НесуществующийCFG = ОбъединитьПути(_ВременныеФайлы.СоздатьКаталог(), "missing.cfg");
    Ошибка = Неопределено;

    // Действие
    Попытка
        ФабрикаКонфигурацийЗапускаДвижка.СоздатьИзФайла(НесуществующийCFG);
    Исключение
        Ошибка = ИнформацияОбОшибке();
    КонецПопытки;

    // Проверка
    Ожидаем.Что(Ошибка = Неопределено).Равно(Ложь);
    Ожидаем.Что(ДиагностикаОшибок.Содержит(Ошибка, КодыОшибокEngineConfig.РасчетКонфигурацииНеВыполнен()))
        .Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьКонфигурациюИзТекущегоОкружения() Экспорт

    // Подготовка
    РабочийКаталог = _ВременныеФайлы.СоздатьКаталог();
    УстановитьПеременнуюСреды("OSCRIPT_CONFIG", "lib.system=relative-lib");

    // Действие
    Конфигурация = ФабрикаКонфигурацийЗапускаДвижка.СоздатьИзТекущегоОкружения(РабочийКаталог);

    // Проверка
    Каталоги = Новый ЛокаторБиблиотекЗапускаДвижка(Конфигурация).ПолучитьКаталогиПоиска();
    Ожидаем.Что(Каталоги[0]).Равно(ОбъединитьПути(РабочийКаталог, "relative-lib"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьКонфигурациюИзНастроекОкружения() Экспорт

    // Подготовка
    РабочийКаталог = _ВременныеФайлы.СоздатьКаталог();
    УстановитьПеременнуюСреды("OSCRIPT_CONFIG", "factory.explicit=unexpected");

    // Действие
    Конфигурация = ФабрикаКонфигурацийЗапускаДвижка.СоздатьИзНастроекОкружения(
        "factory.explicit=value;lib.system=relative-lib",
        РабочийКаталог
    );

    // Проверка
    Ожидаем.Что(Конфигурация.ПолучитьЗначение("factory.explicit")).Равно("value");
    Каталоги = Новый ЛокаторБиблиотекЗапускаДвижка(Конфигурация).ПолучитьКаталогиПоиска();
    Ожидаем.Что(Каталоги[0]).Равно(ОбъединитьПути(РабочийКаталог, "relative-lib"));

КонецПроцедуры

#КонецОбласти
