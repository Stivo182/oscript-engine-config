#Использовать asserts
#Использовать errors
#Использовать tempfiles
#Использовать "../src"

Перем _ВременныеФайлы; // МенеджерВременныхФайлов
Перем _Каталог; // Строка
Перем _КаталогДвижка; // Строка
Перем _ИсходноеОкружение; // Строка, Неопределено

#Область ОбработчикиСобытий

// Проверяет ошибки в отдельном каталоге и сохраняет окружение процесса.
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередВсеми
Процедура ПередВсеми() Экспорт

    _ВременныеФайлы = Новый МенеджерВременныхФайлов;
    _Каталог = _ВременныеФайлы.СоздатьКаталог();
    _КаталогДвижка = ОбъединитьПути(_Каталог, "engine");

    СоздатьКаталог(ОбъединитьПути(_КаталогДвижка, "bin"));
    СоздатьКаталог(ОбъединитьПути(_КаталогДвижка, "lib"));

    _ИсходноеОкружение = ПолучитьПеременнуюСреды("OSCRIPT_CONFIG");

КонецПроцедуры

&ПослеВсех
Процедура ПослеВсех() Экспорт

    УстановитьПеременнуюСреды("OSCRIPT_CONFIG", _ИсходноеОкружение);

    Если _ВременныеФайлы <> Неопределено Тогда
        _ВременныеФайлы.Удалить();
    КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_КлассифицироватьОтказЧтенияCFGССистемнойПричиной() Экспорт

    // Подготовка
    КаталогВхода = ОбъединитьПути(_Каталог, "unreadable");
    ПутьCFG = ОбъединитьПути(КаталогВхода, "oscript.cfg");
    СоздатьКаталог(ПутьCFG);
    Построитель = Новый ПостроительКонфигурацииЗапускаДвижка;
    Построитель.ДобавитьФайлКонфигурации(ПутьCFG);
    Ошибка = Неопределено;

    // Действие
    Попытка
        Построитель.Построить();
    Исключение
        Ошибка = ИнформацияОбОшибке();
    КонецПопытки;

    // Проверка
    Ожидаем.Что(ДиагностикаОшибок.Содержит(Ошибка, КодыОшибокEngineConfig.РасчетКонфигурацииНеВыполнен())).Равно(Истина);
    Ожидаем.Что(ДиагностикаОшибок.ДанныеОшибки(Ошибка)).Равно(Неопределено);
    Ожидаем.Что(ДиагностикаОшибок.КорневаяПричина(Ошибка).КодОшибки()).Равно("");

КонецПроцедуры

&Тест
Процедура ТестДолжен_КлассифицироватьОтказЗаписиССистемнойПричиной() Экспорт

    // Подготовка
    Конфигурация = Новый КонфигурацияЗапускаДвижка();
    Путь = ОбъединитьПути(_Каталог, "missing", "oscript.cfg");
    Ошибка = Неопределено;

    // Действие
    Попытка
        Конфигурация.ЗаписатьВФайл(Путь);
    Исключение
        Ошибка = ИнформацияОбОшибке();
    КонецПопытки;

    // Проверка
    Ожидаем.Что(ДиагностикаОшибок.Содержит(Ошибка, КодыОшибокEngineConfig.ЗаписьКонфигурацииНеВыполнена())).Равно(Истина);
    Ожидаем.Что(ДиагностикаОшибок.ДанныеОшибки(Ошибка).Путь).Равно(Путь);
    Ожидаем.Что(ДиагностикаОшибок.КорневаяПричина(Ошибка).КодОшибки()).Равно("");
    Ожидаем.Что(Новый Файл(Путь).Существует()).Равно(Ложь);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьПредметнуюПричинуОтказаУстановкиОкружения() Экспорт

    // Подготовка
    Конфигурация = Новый КонфигурацияЗапускаДвижка();
    Конфигурация.Установить("bad-key", "value");
    Ошибка = Неопределено;

    // Действие
    Попытка
        Конфигурация.УстановитьВПеременнуюОкружения();
    Исключение
        Ошибка = ИнформацияОбОшибке();
    КонецПопытки;

    // Проверка
    Ожидаем.Что(ДиагностикаОшибок.Содержит(Ошибка, КодыОшибокEngineConfig.УстановкаОкруженияНеВыполнена())).Равно(Истина);
    Ожидаем.Что(ДиагностикаОшибок.Содержит(Ошибка, КодыОшибокEngineConfig.НекорректнаяКонфигурация())).Равно(Истина);
    Ожидаем.Что(ДиагностикаОшибок.НайтиПервую(Ошибка, КодыОшибокEngineConfig.НекорректнаяКонфигурация()).Данные().Ключ).Равно("bad-key");
    Ожидаем.Что(ПолучитьПеременнуюСреды("OSCRIPT_CONFIG")).Равно(_ИсходноеОкружение);

КонецПроцедуры

&Тест
Процедура ТестДолжен_КлассифицироватьНеразрешимыйПутьБиблиотеки() Экспорт

    // Подготовка
    Конфигурация = Новый КонфигурацияЗапускаДвижка();
    Конфигурация.УстановитьБазовыйКаталог(_Каталог);
    Путь = "before" + Символ(0) + "after";
    Конфигурация.Установить("lib.system", Путь);
    Ошибка = Неопределено;

    // Действие
    Попытка
        Конфигурация.ПолучитьКаталогиПоискаБиблиотек();
    Исключение
        Ошибка = ИнформацияОбОшибке();
    КонецПопытки;

    // Проверка
    Ожидаем.Что(ДиагностикаОшибок.Содержит(Ошибка, КодыОшибокEngineConfig.ПутьНеРазрешен())).Равно(Истина);
    Ожидаем.Что(ДиагностикаОшибок.ДанныеОшибки(Ошибка).Путь).Равно(Путь);
    Ожидаем.Что(ДиагностикаОшибок.ДанныеОшибки(Ошибка).База).Равно(_Каталог);
    Ожидаем.Что(ДиагностикаОшибок.КорневаяПричина(Ошибка).КодОшибки()).Равно("");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьКлючНепредставимойПарыCFGВДанныхОшибки() Экспорт

    // Подготовка
    Конфигурация = Новый КонфигурацияЗапускаДвижка();
    Конфигурация.Установить(" key ", "value");
    Ошибка = Неопределено;

    // Действие
    Попытка
        Конфигурация.ЗаписатьВФайл(ОбъединитьПути(_Каталог, "invalid.cfg"));
    Исключение
        Ошибка = ИнформацияОбОшибке();
    КонецПопытки;

    // Проверка
    Ожидаем.Что(ДиагностикаОшибок.Содержит(Ошибка, КодыОшибокEngineConfig.НекорректнаяКонфигурация())).Равно(Истина);
    Данные = ДиагностикаОшибок.НайтиПервую(Ошибка, КодыОшибокEngineConfig.НекорректнаяКонфигурация()).Данные();
    Ожидаем.Что(Данные <> Неопределено).Равно(Истина);
    Ожидаем.Что(Данные.Ключ).Равно(" key ");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Конфигурация.УстановитьБазовыйКаталог(42);")
&ИсточникЗначение("Конфигурация.Содержит(42);")
&ИсточникЗначение("Конфигурация.Получить(42);")
&ИсточникЗначение("Конфигурация.Установить(42, ""value"");")
&ИсточникЗначение("Конфигурация.Установить(""key"", 42);")
&ИсточникЗначение("Конфигурация.Удалить(42);")
&ИсточникЗначение("Конфигурация.ЗаписатьВФайл(42);")
&ИсточникЗначение("Конфигурация.ЗаписатьВФайл(""unused.cfg"", 42);")
&ИсточникЗначение("Конфигурация.НайтиКаталогБиблиотеки(42);")
&ИсточникЗначение("Построитель.ДобавитьФайлКонфигурации(42);")
&ИсточникЗначение("Построитель.ДобавитьНастройкиОкружения(42, _Каталог);")
&ИсточникЗначение("Построитель.ДобавитьНастройкиОкружения(""value=source"", 42);")
&ИсточникЗначение("Построитель.ДобавитьТекущееОкружение(42);")
Процедура ТестДолжен_СохранитьСтандартныйКодНеверногоТипаАргумента(Действие) Экспорт

    // Подготовка
    Конфигурация = Новый КонфигурацияЗапускаДвижка();
    Построитель = Новый ПостроительКонфигурацииЗапускаДвижка;
    Ошибка = Неопределено;

    // Действие
    Попытка
        Выполнить(Действие);
    Исключение
        Ошибка = ИнформацияОбОшибке();
    КонецПопытки;

    // Проверка
    Ожидаем.Что(Ошибка <> Неопределено).Равно(Истина);
    Ожидаем.Что(ДиагностикаОшибок.Содержит(Ошибка, "argument.invalid_type")).Равно(Истина);
    Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно("argument.invalid_type");

КонецПроцедуры

#КонецОбласти
