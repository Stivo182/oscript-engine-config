#Использовать asserts
#Использовать errors
#Использовать tempfiles
#Использовать "../src"

Перем _ВременныеФайлы; // МенеджерВременныхФайлов
Перем _Каталог; // Строка

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередВсеми
Процедура ПередВсеми() Экспорт
    _ВременныеФайлы = Новый МенеджерВременныхФайлов;
    _Каталог = _ВременныеФайлы.СоздатьКаталог();
КонецПроцедуры

&ПослеВсех
Процедура ПослеВсех() Экспорт
    Если _ВременныеФайлы <> Неопределено Тогда
        _ВременныеФайлы.Удалить();
    КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_АгрегироватьКаталогиВсехКонфигураций() Экспорт

    // Подготовка
    ПерваяКонфигурация = Новый КонфигурацияИнтерпретатора;
    ПерваяКонфигурация.УстановитьБазовыйКаталог(_Каталог);
    ПерваяКонфигурация.Установить("lib.additional", "first-additional");
    ПерваяКонфигурация.Установить("lib.system", "first-system");

    ВтораяКонфигурация = Новый КонфигурацияИнтерпретатора;
    ВтораяКонфигурация.УстановитьБазовыйКаталог(_Каталог);
    ВтораяКонфигурация.Установить("lib.additional", "first-system;second-additional");
    ВтораяКонфигурация.Установить("lib.system", "second-system");

    Конфигурации = Новый Массив;
    Конфигурации.Добавить(ПерваяКонфигурация);
    Конфигурации.Добавить(ВтораяКонфигурация);

    // Действие
    Локатор = Новый ЛокаторБиблиотекПоКонфигурации(Конфигурации);

    // Проверка
    Дополнительные = Локатор.ПолучитьДополнительныеКаталоги();
    Ожидаем.Что(Дополнительные.Количество()).Равно(3);
    Ожидаем.Что(Дополнительные[0]).Равно(ОбъединитьПути(_Каталог, "first-additional"));
    Ожидаем.Что(Дополнительные[1]).Равно(ОбъединитьПути(_Каталог, "first-system"));
    Ожидаем.Что(Дополнительные[2]).Равно(ОбъединитьПути(_Каталог, "second-additional"));

    Системные = Локатор.ПолучитьСистемныеКаталоги();
    Ожидаем.Что(Системные.Количество()).Равно(2);
    Ожидаем.Что(Системные[0]).Равно(ОбъединитьПути(_Каталог, "first-system"));
    Ожидаем.Что(Системные[1]).Равно(ОбъединитьПути(_Каталог, "second-system"));

    КаталогиПоиска = Локатор.ПолучитьКаталогиПоиска();
    Ожидаем.Что(КаталогиПоиска.Количество()).Равно(4);
    Ожидаем.Что(КаталогиПоиска[0]).Равно(ОбъединитьПути(_Каталог, "first-additional"));
    Ожидаем.Что(КаталогиПоиска[1]).Равно(ОбъединитьПути(_Каталог, "first-system"));
    Ожидаем.Что(КаталогиПоиска[2]).Равно(ОбъединитьПути(_Каталог, "second-additional"));
    Ожидаем.Что(КаталогиПоиска[3]).Равно(ОбъединитьПути(_Каталог, "second-system"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПолучитьКаталогиПоискаБиблиотек() Экспорт

    // Подготовка
    Конфигурация = Новый КонфигурацияИнтерпретатора;
    Конфигурация.УстановитьБазовыйКаталог(_Каталог);
    Конфигурация.Установить("lib.additional", "first;second");
    Конфигурация.Установить("lib.system", "system");

    // Действие
    Локатор = Новый ЛокаторБиблиотекПоКонфигурации(Конфигурация);

    // Проверка
    Дополнительные = Локатор.ПолучитьДополнительныеКаталоги();
    Ожидаем.Что(Дополнительные.Количество()).Равно(2);
    Ожидаем.Что(Дополнительные[0]).Равно(ОбъединитьПути(_Каталог, "first"));
    Ожидаем.Что(Дополнительные[1]).Равно(ОбъединитьПути(_Каталог, "second"));

    Системные = Локатор.ПолучитьСистемныеКаталоги();
    Ожидаем.Что(Системные.Количество()).Равно(1);
    Ожидаем.Что(Системные[0]).Равно(ОбъединитьПути(_Каталог, "system"));

    КаталогиПоиска = Локатор.ПолучитьКаталогиПоиска();
    Ожидаем.Что(КаталогиПоиска.Количество()).Равно(3);
    Ожидаем.Что(КаталогиПоиска[2]).Равно(ОбъединитьПути(_Каталог, "system"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьУникальныеКаталогиПоиска() Экспорт

    // Подготовка
    Конфигурация = Новый КонфигурацияИнтерпретатора;
    Конфигурация.УстановитьБазовыйКаталог(_Каталог);
    Конфигурация.Установить("lib.additional", "first;second;first");
    Конфигурация.Установить("lib.system", "second");
    Локатор = Новый ЛокаторБиблиотекПоКонфигурации(Конфигурация);

    // Действие
    КаталогиПоиска = Локатор.ПолучитьКаталогиПоиска();

    // Проверка
    Ожидаем.Что(КаталогиПоиска.Количество()).Равно(2);
    Ожидаем.Что(КаталогиПоиска[0]).Равно(ОбъединитьПути(_Каталог, "first"));
    Ожидаем.Что(КаталогиПоиска[1]).Равно(ОбъединитьПути(_Каталог, "second"));
    Ожидаем.Что(Локатор.ПолучитьДополнительныеКаталоги().Количество()).Равно(3);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропуститьНезаполненныеКаталогиПоиска() Экспорт

    // Подготовка
    Конфигурация = Новый КонфигурацияИнтерпретатора;
    Конфигурация.УстановитьБазовыйКаталог(_Каталог);
    Конфигурация.Установить("lib.additional", " ; first; ; ");
    Конфигурация.Установить("lib.system", "   ");

    // Действие
    Локатор = Новый ЛокаторБиблиотекПоКонфигурации(Конфигурация);

    // Проверка
    Ожидаем.Что(Локатор.ПолучитьСистемныеКаталоги().Количество()).Равно(0);
    Ожидаем.Что(Локатор.ПолучитьДополнительныеКаталоги().Количество()).Равно(1);
    КаталогиПоиска = Локатор.ПолучитьКаталогиПоиска();
    Ожидаем.Что(КаталогиПоиска.Количество()).Равно(1);
    Ожидаем.Что(КаталогиПоиска[0]).Равно(ОбъединитьПути(_Каталог, "first"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиПервыйКаталогБиблиотеки() Экспорт

    // Подготовка
    СоздатьКаталог(ОбъединитьПути(_Каталог, "first", "library"));
    СоздатьКаталог(ОбъединитьПути(_Каталог, "second", "library"));
    Конфигурация = Новый КонфигурацияИнтерпретатора;
    Каталоги = Новый Массив;
    Каталоги.Добавить(ОбъединитьПути(_Каталог, "first"));
    Каталоги.Добавить(ОбъединитьПути(_Каталог, "second"));
    Конфигурация.УстановитьДополнительныеКаталогиБиблиотек(Каталоги);
    Локатор = Новый ЛокаторБиблиотекПоКонфигурации(Конфигурация);

    // Действие
    Библиотека = Локатор.НайтиКаталогБиблиотеки("library");

    // Проверка
    Ожидаем.Что(Библиотека).Равно(ОбъединитьПути(_Каталог, "first", "library"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиВсеКаталогиБиблиотеки() Экспорт

    // Подготовка
    База = ОбъединитьПути(_Каталог, Строка(Новый УникальныйИдентификатор));
    СоздатьКаталог(ОбъединитьПути(База, "first", "library"));
    СоздатьКаталог(ОбъединитьПути(База, "second", "library"));
    СоздатьКаталог(ОбъединитьПути(База, "system", "library"));
    Конфигурация = Новый КонфигурацияИнтерпретатора;
    Конфигурация.УстановитьБазовыйКаталог(База);
    Конфигурация.Установить("lib.additional", "first;missing;second");
    Конфигурация.Установить("lib.system", "system");
    Локатор = Новый ЛокаторБиблиотекПоКонфигурации(Конфигурация);

    // Действие
    Каталоги = Локатор.НайтиВсеКаталогиБиблиотеки("library");

    // Проверка
    Ожидаем.Что(Каталоги.Количество()).Равно(3);
    Ожидаем.Что(Каталоги[0]).Равно(ОбъединитьПути(База, "first", "library"));
    Ожидаем.Что(Каталоги[1]).Равно(ОбъединитьПути(База, "second", "library"));
    Ожидаем.Что(Каталоги[2]).Равно(ОбъединитьПути(База, "system", "library"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПустойМассивЕслиБиблиотекаНеНайдена() Экспорт

    // Подготовка
    Конфигурация = Новый КонфигурацияИнтерпретатора;
    Конфигурация.УстановитьСистемныйКаталогБиблиотек(_Каталог);
    Локатор = Новый ЛокаторБиблиотекПоКонфигурации(Конфигурация);

    // Действие
    Каталоги = Локатор.НайтиВсеКаталогиБиблиотеки("absent-library");

    // Проверка
    Ожидаем.Что(Каталоги).ИмеетТип("Массив");
    Ожидаем.Что(Каталоги.Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроверитьИмяПриПоискеВсехКаталогов() Экспорт

    // Подготовка
    Локатор = Новый ЛокаторБиблиотекПоКонфигурации(Новый КонфигурацияИнтерпретатора);
    Ошибка = Неопределено;

    // Действие
    Попытка
        Локатор.НайтиВсеКаталогиБиблиотеки("../library");
    Исключение
        Ошибка = ИнформацияОбОшибке();
    КонецПопытки;

    // Проверка
    Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно("argument.invalid_value");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗафиксироватьСнимокКонфигурации() Экспорт

    // Подготовка
    Конфигурация = Новый КонфигурацияИнтерпретатора;
    Конфигурация.УстановитьСистемныйКаталогБиблиотек("first", _Каталог);
    Локатор = Новый ЛокаторБиблиотекПоКонфигурации(Конфигурация);

    // Действие
    Конфигурация.УстановитьСистемныйКаталогБиблиотек("second", _Каталог);

    // Проверка
    Ожидаем.Что(Локатор.ПолучитьСистемныеКаталоги()[0]).Равно(ОбъединитьПути(_Каталог, "first"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВозвращатьНезависимыеМассивы() Экспорт

    // Подготовка
    Конфигурация = Новый КонфигурацияИнтерпретатора;
    Конфигурация.Установить("lib.additional", "first;second");
    Локатор = Новый ЛокаторБиблиотекПоКонфигурации(Конфигурация);
    Дополнительные = Локатор.ПолучитьДополнительныеКаталоги();
    КаталогиПоиска = Локатор.ПолучитьКаталогиПоиска();

    // Действие
    Дополнительные.Очистить();
    КаталогиПоиска.Очистить();

    // Проверка
    Ожидаем.Что(Локатор.ПолучитьДополнительныеКаталоги().Количество()).Равно(2);
    Ожидаем.Что(Локатор.ПолучитьКаталогиПоиска().Количество()).Равно(2);

КонецПроцедуры

