#Использовать asserts
#Использовать tempfiles
#Использовать "../src"
#Использовать "../src/internal"

Перем _ВременныеФайлы; // МенеджерВременныхФайлов
Перем _Каталог; // Строка
Перем _ИсходноеОкружение; // Строка, Неопределено
Перем _ИсходныйКаталог; // Строка

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередВсеми
Процедура ПередВсеми() Экспорт
    _ВременныеФайлы = Новый МенеджерВременныхФайлов;
КонецПроцедуры

&ПередКаждым
Процедура ПередКаждым() Экспорт
    _ИсходноеОкружение = ПолучитьПеременнуюСреды("OSCRIPT_CONFIG");
    _ИсходныйКаталог = ТекущийКаталог();
    _Каталог = _ВременныеФайлы.СоздатьКаталог();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
    УстановитьПеременнуюСреды("OSCRIPT_CONFIG", _ИсходноеОкружение);
    УстановитьТекущийКаталог(_ИсходныйКаталог);
    _ВременныеФайлы.Удалить();
КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_ПолучитьНастройкиИзФайлаКонфигурации() Экспорт

    // Подготовка
    ПутьCFG = ОбъединитьПути(_Каталог, "source.cfg");
    ЗаписатьТекст(ПутьCFG, "value=source");
    Источник = Новый ИсточникКонфигурацииИнтерпретатораИзФайла(ПутьCFG, Истина);

    // Действие
    Настройки = Источник.ПолучитьНастройки();

    // Проверка
    Ожидаем.Что(Настройки.Количество()).Равно(1);
    Ожидаем.Что(Настройки[0].Ключ).Равно("value");
    Ожидаем.Что(Настройки[0].Значение).Равно("source");
    Ожидаем.Что(Настройки[0].База).Равно(Новый Файл(ПутьCFG).Путь);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропуститьОтсутствующийНеобязательныйФайл() Экспорт

    // Подготовка
    ПутьCFG = ОбъединитьПути(_Каталог, "missing.cfg");
    Источник = Новый ИсточникКонфигурацииИнтерпретатораИзФайла(ПутьCFG, Ложь);

    // Действие
    Настройки = Источник.ПолучитьНастройки();

    // Проверка
    Ожидаем.Что(Настройки.Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПолучитьЯвныеНастройкиОкружения() Экспорт

    // Подготовка
    Источник = Новый ИсточникКонфигурацииИнтерпретатораИзСтрокиОкружения("value=explicit", _Каталог);

    // Действие
    Настройки = Источник.ПолучитьНастройки();

    // Проверка
    Ожидаем.Что(Настройки.Количество()).Равно(1);
    Ожидаем.Что(Настройки[0].Значение).Равно("explicit");
    Ожидаем.Что(Настройки[0].База).Равно(_Каталог);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИспользоватьТекущийКаталогДляЯвногоОкруженияБезБазы() Экспорт

    // Подготовка
    УстановитьТекущийКаталог(_Каталог);
    Источник = Новый ИсточникКонфигурацииИнтерпретатораИзСтрокиОкружения("value=explicit");

    // Действие
    Настройки = Источник.ПолучитьНастройки();

    // Проверка
    Ожидаем.Что(Настройки[0].База).Равно(ТекущийКаталог());

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПолучитьТекущееОкружениеСФиксированнойБазой() Экспорт

    // Подготовка
    УстановитьПеременнуюСреды("OSCRIPT_CONFIG", "value=current");
    Источник = Новый ИсточникКонфигурацииИнтерпретатораИзТекущегоОкружения(_Каталог);

    // Действие
    Настройки = Источник.ПолучитьНастройки();

    // Проверка
    Ожидаем.Что(Настройки.Количество()).Равно(1);
    Ожидаем.Что(Настройки[0].Значение).Равно("current");
    Ожидаем.Что(Настройки[0].База).Равно(_Каталог);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПолучитьТекущееОкружениеСТекущейБазой() Экспорт

    // Подготовка
    УстановитьПеременнуюСреды("OSCRIPT_CONFIG", "value=current-run");
    УстановитьТекущийКаталог(_Каталог);
    Источник = Новый ИсточникКонфигурацииИнтерпретатораИзТекущегоОкружения;

    // Действие
    Настройки = Источник.ПолучитьНастройки();

    // Проверка
    Ожидаем.Что(Настройки.Количество()).Равно(1);
    Ожидаем.Что(Настройки[0].Значение).Равно("current-run");
    Ожидаем.Что(Настройки[0].База).Равно(ТекущийКаталог());

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаписатьТекст(Путь, Текст)
    Документ = Новый ТекстовыйДокумент;
    Документ.УстановитьТекст(Текст);
    Документ.Записать(Путь);
КонецПроцедуры

#КонецОбласти
