#Использовать asserts
#Использовать errors
#Использовать tempfiles
#Использовать "../src"
#Использовать "../src/internal"

Перем _ВременныеФайлы; // МенеджерВременныхФайлов
Перем _Каталог; // Строка
Перем _ВекторыОкружения; // Массив

#Область ОбработчикиСобытий

// Создает единый экземпляр набора для подготовки и удаления временного каталога.
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередВсеми
Процедура ПередВсеми() Экспорт

    _ВременныеФайлы = Новый МенеджерВременныхФайлов;
    _Каталог = _ВременныеФайлы.СоздатьКаталог();

    Чтение = Новый ЧтениеJSON;
    Чтение.ОткрытьФайл(ОбъединитьПути(
        ТекущийСценарий().Каталог,
        "fixtures/oscript-config-vectors.json"
    ));
    _ВекторыОкружения = ПрочитатьJSON(Чтение);
    Чтение.Закрыть();

КонецПроцедуры

&ПослеВсех
Процедура ПослеВсех() Экспорт
    Если _ВременныеФайлы <> Неопределено Тогда
        _ВременныеФайлы.Удалить();
    КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_ПропуститьПустыеСтрокиКомментарииИСтрокиБезРавноВCFG() Экспорт

    // Подготовка
    Текст = "#research.comment=ignored" + Символы.ПС + Символы.ПС
        + " " + Символы.Таб + Символы.ПС + Символ(160) + Символы.ПС
        + "research.invalid" + Символы.ПС + "[section]";
    ПутьCFG = ЗаписатьCFG(Текст);

    // Действие
    ФайлКонфигурации = Новый ФайлКонфигурацииЗапускаДвижка(ПутьCFG);
    Источник = ФайлКонфигурации.Прочитать();

    // Проверка
    Ожидаем.Что(Источник.Количество()).Равно(0);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(" #research.indented=active", "#research.indented", "active")
&ИсточникЗначение(";research.semicolon=active", ";research.semicolon", "active")
&ИсточникЗначение("bad key=accepted", "bad key", "accepted")
&ИсточникЗначение("research.equals=a=b=c", "research.equals", "a=b=c")
&ИсточникЗначение("research.inline=value # literal", "research.inline", "value # literal")
&ИсточникЗначение("research.quoted=""C:\a b\x""", "research.quoted", """C:\a b\x""")
&ИсточникЗначение("research.delimiters=one;two", "research.delimiters", "one;two")
&ИсточникЗначение("research.empty=  ", "research.empty", "")
Процедура ТестДолжен_ПрочитатьЛитеральнуюПаруCFG(Текст, Ключ, Значение) Экспорт

    // Подготовка
    ПутьCFG = ЗаписатьCFG(Текст);

    // Действие
    ФайлКонфигурации = Новый ФайлКонфигурацииЗапускаДвижка(ПутьCFG);
    Источник = ФайлКонфигурации.Прочитать();

    // Проверка
    Ожидаем.Что(Источник.Количество()).Равно(1);
    Ожидаем.Что(Источник[0].Ключ).Равно(Ключ);
    Ожидаем.Что(Источник[0].Значение).Равно(Значение);
    Ожидаем.Что(Источник[0].База).Равно(Новый Файл(ПутьCFG).Путь);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(" ")
&ИсточникЗначение("ТАБ")
&ИсточникЗначение("NBSP")
Процедура ТестДолжен_ОбрезатьВнешниеПробелыCFG(Разделитель) Экспорт

    // Подготовка
    Если Разделитель = "ТАБ" Тогда
        Разделитель = Символы.Таб;
    ИначеЕсли Разделитель = "NBSP" Тогда
        Разделитель = Символ(160);
    КонецЕсли;

    ПутьCFG = ЗаписатьCFG(Разделитель + "research.trim" + Разделитель + "=" + Разделитель + "value" + Разделитель);

    // Действие
    ФайлКонфигурации = Новый ФайлКонфигурацииЗапускаДвижка(ПутьCFG);
    Источник = ФайлКонфигурации.Прочитать();

    // Проверка
    Ожидаем.Что(Источник.Количество()).Равно(1);
    Ожидаем.Что(Источник[0].Ключ).Равно("research.trim");
    Ожидаем.Что(Источник[0].Значение).Равно("value");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьПорядокПриЗаменеТочногоДубляCFG() Экспорт

    // Подготовка
    ПутьCFG = ЗаписатьCFG("k=first" + Символы.ПС + "K=second" + Символы.ПС + "k=third");

    // Действие
    ФайлКонфигурации = Новый ФайлКонфигурацииЗапускаДвижка(ПутьCFG);
    Источник = ФайлКонфигурации.Прочитать();

    // Проверка
    Ожидаем.Что(Источник.Количество()).Равно(2);
    Ожидаем.Что(Источник[0].Ключ).Равно("k");
    Ожидаем.Что(Источник[0].Значение).Равно("third");
    Ожидаем.Что(Источник[1].Ключ).Равно("K");
    Ожидаем.Что(Источник[1].Значение).Равно("second");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("=value")
&ИсточникЗначение("   =value")
&ИсточникЗначение("=")
Процедура ТестДолжен_ОтклонитьПустойКлючCFGПриПостроении(Текст) Экспорт

    // Подготовка
    ПутьCFG = ЗаписатьCFG(Текст);
    Построитель = Новый ПостроительКонфигурацииИнтерпретатора;
    Построитель.ДобавитьФайлКонфигурации(ПутьCFG);

    Ошибка = Неопределено;

    // Действие
    Попытка
        Построитель.Построить();
    Исключение
        Ошибка = ИнформацияОбОшибке();
    КонецПопытки;

    // Проверка
    Ожидаем.Что(ДиагностикаОшибок.Содержит(Ошибка, КодыОшибокEngineConfig.НекорректнаяКонфигурация())).Равно(Истина);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("UTF-8 LF", "cmVzZWFyY2guZW5jb2Rpbmc90JblgKQKcmVzZWFyY2gubmV4dD10YWlsCg==")
&ИсточникЗначение("UTF-8 BOM CRLF", "77u/cmVzZWFyY2guZW5jb2Rpbmc90JblgKQNCnJlc2VhcmNoLm5leHQ9dGFpbA0K")
Процедура ТестДолжен_ПрочитатьКодировкуИОкончанияСтрокCFG(Формат, Байты) Экспорт

    // Подготовка
    ПутьCFG = ОбъединитьПути(_Каталог, Формат + ".cfg");
    Base64Значение(Байты).Записать(ПутьCFG);

    // Действие
    ФайлКонфигурации = Новый ФайлКонфигурацииЗапускаДвижка(ПутьCFG);
    Источник = ФайлКонфигурации.Прочитать();

    // Проверка
    Ожидаем.Что(Источник.Количество()).Равно(2);
    Ожидаем.Что(Источник[0].Ключ).Равно("research.encoding");
    Ожидаем.Что(Источник[0].Значение).Равно("Ж値");
    Ожидаем.Что(Источник[1].Значение).Равно("tail");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("empty-variable")
&ИсточникЗначение("semicolon-and-equals")
&ИсточникЗначение("single-quotes")
&ИсточникЗначение("double-quotes")
&ИсточникЗначение("doubled-quotes")
&ИсточникЗначение("unquoted-quotes-and-backslash")
&ИсточникЗначение("no-backslash-escape")
&ИсточникЗначение("space-separates-pairs")
&ИсточникЗначение("double-space-is-escape")
&ИсточникЗначение("unquoted-tab-newline")
&ИсточникЗначение("whitespace-in-key")
&ИсточникЗначение("exact-duplicates")
&ИсточникЗначение("case-collisions")
&ИсточникЗначение("empty-values")
&ИсточникЗначение("unclosed-single-quote")
&ИсточникЗначение("unclosed-double-quote")
&ИсточникЗначение("quoted-adjacent-pair")
&ИсточникЗначение("leading-semicolon-stops")
&ИсточникЗначение("extra-semicolon-stops")
&ИсточникЗначение("trailing-semicolon")
&ИсточникЗначение("invalid-leading-digit-stops")
&ИсточникЗначение("invalid-leading-underscore-stops")
&ИсточникЗначение("invalid-leading-dot-stops")
&ИсточникЗначение("invalid-hyphen-stops")
&ИсточникЗначение("empty-key-stops")
&ИсточникЗначение("missing-equals-stops")
&ИсточникЗначение("missing-equals-at-end-stops")
&ИсточникЗначение("unicode-letters")
&ИсточникЗначение("combining-mark-stops")
Процедура ТестДолжен_РазобратьВекторСтрокиОкружения(ИмяВектора) Экспорт

    // Подготовка
    Вектор = ВекторОкружения(ИмяВектора);
    ПутьCFG = ЗаписатьCFG("research.base=cfg");
    Построитель = Новый ПостроительКонфигурацииИнтерпретатора;
    Построитель
        .ДобавитьФайлКонфигурации(ПутьCFG)
        .ДобавитьНастройкиОкружения(Вектор.text, _Каталог);

    СтрокаОкружения = Новый СтрокаОкруженияЗапускаДвижка;

    // Действие
    Источник = СтрокаОкружения.Разобрать(Вектор.text, _Каталог);
    Конфигурация = Построитель.Построить();

    // Проверка
    Для Индекс = 0 По Вектор.keys.Количество() - 1 Цикл
        Ожидание = Вектор.expected[Индекс];
        ЗначениеНастройки = Конфигурация.ПолучитьЗначение(Вектор.keys[Индекс]);
        Если Ожидание = "<missing>" Тогда
            Ожидаем.Что(ЗначениеНастройки).Равно(Неопределено);
        Иначе
            Значение = Сред(Ожидание, 2, СтрДлина(Ожидание) - 2);
            Значение = СтрЗаменить(СтрЗаменить(Значение, "\t", Символы.Таб), "\n", Символы.ПС);
            Ожидаем.Что(ЗначениеНастройки).Равно(Значение);
        КонецЕсли;
    КонецЦикла;

    Для Каждого Настройка Из Источник Цикл
        Ожидаем.Что(Настройка.База).Равно(_Каталог);
    КонецЦикла;

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("whitespace-only-errors")
&ИсточникЗначение("trailing-whitespace-after-separator-errors")
Процедура ТестДолжен_ОтклонитьВыходЗаСтрокуПослеПробеловОкружения(ИмяВектора) Экспорт

    // Подготовка
    Вектор = ВекторОкружения(ИмяВектора);
    КодОшибки = Неопределено;

    // Действие
    Попытка
        СтрокаОкружения = Новый СтрокаОкруженияЗапускаДвижка;
        СтрокаОкружения.Разобрать(Вектор.text, _Каталог);
    Исключение
        КодОшибки = ДиагностикаОшибок.КодОшибки(ИнформацияОбОшибке());
    КонецПопытки;

    // Проверка
    Ожидаем.Что(КодОшибки).Равно(КодыОшибокEngineConfig.НекорректнаяКонфигурация());

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗаписатьCFG(Текст)
    Путь = ОбъединитьПути(_Каталог, "oscript.cfg");
    Запись = Новый ЗаписьТекста(Путь, "UTF-8");
    Запись.Записать(Текст);
    Запись.Закрыть();
    Возврат Путь;
КонецФункции

Функция ВекторОкружения(Имя)

    Для Каждого Вектор Из _ВекторыОкружения Цикл
        Если Вектор.name = Имя Тогда
            Возврат Вектор;
        КонецЕсли;
    КонецЦикла;

    ВызватьИсключение "Не найден вектор: " + Имя;

КонецФункции

#КонецОбласти
