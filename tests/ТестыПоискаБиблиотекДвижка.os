#Использовать asserts
#Использовать errors
#Использовать tempfiles
#Использовать "../src"

Перем _ВременныеФайлы; // МенеджерВременныхФайлов
Перем _Каталог; // Строка
Перем _ИсходноеОкружение; // Строка, Неопределено
Перем _ИсходныйКаталог; // Строка

#Область ОбработчикиСобытий

// Использует общий временный каталог без изменения окружения и рабочего каталога процесса.
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередВсеми
Процедура ПередВсеми() Экспорт

    _ВременныеФайлы = Новый МенеджерВременныхФайлов;
    _ИсходныйКаталог = ТекущийКаталог();
    _Каталог = _ВременныеФайлы.СоздатьКаталог();
    УстановитьТекущийКаталог(_Каталог);
    _Каталог = ТекущийКаталог();
    УстановитьТекущийКаталог(_ИсходныйКаталог);

    _ИсходноеОкружение = ПолучитьПеременнуюСреды("OSCRIPT_CONFIG");

КонецПроцедуры

&ПослеВсех
Процедура ПослеВсех() Экспорт

    УстановитьПеременнуюСреды("OSCRIPT_CONFIG", _ИсходноеОкружение);
    УстановитьТекущийКаталог(_ИсходныйКаталог);

    Если _ВременныеФайлы <> Неопределено Тогда
        _ВременныеФайлы.Удалить();
    КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_ЗафиксироватьТекущийКаталогПриСпециализированнойУстановке() Экспорт

    // Подготовка
    ИсходныйКаталог = ТекущийКаталог();
    Конфигурация = Новый КонфигурацияИнтерпретатора;
    УстановитьТекущийКаталог(_Каталог);
    Конфигурация.УстановитьСистемныйКаталогБиблиотек("system");
    УстановитьТекущийКаталог(ИсходныйКаталог);

    // Действие
    Каталоги = Новый ЛокаторБиблиотекПоКонфигурации(Конфигурация).ПолучитьКаталогиПоиска();

    // Проверка
    Ожидаем.Что(Каталоги[0]).Равно(АбсолютныйПуть(_Каталог, "system"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазрешитьОтносительнуюБазуПриОбращенииКФайловойСистеме() Экспорт

    // Подготовка
    ИсходныйКаталог = ТекущийКаталог();
    БазовыйКаталог = "relative-base";
    Конфигурация = Новый КонфигурацияИнтерпретатора();
    Конфигурация.УстановитьБазовыйКаталог(БазовыйКаталог);
    Конфигурация.Установить("lib.system", "system");
    УстановитьТекущийКаталог(_Каталог);

    // Действие
    Каталоги = Новый ЛокаторБиблиотекПоКонфигурации(Конфигурация).ПолучитьКаталогиПоиска();
    УстановитьТекущийКаталог(ИсходныйКаталог);

    // Проверка
    Ожидаем.Что(Каталоги[0]).Равно(АбсолютныйПуть(_Каталог, ОбъединитьПути(БазовыйКаталог, "system")));

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазрешитьЯвнуюОтносительнуюБазуПриОбращенииКФайловойСистеме() Экспорт

    // Подготовка
    ИсходныйКаталог = ТекущийКаталог();
    БазовыйКаталог = "relative-base";
    Конфигурация = Новый КонфигурацияИнтерпретатора;
    Конфигурация.УстановитьСистемныйКаталогБиблиотек("system", БазовыйКаталог);
    УстановитьТекущийКаталог(_Каталог);

    // Действие
    Каталоги = Новый ЛокаторБиблиотекПоКонфигурации(Конфигурация).ПолучитьКаталогиПоиска();
    УстановитьТекущийКаталог(ИсходныйКаталог);

    // Проверка
    Ожидаем.Что(Каталоги[0]).Равно(АбсолютныйПуть(_Каталог, ОбъединитьПути(БазовыйКаталог, "system")));

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьПорядокУникальныхИОтсутствующихКаталогов() Экспорт

    // Подготовка
    База = ОбъединитьПути(_Каталог, "missing base");
    Абсолютный = ОбъединитьПути(_Каталог, "missing absolute");
    Конфигурация = Новый КонфигурацияИнтерпретатора();
    Конфигурация.УстановитьБазовыйКаталог(База);
    Дополнительные = " ; second ; ; " + Абсолютный + ";first;second; ";
    Конфигурация.Установить("LIB.ADDITIONAL", Дополнительные);
    Конфигурация.Установить("LiB.System", " ../system Ж値 ");

    // Действие
    Каталоги = Новый ЛокаторБиблиотекПоКонфигурации(Конфигурация).ПолучитьКаталогиПоиска();

    // Проверка
    Ожидаем.Что(ТипЗнч(Каталоги)).Равно(Тип("Массив"));
    Ожидаем.Что(СтрСоединить(Каталоги, ";")).Равно(
        АбсолютныйПуть(База, "second") + ";" + Абсолютный + ";" + АбсолютныйПуть(База, "first")
        + ";" + АбсолютныйПуть(База, "../system Ж値"));
    Ожидаем.Что(Конфигурация.ПолучитьЗначение("lib.additional")).Равно(Дополнительные);
    Ожидаем.Что(Конфигурация.ПолучитьЗначение("lib.system")).Равно(" ../system Ж値 ");
    Ожидаем.Что(Новый Файл(База).Существует()).Равно(Ложь);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьНезависимыйМассивКаталогов() Экспорт

    // Подготовка
    Конфигурация = Новый КонфигурацияИнтерпретатора();
    Конфигурация.УстановитьБазовыйКаталог(_Каталог);
    Конфигурация.Установить("lib.additional", "first;second");
    Конфигурация.Установить("lib.system", "system");
    Каталоги = Новый ЛокаторБиблиотекПоКонфигурации(Конфигурация).ПолучитьКаталогиПоиска();

    // Действие
    Каталоги.Очистить();
    ПовторныеКаталоги = Новый ЛокаторБиблиотекПоКонфигурации(Конфигурация).ПолучитьКаталогиПоиска();

    // Проверка
    Ожидаем.Что(ПовторныеКаталоги.Количество()).Равно(3);
    Ожидаем.Что(ПовторныеКаталоги[0]).Равно(АбсолютныйПуть(_Каталог, "first"));
    Ожидаем.Что(ПовторныеКаталоги[2]).Равно(АбсолютныйПуть(_Каталог, "system"));

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("")
&ИсточникЗначение(" ; ; ")
&ИсточникЗначение("additional")
Процедура ТестДолжен_НеВыдумыватьСистемныйКаталогПроизвольнойКонфигурации(Дополнительные) Экспорт

    // Подготовка
    Конфигурация = Новый КонфигурацияИнтерпретатора();
    Конфигурация.УстановитьБазовыйКаталог(_Каталог);
    Если Дополнительные <> "" Тогда
        Конфигурация.Установить("lib.additional", Дополнительные);
    КонецЕсли;

    // Действие
    Каталоги = Новый ЛокаторБиблиотекПоКонфигурации(Конфигурация).ПолучитьКаталогиПоиска();

    // Проверка
    Ожидаем.Что(Каталоги.Количество()).Равно(?(Дополнительные = "additional", 1, 0));
    Если Каталоги.Количество() = 1 Тогда
        Ожидаем.Что(Каталоги[0]).Равно(АбсолютныйПуть(_Каталог, "additional"));
    КонецЕсли;

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("system")
&ИсточникЗначение("")
Процедура ТестДолжен_ОбработатьЯвныйСистемныйКаталогБезКонтекста(Системный) Экспорт

    // Подготовка
    Конфигурация = Новый КонфигурацияИнтерпретатора();
    Конфигурация.УстановитьБазовыйКаталог(_Каталог);
    Конфигурация.Установить("lib.system", Системный);

    // Действие
    Каталоги = Новый ЛокаторБиблиотекПоКонфигурации(Конфигурация).ПолучитьКаталогиПоиска();

    // Проверка
    Ожидаем.Что(Каталоги.Количество()).Равно(?(ПустаяСтрока(Системный), 0, 1));
    Если Не ПустаяСтрока(Системный) Тогда
        Ожидаем.Что(Каталоги[0]).Равно(АбсолютныйПуть(_Каталог, Системный));
    КонецЕсли;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДобавитьСистемныйКаталогДвижкаПослеДополнительныхКаталоговКонтекста() Экспорт

    // Подготовка
    КаталогиКонтекста = СоздатьКаталогиКонтекста();
    Построитель = НовыйПостроитель(КаталогиКонтекста);
    Построитель.ДобавитьНастройкиОкружения(
        "lib.additional=first; lib.additional='first;second;first'",
        КаталогиКонтекста.Рабочий
    );
    Конфигурация = Построитель.Построить();

    // Действие
    Каталоги = Новый ЛокаторБиблиотекПоКонфигурации(Конфигурация).ПолучитьКаталогиПоиска();

    // Проверка
    База = КаталогиКонтекста.Рабочий;
    Ожидаем.Что(СтрСоединить(Каталоги, ";")).Равно(
        АбсолютныйПуть(База, "first") + ";" + АбсолютныйПуть(База, "second") + ";"
        + ОбъединитьПути(КаталогиКонтекста.Движок, "lib"));

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("system")
&ИсточникЗначение("entry")
&ИсточникЗначение("environment")
Процедура ТестДолжен_РазрешитьКаталогиОтБазыПобедившегоИсточника(Источник) Экспорт

    // Подготовка
    КаталогиКонтекста = СоздатьКаталогиКонтекста();
    Настройки = "lib.additional=first;second" + Символы.ПС + "lib.system=system";
    ЗаписатьТекст(ОбъединитьПути(КаталогиКонтекста.Движок, "bin", "oscript.cfg"), Настройки);
    База = ОбъединитьПути(КаталогиКонтекста.Движок, "bin");
    Если Источник <> "system" Тогда
        ЗаписатьТекст(ОбъединитьПути(КаталогиКонтекста.Вход, "oscript.cfg"), Настройки);
        База = КаталогиКонтекста.Вход;
    КонецЕсли;

    Построитель = НовыйПостроитель(КаталогиКонтекста);
    Если Источник = "environment" Тогда
        Построитель.ДобавитьНастройкиОкружения(
            "lib.additional='first;second';lib.system=system",
            КаталогиКонтекста.Рабочий
        );
        База = КаталогиКонтекста.Рабочий;
    КонецЕсли;

    Конфигурация = Построитель.Построить();

    // Действие
    Каталоги = Новый ЛокаторБиблиотекПоКонфигурации(Конфигурация).ПолучитьКаталогиПоиска();

    // Проверка
    Ожидаем.Что(СтрСоединить(Каталоги, ";")).Равно(АбсолютныйПуть(База, "first")
        + ";" + АбсолютныйПуть(База, "second") + ";" + АбсолютныйПуть(База, "system"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтключитьСистемныйКаталогДвижкаЯвноПустойНастройкой() Экспорт

    // Подготовка
    КаталогиКонтекста = СоздатьКаталогиКонтекста();
    Построитель = НовыйПостроитель(КаталогиКонтекста);
    Построитель.ДобавитьНастройкиОкружения("lib.system=''", КаталогиКонтекста.Рабочий);
    Конфигурация = Построитель.Построить();

    // Действие
    Каталоги = Новый ЛокаторБиблиотекПоКонфигурации(Конфигурация).ПолучитьКаталогиПоиска();

    // Проверка
    Ожидаем.Что(Каталоги.Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_УдалитьСистемнуюНастройкуБезСкрытогоВосстановления() Экспорт

    // Подготовка
    КаталогиКонтекста = СоздатьКаталогиКонтекста();
    Конфигурация = НовыйПостроитель(КаталогиКонтекста).Построить();
    Конфигурация.УстановитьБазовыйКаталог(КаталогиКонтекста.Рабочий);
    Конфигурация.Установить("lib.additional", "manual");
    Конфигурация.Установить("lib.system", "manual-system");

    // Действие
    ДоУдаления = Новый ЛокаторБиблиотекПоКонфигурации(Конфигурация).ПолучитьКаталогиПоиска();
    Конфигурация.Удалить("lib.system");
    ПослеУдаления = Новый ЛокаторБиблиотекПоКонфигурации(Конфигурация).ПолучитьКаталогиПоиска();

    // Проверка
    Дополнительный = АбсолютныйПуть(КаталогиКонтекста.Рабочий, "manual");
    Ожидаем.Что(СтрСоединить(ДоУдаления, ";")).Равно(Дополнительный
        + ";" + АбсолютныйПуть(КаталогиКонтекста.Рабочий, "manual-system"));
    Ожидаем.Что(СтрСоединить(ПослеУдаления, ";")).Равно(Дополнительный);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("first")
&ИсточникЗначение("second")
&ИсточникЗначение("system")
Процедура ТестДолжен_НайтиПервыйСуществующийКаталогБиблиотеки(ПервыйКаталог) Экспорт

    // Подготовка
    База = ОбъединитьПути(_Каталог, Строка(Новый УникальныйИдентификатор));
    Конфигурация = Новый КонфигурацияИнтерпретатора();
    Конфигурация.УстановитьБазовыйКаталог(База);
    Конфигурация.Установить("lib.additional", "missing;first;second;first");
    Конфигурация.Установить("lib.system", "system");
    Если ПервыйКаталог = "first" Тогда
        СоздатьКаталог(ОбъединитьПути(База, "first", "library"));
    КонецЕсли;

    Если ПервыйКаталог <> "system" Тогда
        СоздатьКаталог(ОбъединитьПути(База, "second", "library"));
    КонецЕсли;

    СоздатьКаталог(ОбъединитьПути(База, "system", "library"));

    // Действие
    НайденныйКаталог = Новый ЛокаторБиблиотекПоКонфигурации(Конфигурация).НайтиБиблиотеку("library");

    // Проверка
    Ожидаем.Что(НайденныйКаталог).Равно(ОбъединитьПути(База, ПервыйКаталог, "library"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПустойКаталогПередБиблиотекойСИсполняемымКодом() Экспорт

    // Подготовка
    База = ОбъединитьПути(_Каталог, "empty shadows valid");
    СоздатьКаталог(ОбъединитьПути(База, "first", "library"));
    СоздатьКаталог(ОбъединитьПути(База, "second", "library"));
    ЗаписатьТекст(ОбъединитьПути(База, "second", "library", "Module.os"), "// executable module");
    Конфигурация = Новый КонфигурацияИнтерпретатора();
    Конфигурация.УстановитьБазовыйКаталог(База);
    Конфигурация.Установить("lib.additional", "first;second");

    // Действие
    НайденныйКаталог = Новый ЛокаторБиблиотекПоКонфигурации(Конфигурация).НайтиБиблиотеку("library");

    // Проверка
    Ожидаем.Что(НайденныйКаталог).Равно(ОбъединитьПути(База, "first", "library"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропуститьФайлВместоКаталогаБиблиотеки() Экспорт

    // Подготовка
    База = ОбъединитьПути(_Каталог, "file before directory");
    СоздатьКаталог(ОбъединитьПути(База, "first"));
    ЗаписатьТекст(ОбъединитьПути(База, "first", "library"), "plain file");
    СоздатьКаталог(ОбъединитьПути(База, "system", "library"));
    Конфигурация = Новый КонфигурацияИнтерпретатора();
    Конфигурация.УстановитьБазовыйКаталог(База);
    Конфигурация.Установить("lib.additional", "first");
    Конфигурация.Установить("lib.system", "system");

    // Действие
    НайденныйКаталог = Новый ЛокаторБиблиотекПоКонфигурации(Конфигурация).НайтиБиблиотеку("library");

    // Проверка
    Ожидаем.Что(НайденныйКаталог).Равно(ОбъединитьПути(База, "system", "library"));

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("empty configuration")
&ИсточникЗначение("missing directory")
&ИсточникЗначение("script without directory")
Процедура ТестДолжен_ВернутьНеопределеноПриОтсутствииКаталогаБиблиотеки(Случай) Экспорт

    // Подготовка
    База = ОбъединитьПути(_Каталог, "absent library");
    СоздатьКаталог(База);
    Конфигурация = Новый КонфигурацияИнтерпретатора();
    Конфигурация.УстановитьБазовыйКаталог(База);
    Если Случай <> "empty configuration" Тогда
        Конфигурация.Установить("lib.system", База);
    КонецЕсли;

    Если Случай = "script without directory" Тогда
        ЗаписатьТекст(ОбъединитьПути(База, "absent.os"), "// standalone script");
    КонецЕсли;

    // Действие
    НайденныйКаталог = Новый ЛокаторБиблиотекПоКонфигурации(Конфигурация).НайтиБиблиотеку("absent");

    // Проверка
    Ожидаем.Что(НайденныйКаталог).Равно(Неопределено);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("foo.bar")
&ИсточникЗначение("Библиотека Ж値")
Процедура ТестДолжен_СохранитьОбычноеИмяБиблиотеки(Имя) Экспорт

    // Подготовка
    СоздатьКаталог(ОбъединитьПути(_Каталог, "ordinary names", Имя));
    Конфигурация = Новый КонфигурацияИнтерпретатора();
    Конфигурация.УстановитьБазовыйКаталог(_Каталог);
    Конфигурация.Установить("lib.system", "ordinary names");

    // Действие
    НайденныйКаталог = Новый ЛокаторБиблиотекПоКонфигурации(Конфигурация).НайтиБиблиотеку(Имя);

    // Проверка
    Ожидаем.Что(НайденныйКаталог).Равно(ОбъединитьПути(_Каталог, "ordinary names", Имя));

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиБиблиотекуВСистемномКаталогеДвижкаПриОтсутствииЯвнойНастройки() Экспорт

    // Подготовка
    КаталогиКонтекста = СоздатьКаталогиКонтекста();
    Библиотека = ОбъединитьПути(КаталогиКонтекста.Движок, "lib", "library");
    СоздатьКаталог(Библиотека);
    Конфигурация = НовыйПостроитель(КаталогиКонтекста).Построить();

    // Действие
    НайденныйКаталог = Новый ЛокаторБиблиотекПоКонфигурации(Конфигурация).НайтиБиблиотеку("library");

    // Проверка
    Ожидаем.Что(НайденныйКаталог).Равно(Библиотека);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеЗапускатьЛокальныйЗагрузчикСистемногоКаталогаИНеИзменятьСостояниеПроцесса() Экспорт

    // Подготовка
    База = ОбъединитьПути(_Каталог, "загрузчик");
    СоздатьКаталог(ОбъединитьПути(База, "library"));
    ТекстЗагрузчика = "ВызватьИсключение ""Загрузчик не должен запускаться"";";
    ЗаписатьТекст(ОбъединитьПути(База, "package-loader.os"), ТекстЗагрузчика);
    ЗаписатьТекст(ОбъединитьПути(База, "library", "package-loader.os"), ТекстЗагрузчика);
    Конфигурация = Новый КонфигурацияИнтерпретатора();
    Конфигурация.УстановитьБазовыйКаталог(_Каталог);
    Конфигурация.Установить("lib.system", "загрузчик");
    ИсходныеФайлы = СтрСоединить(НайтиФайлы(База, "*", Истина), ";");

    // Действие
    Каталоги = Новый ЛокаторБиблиотекПоКонфигурации(Конфигурация).ПолучитьКаталогиПоиска();
    НайденныйКаталог = Новый ЛокаторБиблиотекПоКонфигурации(Конфигурация).НайтиБиблиотеку("library");

    // Проверка
    Ожидаем.Что(Каталоги[0]).Равно(База);
    Ожидаем.Что(НайденныйКаталог).Равно(ОбъединитьПути(База, "library"));
    Ожидаем.Что(Конфигурация.ПолучитьЗначение("lib.system")).Равно("загрузчик");
    Ожидаем.Что(ПолучитьПеременнуюСреды("OSCRIPT_CONFIG")).Равно(_ИсходноеОкружение);
    Ожидаем.Что(ТекущийКаталог()).Равно(_ИсходныйКаталог);
    Ожидаем.Что(СтрСоединить(НайтиФайлы(База, "*", Истина), ";")).Равно(ИсходныеФайлы);
    Ожидаем.Что(ПрочитатьТекст(ОбъединитьПути(База, "package-loader.os"))).Содержит(ТекстЗагрузчика);
    Ожидаем.Что(ПрочитатьТекст(ОбъединитьПути(База, "library", "package-loader.os"))).Содержит(ТекстЗагрузчика);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("42", "argument.invalid_type")
&ИсточникЗначение("Истина", "argument.invalid_type")
&ИсточникЗначение("Неопределено", "argument.invalid_type")
&ИсточникЗначение("Новый Массив", "argument.invalid_type")
&ИсточникЗначение("""""", "argument.required")
&ИсточникЗначение("""   """, "argument.required")
&ИсточникЗначение(""" library""", "argument.invalid_value")
&ИсточникЗначение("""library """, "argument.invalid_value")
&ИсточникЗначение(""".""", "argument.invalid_value")
&ИсточникЗначение("""..""", "argument.invalid_value")
&ИсточникЗначение("""../library""", "argument.invalid_value")
&ИсточникЗначение("""parent\library""", "argument.invalid_value")
&ИсточникЗначение("""/rooted""", "argument.invalid_value")
&ИсточникЗначение("""C:rooted""", "argument.invalid_value")
Процедура ТестДолжен_ПроверитьАргументИмениБиблиотеки(Выражение, ОжидаемыйКод) Экспорт

    // Подготовка
    Конфигурация = Новый КонфигурацияИнтерпретатора();
    Конфигурация.УстановитьБазовыйКаталог(_Каталог);
    Локатор = Новый ЛокаторБиблиотекПоКонфигурации(Конфигурация);
    Имя = Вычислить(Выражение);
    Ошибка = Неопределено;

    // Действие
    Попытка
        Локатор.НайтиБиблиотеку(Имя);
    Исключение
        Ошибка = ИнформацияОбОшибке();
    КонецПопытки;

    // Проверка
    Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно(ОжидаемыйКод);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция АбсолютныйПуть(База, Путь)
    Возврат Новый Файл(ОбъединитьПути(База, Путь)).ПолноеИмя;
КонецФункции

Функция СоздатьКаталогиКонтекста()

    База = ОбъединитьПути(_Каталог, Строка(Новый УникальныйИдентификатор));
    Каталоги = Новый Структура(
        "Движок,Вход,Рабочий",
        ОбъединитьПути(База, "engine"),
        ОбъединитьПути(База, "entry"),
        ОбъединитьПути(База, "cwd")
    );
   
    СоздатьКаталог(ОбъединитьПути(Каталоги.Движок, "bin"));
    СоздатьКаталог(ОбъединитьПути(Каталоги.Движок, "lib"));
    СоздатьКаталог(Каталоги.Вход);
    СоздатьКаталог(Каталоги.Рабочий);

    Возврат Каталоги;

КонецФункции

Функция НовыйПостроитель(Каталоги)
    Построитель = Новый ПостроительКонфигурацииИнтерпретатора;
    Построитель.ДобавитьНастройкиОкружения(
        "lib.system=" + ОбъединитьПути(Каталоги.Движок, "lib"),
        Каталоги.Рабочий
    );

    СистемныйCFG = ОбъединитьПути(Каталоги.Движок, "bin", "oscript.cfg");
    Если Новый Файл(СистемныйCFG).Существует() Тогда
        Построитель.ДобавитьФайлКонфигурации(СистемныйCFG);
    КонецЕсли;

    ВходнойCFG = ОбъединитьПути(Каталоги.Вход, "oscript.cfg");
    Если Новый Файл(ВходнойCFG).Существует() Тогда
        Построитель.ДобавитьФайлКонфигурации(ВходнойCFG);
    КонецЕсли;

    Возврат Построитель;
КонецФункции

Процедура ЗаписатьТекст(Путь, Текст)
    Документ = Новый ТекстовыйДокумент;
    Документ.УстановитьТекст(Текст);
    Документ.Записать(Путь);
КонецПроцедуры

Функция ПрочитатьТекст(Путь)
    Документ = Новый ТекстовыйДокумент;
    Документ.Прочитать(Путь);
    Возврат Документ.ПолучитьТекст();
КонецФункции

#КонецОбласти
