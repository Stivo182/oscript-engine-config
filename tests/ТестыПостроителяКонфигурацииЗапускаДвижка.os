#Использовать asserts
#Использовать errors
#Использовать tempfiles
#Использовать "../src"
#Использовать "../src/internal"

Перем _ВременныеФайлы; // МенеджерВременныхФайлов
Перем _Каталог; // Строка
Перем _КаталогДвижка; // Строка
Перем _КаталогТочкиВхода; // Строка
Перем _ТочкаВхода; // Строка
Перем _РабочийКаталог; // Строка
Перем _ИсходноеОкружение; // Строка, Неопределено
Перем _ИсходныйКаталог; // Строка

#Область ОбработчикиСобытий

// Сохраняет окружение и удаляет отдельный временный каталог после каждого теста.
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередВсеми
Процедура ПередВсеми() Экспорт
    _ВременныеФайлы = Новый МенеджерВременныхФайлов;
КонецПроцедуры

&ПередКаждым
Процедура ПередКаждым() Экспорт

    _ИсходноеОкружение = ПолучитьПеременнуюСреды("OSCRIPT_CONFIG");
    _ИсходныйКаталог = ТекущийКаталог();
    _Каталог = _ВременныеФайлы.СоздатьКаталог();
    _КаталогДвижка = ОбъединитьПути(_Каталог, "engine");
    _КаталогТочкиВхода = ОбъединитьПути(_Каталог, "entry");
    _ТочкаВхода = ОбъединитьПути(_КаталогТочкиВхода, "main.os");
    _РабочийКаталог = ОбъединитьПути(_Каталог, "cwd");

    СоздатьКаталог(ОбъединитьПути(_КаталогДвижка, "bin"));
    СоздатьКаталог(ОбъединитьПути(_КаталогДвижка, "lib"));
    СоздатьКаталог(_КаталогТочкиВхода);
    СоздатьКаталог(_РабочийКаталог);

    ЗаписатьТекст(_ТочкаВхода, "// entrypoint");

КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт

    УстановитьПеременнуюСреды("OSCRIPT_CONFIG", _ИсходноеОкружение);
    УстановитьТекущийКаталог(_ИсходныйКаталог);

    Ожидаем.Что(ПолучитьПеременнуюСреды("OSCRIPT_CONFIG")).Равно(_ИсходноеОкружение);
    Ожидаем.Что(ТекущийКаталог()).Равно(_ИсходныйКаталог);

    _ВременныеФайлы.Удалить();

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_ПрименитьСистемныйCFGЗатемCFGТочкиВходаЗатемОкружение() Экспорт

    // Подготовка
    ЗаписатьСистемныйCFG("OnlySystem=system" + Символы.ПС + "Shared=system" + Символы.ПС + "EntryWins=system");
    ЗаписатьВходнойCFG("OnlyEntry=entry" + Символы.ПС + "SHARED=entry" + Символы.ПС + "entrywins=entry");
    Построитель = НовыйПостроитель();
    Построитель.УстановитьНастройкиОкружения("shared=env;OnlyEnv=env");

    // Действие
    Конфигурация = Построитель.Построить();

    // Проверка
    Ожидаем.Что(Конфигурация.Получить("onlysystem")).Равно("system");
    Ожидаем.Что(Конфигурация.Получить("onlyentry")).Равно("entry");
    Ожидаем.Что(Конфигурация.Получить("onlyenv")).Равно("env");
    Ожидаем.Что(Конфигурация.Получить("SHARED")).Равно("env");
    Ожидаем.Что(Конфигурация.Получить("ENTRYWINS")).Равно("entry");
    Ожидаем.Что(Конфигурация.Получить("lib.system")).Равно(ОбъединитьПути(_КаталогДвижка, "lib"));
    Ожидаем.Что(Конфигурация.Ключи().Количество()).Равно(6);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("CFG")
&ИсточникЗначение("ENV")
Процедура ТестДолжен_ПерекрытьЗначениеЯвноПустойСтрокой(Источник) Экспорт

    // Подготовка
    ЗаписатьСистемныйCFG("empty=system");
    Построитель = НовыйПостроитель();

    Если Источник = "CFG" Тогда
        ЗаписатьВходнойCFG("empty=");
    Иначе
        Построитель.УстановитьНастройкиОкружения("empty=");
    КонецЕсли;

    // Действие
    Конфигурация = Построитель.Построить();

    // Проверка
    Ожидаем.Что(Конфигурация.Получить("empty")).Равно("");
    Ожидаем.Что(Конфигурация.Получить("missing")).Равно(Неопределено);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Отключено")
&ИсточникЗначение("ЯвноеПустое")
Процедура ТестДолжен_НеЧитатьТекущееОкружениеПриДругомРежиме(Режим) Экспорт

    // Подготовка
    УстановитьПеременнуюСреды("OSCRIPT_CONFIG", "shared=current");
    ЗаписатьВходнойCFG("shared=entry");
    Построитель = НовыйПостроитель();

    Если Режим = "Отключено" Тогда
        Построитель.ИспользоватьНастройкиОкружения(Ложь);
    Иначе
        Построитель.УстановитьНастройкиОкружения("");
    КонецЕсли;

    // Действие
    Конфигурация = Построитель.Построить();

    // Проверка
    Ожидаем.Что(Конфигурация.Получить("shared")).Равно("entry");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЧитатьТекущееОкружениеВМоментКаждогоРасчета() Экспорт

    // Подготовка
    УстановитьПеременнуюСреды("OSCRIPT_CONFIG", "shared=before");
    Построитель = Новый ПостроительКонфигурацииЗапускаДвижка;
    Построитель.УстановитьТочкуВхода(_ТочкаВхода);
    Построитель.УстановитьКаталогДвижка(_КаталогДвижка);
    УстановитьПеременнуюСреды("OSCRIPT_CONFIG", "shared=first");

    // Действие
    Первая = Построитель.Построить();
    УстановитьПеременнуюСреды("OSCRIPT_CONFIG", "shared=second");
    Вторая = Построитель.Построить();

    // Проверка
    Ожидаем.Что(Первая.Получить("shared")).Равно("first");
    Ожидаем.Что(Вторая.Получить("shared")).Равно("second");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Явное", "explicit")
&ИсточникЗначение("Текущее", "current")
&ИсточникЗначение("Отключено", "entry")
Процедура ТестДолжен_ПрименитьПоследнийВызовРежимаОкружения(ПоследнийРежим, Значение) Экспорт

    // Подготовка
    УстановитьПеременнуюСреды("OSCRIPT_CONFIG", "shared=current");
    ЗаписатьВходнойCFG("shared=entry");
    Построитель = НовыйПостроитель();

    Если ПоследнийРежим = "Явное" Тогда
        Построитель.ИспользоватьНастройкиОкружения(Ложь);
        Построитель.УстановитьНастройкиОкружения("shared=explicit");
    Иначе
        Построитель.УстановитьНастройкиОкружения("shared=explicit");
        Построитель.ИспользоватьНастройкиОкружения(ПоследнийРежим = "Текущее");
    КонецЕсли;

    // Действие
    Конфигурация = Построитель.Построить();

    // Проверка
    Ожидаем.Что(Конфигурация.Получить("shared")).Равно(Значение);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Отсутствует")
&ИсточникЗначение("Пустое")
Процедура ТестДолжен_ПропуститьОтсутствующееИПустоеОкружение(Режим) Экспорт

    // Подготовка
    УстановитьПеременнуюСреды("OSCRIPT_CONFIG", ?(Режим = "Отсутствует", Неопределено, ""));
    Построитель = Новый ПостроительКонфигурацииЗапускаДвижка;
    Построитель.УстановитьТочкуВхода(_ТочкаВхода);
    Построитель.УстановитьКаталогДвижка(_КаталогДвижка);

    // Действие
    Конфигурация = Построитель.Построить();

    // Проверка
    Ожидаем.Что(Конфигурация.Ключи().Количество()).Равно(1);
    Ожидаем.Что(Конфигурация.Получить("lib.system")).Равно(ОбъединитьПути(_КаталогДвижка, "lib"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИскатьCFGВнутриКаталогаТочкиВхода() Экспорт

    // Подготовка
    ЗаписатьВходнойCFG("entry=directory");
    Построитель = Новый ПостроительКонфигурацииЗапускаДвижка;
    Построитель.УстановитьТочкуВхода(_КаталогТочкиВхода);
    Построитель.УстановитьКаталогДвижка(_КаталогДвижка);
    Построитель.ИспользоватьНастройкиОкружения(Ложь);

    // Действие
    Конфигурация = Построитель.Построить();

    // Проверка
    Ожидаем.Что(Конфигурация.Получить("entry")).Равно("directory");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеИскатьCFGВРодителяхРабочемИДочернемКаталогах() Экспорт

    // Подготовка
    ЗаписатьТекст(ОбъединитьПути(_Каталог, "oscript.cfg"), "parent=forbidden");
    ЗаписатьТекст(ОбъединитьПути(_РабочийКаталог, "oscript.cfg"), "cwd=forbidden");
    ДочернийКаталог = ОбъединитьПути(_КаталогТочкиВхода, "child");
    СоздатьКаталог(ДочернийКаталог);
    ЗаписатьТекст(ОбъединитьПути(ДочернийКаталог, "oscript.cfg"), "child=forbidden");
    Построитель = НовыйПостроитель();

    // Действие
    Конфигурация = Построитель.Построить();

    // Проверка
    Ожидаем.Что(Конфигурация.Ключи().Количество()).Равно(1);
    Ожидаем.Что(Конфигурация.Получить("lib.system")).Равно(ОбъединитьПути(_КаталогДвижка, "lib"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеМенятьТекущийКаталогОкружениеИФайлыПриРасчете() Экспорт

    // Подготовка
    ЗаписатьСистемныйCFG("system=value");
    ЗаписатьВходнойCFG("entry=value");
    УстановитьПеременнуюСреды("OSCRIPT_CONFIG", "environment=value");
    Построитель = НовыйПостроитель();
    Построитель.ИспользоватьНастройкиОкружения(Истина);
    ПутьСистемногоCFG = ОбъединитьПути(_КаталогДвижка, "bin", "oscript.cfg");
    ПутьВходногоCFG = ОбъединитьПути(_КаталогТочкиВхода, "oscript.cfg");
    СистемныйCFGДо = Base64Строка(Новый ДвоичныеДанные(ПутьСистемногоCFG));
    ВходнойCFGДо = Base64Строка(Новый ДвоичныеДанные(ПутьВходногоCFG));

    // Действие
    Построитель.Построить();

    // Проверка
    Ожидаем.Что(ТекущийКаталог()).Равно(_ИсходныйКаталог);
    Ожидаем.Что(ПолучитьПеременнуюСреды("OSCRIPT_CONFIG")).Равно("environment=value");
    Ожидаем.Что(Base64Строка(Новый ДвоичныеДанные(ПутьСистемногоCFG))).Равно(СистемныйCFGДо);
    Ожидаем.Что(Base64Строка(Новый ДвоичныеДанные(ПутьВходногоCFG))).Равно(ВходнойCFGДо);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПостроитьБезТочкиВхода() Экспорт

    // Подготовка
    ЗаписатьСистемныйCFG("system=value");
    ЗаписатьВходнойCFG("entry=value");
    Ошибка = Неопределено;
    Конфигурация = Неопределено;

    // Действие
    Попытка
        Построитель = Новый ПостроительКонфигурацииЗапускаДвижка;
        Построитель.УстановитьТочкуВхода(Неопределено);
        Построитель.УстановитьКаталогДвижка(_КаталогДвижка);
        Построитель.УстановитьРабочийКаталог(_КаталогТочкиВхода);
        Построитель.УстановитьНастройкиОкружения("environment=value");
        Конфигурация = Построитель.Построить();
    Исключение
        Ошибка = ИнформацияОбОшибке();
    КонецПопытки;

    // Проверка
    Ожидаем.Что(Ошибка).Равно(Неопределено);
    Ожидаем.Что(Конфигурация.Получить("system")).Равно("value");
    Ожидаем.Что(Конфигурация.Получить("environment")).Равно("value");
    Ожидаем.Что(Конфигурация.Получить("entry")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеИспользоватьНастройкиТекущегоЗапускаПослеОтключения() Экспорт

    // Подготовка
    УстановитьПеременнуюСреды("OSCRIPT_CONFIG", "environment=value");
    Построитель = Новый ПостроительКонфигурацииЗапускаДвижка;

    // Действие
    НастроенныйПостроитель = Построитель.ИспользоватьНастройкиТекущегоЗапуска(Ложь);
    Конфигурация = НастроенныйПостроитель.Построить();

    // Проверка
    Ожидаем.Что(НастроенныйПостроитель = Построитель).Равно(Истина);
    Ожидаем.Что(Конфигурация.Ключи().Количество()).Равно(0);
    Ожидаем.Что(Конфигурация.ПолучитьКаталогиПоискаБиблиотек().Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИспользоватьКаталогСтартовогоСценарияПоУмолчанию() Экспорт

    // Действие
    Результат = ВыполнитьДочернийСценарий(Ложь);

    // Проверка
    Ожидаем.Что(Результат).Равно("value");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеИспользоватьКаталогСтартовогоСценарияПослеОтключения() Экспорт

    // Действие
    Результат = ВыполнитьДочернийСценарий(Истина);

    // Проверка
    Ожидаем.Что(Результат).Равно("<Неопределено>");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИспользоватьЯвныеНастройкиПриОтключенномТекущемЗапуске() Экспорт

    // Подготовка
    ЗаписатьСистемныйCFG("system=value");
    ЗаписатьВходнойCFG("entry=value");
    УстановитьПеременнуюСреды("OSCRIPT_CONFIG", "current=forbidden");
    Построитель = Новый ПостроительКонфигурацииЗапускаДвижка;
    Построитель.УстановитьКаталогДвижка(_КаталогДвижка);
    Построитель.УстановитьТочкуВхода(_ТочкаВхода);
    Построитель.УстановитьНастройкиОкружения("environment=value");

    // Действие
    Конфигурация = Построитель
        .ИспользоватьНастройкиТекущегоЗапуска(Ложь)
        .Построить();

    // Проверка
    Ожидаем.Что(Конфигурация.Получить("system")).Равно("value");
    Ожидаем.Что(Конфигурация.Получить("entry")).Равно("value");
    Ожидаем.Что(Конфигурация.Получить("environment")).Равно("value");
    Ожидаем.Что(Конфигурация.Получить("current")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НастроитьПостроительЦепочкой() Экспорт

    // Подготовка
    ЗаписатьВходнойCFG("entry=value");
    Построитель = Новый ПостроительКонфигурацииЗапускаДвижка;

    // Действие
    НастроенныйПостроитель = Построитель
        .УстановитьТочкуВхода(_ТочкаВхода)
        .УстановитьРабочийКаталог(_РабочийКаталог)
        .УстановитьКаталогДвижка(_КаталогДвижка)
        .ИспользоватьНастройкиОкружения(Ложь)
        .УстановитьНастройкиОкружения("environment=value");
    Конфигурация = НастроенныйПостроитель.Построить();

    // Проверка
    Ожидаем.Что(НастроенныйПостроитель = Построитель).Равно(Истина);
    Ожидаем.Что(Конфигурация.Получить("entry")).Равно("value");
    Ожидаем.Что(Конфигурация.Получить("environment")).Равно("value");

КонецПроцедуры

