#Область ПрограммныйИнтерфейс

// Возвращает код ошибки расчета конфигурации.
//
// Возвращаемое значение:
//  Строка - Код ошибки.
Функция РасчетКонфигурацииНеВыполнен() Экспорт
    Возврат "configraph.calculate_failed";
КонецФункции

// Возвращает код ошибки записи конфигурации.
//
// Возвращаемое значение:
//  Строка - Код ошибки.
Функция ЗаписьКонфигурацииНеВыполнена() Экспорт
    Возврат "configraph.write_failed";
КонецФункции

// Возвращает код ошибки установки настроек окружения.
//
// Возвращаемое значение:
//  Строка - Код ошибки.
Функция УстановкаОкруженияНеВыполнена() Экспорт
    Возврат "configraph.environment_failed";
КонецФункции

// Возвращает код ошибки разрешения пути.
//
// Возвращаемое значение:
//  Строка - Код ошибки.
Функция ПутьНеРазрешен() Экспорт
    Возврат "configraph.path_unresolved";
КонецФункции

// Возвращает код некорректной конфигурации.
//
// Возвращаемое значение:
//  Строка - Код ошибки.
Функция НекорректнаяКонфигурация() Экспорт
    Возврат "configraph.invalid_configuration";
КонецФункции

#КонецОбласти
