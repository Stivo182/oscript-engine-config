#Область ПрограммныйИнтерфейс

// Создает конфигурацию из системного CFG, CFG стартового сценария и текущего OSCRIPT_CONFIG.
//
// Исключения:
//  engine_config.calculate_failed - Не удалось прочитать, разобрать или объединить источники.
//
// Возвращаемое значение:
//  КонфигурацияЗапускаДвижка - Новая изменяемая конфигурация текущего запуска.
Функция СоздатьДляТекущегоЗапуска() Экспорт

    Возврат Новый ПостроительКонфигурацииЗапускаДвижка()
        .ДобавитьИсточникиТекущегоЗапуска()
        .Построить();

КонецФункции

// Создает конфигурацию из обязательного CFG-файла.
//
// Параметры:
//  Путь - Строка - Путь к CFG-файлу.
//
// Исключения:
//  argument.invalid_type - Путь имеет неверный тип.
//  argument.required - Путь пуст или состоит из пробелов.
//  engine_config.calculate_failed - Не удалось прочитать или разобрать файл.
//
// Возвращаемое значение:
//  КонфигурацияЗапускаДвижка - Новая изменяемая конфигурация из файла.
Функция СоздатьИзФайла(Путь) Экспорт

    Возврат Новый ПостроительКонфигурацииЗапускаДвижка()
        .ДобавитьФайлКонфигурации(Путь)
        .Построить();

КонецФункции

// Создает конфигурацию из текущего OSCRIPT_CONFIG.
//
// Параметры:
//  РабочийКаталог - Строка, Неопределено - Существующий каталог, относительно которого разрешаются пути;
//                   Неопределено использует текущий каталог.
//
// Исключения:
//  argument.invalid_type - РабочийКаталог имеет неверный тип.
//  argument.required - РабочийКаталог пуст или состоит из пробелов.
//  argument.invalid_value - РабочийКаталог не существует или не является каталогом.
//  engine_config.calculate_failed - Не удалось разобрать настройки окружения.
//
// Возвращаемое значение:
//  КонфигурацияЗапускаДвижка - Новая изменяемая конфигурация из текущего окружения.
Функция СоздатьИзТекущегоОкружения(РабочийКаталог = Неопределено) Экспорт

    Возврат Новый ПостроительКонфигурацииЗапускаДвижка()
        .ДобавитьТекущееОкружение(РабочийКаталог)
        .Построить();

КонецФункции

// Создает конфигурацию из явно заданных настроек OSCRIPT_CONFIG.
//
// Параметры:
//  СтрокаНастроек - Строка - Настройки по грамматике OSCRIPT_CONFIG, включая пустую строку.
//  РабочийКаталог - Строка, Неопределено - Существующий каталог, относительно которого разрешаются пути;
//                   Неопределено использует текущий каталог.
//
// Исключения:
//  argument.invalid_type - СтрокаНастроек или РабочийКаталог имеет неверный тип.
//  argument.required - РабочийКаталог пуст или состоит из пробелов.
//  argument.invalid_value - РабочийКаталог не существует или не является каталогом.
//  engine_config.calculate_failed - Не удалось разобрать настройки окружения.
//
// Возвращаемое значение:
//  КонфигурацияЗапускаДвижка - Новая изменяемая конфигурация из переданных настроек.
Функция СоздатьИзНастроекОкружения(СтрокаНастроек, РабочийКаталог = Неопределено) Экспорт

    Возврат Новый ПостроительКонфигурацииЗапускаДвижка()
        .ДобавитьНастройкиОкружения(СтрокаНастроек, РабочийКаталог)
        .Построить();

КонецФункции

#КонецОбласти
