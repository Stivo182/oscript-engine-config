#Использовать errors
#Использовать "../internal"

Перем _СистемныйКаталог; // Строка, Неопределено
Перем _ДополнительныеКаталоги; // Массив из Строка

#Область ОбработчикиСобытий

// Создает неизменяемый снимок разрешенных каталогов библиотек.
//
// Параметры:
//  Конфигурация - КонфигурацияЗапускаДвижка - Исходная конфигурация запуска.
Процедура ПриСозданииОбъекта(Конфигурация)

    ПроверкаАргументов.ПроверитьТип(
        "Конфигурация",
        Конфигурация,
        Тип("КонфигурацияЗапускаДвижка")
    );

    _СистемныйКаталог = Неопределено;
    _ДополнительныеКаталоги = Новый Массив;

    Системная = Конфигурация.ПолучитьНастройку("lib.system");
    Если Системная <> Неопределено Тогда
        _СистемныйКаталог = СервисыКонфигурацииЗапускаДвижка.АбсолютноеЗначениеНастройки(Системная);
    КонецЕсли;

    Дополнительные = Конфигурация.ПолучитьНастройку("lib.additional");
    Если Дополнительные <> Неопределено Тогда
        АбсолютныеПути = СервисыКонфигурацииЗапускаДвижка.АбсолютноеЗначениеНастройки(Дополнительные);
        Если Не ПустаяСтрока(АбсолютныеПути) Тогда
            _ДополнительныеКаталоги = СтрРазделить(АбсолютныеПути, ";", Ложь);
        КонецЕсли;
    КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает разрешенный системный каталог библиотек.
//
// Возвращаемое значение:
//  Строка, Неопределено - Абсолютный путь или Неопределено, если настройка отсутствует.
Функция ПолучитьСистемныйКаталог() Экспорт
    Возврат _СистемныйКаталог;
КонецФункции

// Возвращает разрешенные дополнительные каталоги библиотек.
//
// Возвращаемое значение:
//  Массив из Строка - Независимый массив абсолютных путей.
Функция ПолучитьДополнительныеКаталоги() Экспорт
    Возврат КопияМассива(_ДополнительныеКаталоги);
КонецФункции

// Возвращает уникальные каталоги поиска: дополнительные по порядку, затем системный.
//
// Возвращаемое значение:
//  Массив из Строка - Независимый массив абсолютных путей.
Функция ПолучитьКаталогиПоиска() Экспорт

    Каталоги = Новый Массив;
    Для Каждого Каталог Из _ДополнительныеКаталоги Цикл
        Если Каталоги.Найти(Каталог) = Неопределено Тогда
            Каталоги.Добавить(Каталог);
        КонецЕсли;
    КонецЦикла;

    Если _СистемныйКаталог <> Неопределено И Каталоги.Найти(_СистемныйКаталог) = Неопределено Тогда
        Каталоги.Добавить(_СистемныйКаталог);
    КонецЕсли;

    Возврат Каталоги;

КонецФункции

// Возвращает первый существующий каталог библиотеки без проверки кода и запуска загрузчика.
//
// Параметры:
//  Имя - Строка - Непустое имя без крайних пробелов, разделителей пути, двоеточия и точных . или ..
//
// Возвращаемое значение:
//  Строка, Неопределено - Абсолютный путь к первому каталогу или Неопределено.
Функция НайтиБиблиотеку(Имя) Экспорт

    ПроверкаАргументов.ПроверитьТип("Имя", Имя, "Строка");
    ПроверкаАргументов.ПроверитьЗаполненность("Имя", СокрЛП(Имя));
    ПроверкаАргументов.ПроверитьДопустимость(
        "Имя",
        ЭтоДопустимоеИмяБиблиотеки(Имя),
        "Имя библиотеки без пути и крайних пробелов"
    );

    Для Каждого Каталог Из ПолучитьКаталогиПоиска() Цикл
        Библиотека = Новый Файл(ОбъединитьПути(Каталог, Имя));
        Если Библиотека.Существует() И Библиотека.ЭтоКаталог() Тогда
            Возврат Библиотека.ПолноеИмя;
        КонецЕсли;
    КонецЦикла;

    Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КопияМассива(Источник)

    Результат = Новый Массив;
    Для Каждого Элемент Из Источник Цикл
        Результат.Добавить(Элемент);
    КонецЦикла;

    Возврат Результат;

КонецФункции

Функция ЭтоДопустимоеИмяБиблиотеки(Имя)

    Возврат Имя = СокрЛП(Имя)
        И Имя <> "."
        И Имя <> ".."
        И Найти(Имя, "/") = 0
        И Найти(Имя, "\") = 0
        И Найти(Имя, ":") = 0;

КонецФункции

#КонецОбласти
