#Использовать errors
#Использовать "../internal"

Перем _Источники; // Массив из Объект

#Область ОбработчикиСобытий

// Создает пустой построитель без неявных источников.
Процедура ПриСозданииОбъекта()
    _Источники = Новый Массив;
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Добавляет CFG-файл в конец списка источников.
// Относительный путь фиксируется полным в момент вызова.
//
// Параметры:
//  Путь - Строка - Путь к CFG-файлу.
//  Обязательный - Булево - Вызывать ошибку при отсутствии файла.
//
// Возвращаемое значение:
//  ПостроительКонфигурацииЗапускаДвижка - Этот объект.
Функция ДобавитьФайлКонфигурации(Путь, Обязательный = Истина) Экспорт

    ПроверкаАргументов.ПроверитьТип("Путь", Путь, Тип("Строка"));
    ПроверкаАргументов.ПроверитьЗаполненность("Путь", СокрЛП(Путь));

    _Источники.Добавить(Новый ИсточникФайлаКонфигурацииЗапускаДвижка(
        Новый Файл(Путь).ПолноеИмя,
        Обязательный
    ));

    Возврат ЭтотОбъект;

КонецФункции

// Добавляет явно заданную строку OSCRIPT_CONFIG в конец списка источников.
//
// Параметры:
//  СтрокаНастроек - Строка - Настройки по грамматике OSCRIPT_CONFIG, включая пустую строку.
//  РабочийКаталог - Строка, Неопределено - Существующий каталог, относительно которого разрешаются пути;
//                   Неопределено использует текущий каталог при построении.
//
// Возвращаемое значение:
//  ПостроительКонфигурацииЗапускаДвижка - Этот объект.
Функция ДобавитьНастройкиОкружения(СтрокаНастроек, РабочийКаталог = Неопределено) Экспорт

    ПроверкаАргументов.ПроверитьТип("СтрокаНастроек", СтрокаНастроек, Тип("Строка"));
    База = ПроверитьРабочийКаталог(РабочийКаталог);

    _Источники.Добавить(Новый ИсточникНастроекОкруженияЗапускаДвижка(СтрокаНастроек, База));

    Возврат ЭтотОбъект;

КонецФункции

// Добавляет текущее OSCRIPT_CONFIG, перечитываемое при каждом построении.
//
// Параметры:
//  РабочийКаталог - Строка, Неопределено - Существующий каталог, относительно которого разрешаются пути;
//                   Неопределено использует текущий каталог при построении.
//
// Возвращаемое значение:
//  ПостроительКонфигурацииЗапускаДвижка - Этот объект.
Функция ДобавитьТекущееОкружение(РабочийКаталог = Неопределено) Экспорт

    База = ПроверитьРабочийКаталог(РабочийКаталог);

    _Источники.Добавить(Новый ИсточникТекущегоОкруженияЗапускаДвижка(База));

    Возврат ЭтотОбъект;

КонецФункции

// Добавляет системный CFG, CFG стартового сценария и текущее OSCRIPT_CONFIG.
// Автоматические CFG необязательны, а окружение и его база читаются при каждом построении.
//
// Возвращаемое значение:
//  ПостроительКонфигурацииЗапускаДвижка - Этот объект.
Функция ДобавитьИсточникиТекущегоЗапуска() Экспорт

    КаталогДвижка = Новый Файл(ОбъединитьПути(КаталогПрограммы(), "..")).ПолноеИмя;

    ДобавитьФайлКонфигурации(ОбъединитьПути(КаталогДвижка, "bin", "oscript.cfg"), Ложь);
    ДобавитьФайлКонфигурации(ОбъединитьПути(СтартовыйСценарий().Каталог, "oscript.cfg"), Ложь);
    ДобавитьТекущееОкружение();

    Возврат ЭтотОбъект;

КонецФункции

// Строит независимую конфигурацию из добавленных источников в порядке их добавления.
//
// Возвращаемое значение:
//  КонфигурацияЗапускаДвижка - Новая изменяемая конфигурация с базами источников.
Функция Построить() Экспорт

    Попытка
        НастройкиИсточников = СервисыКонфигурацииЗапускаДвижка.НоваяТаблицаНастроек();

        Для Каждого Источник Из _Источники Цикл
            СлитьИсточник(НастройкиИсточников, Источник.ПолучитьНастройки());
        КонецЦикла;

        Возврат СоздатьКонфигурацию(НастройкиИсточников);
    Исключение
        ВызватьИсключение ФабрикаОшибок.Обернуть(
            ИнформацияОбОшибке(),
            КодыОшибокEngineConfig.РасчетКонфигурацииНеВыполнен(),
            "Не удалось рассчитать конфигурацию движка."
        );
    КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПроверитьРабочийКаталог(РабочийКаталог)

    ПроверкаАргументов.ПроверитьТип("РабочийКаталог", РабочийКаталог, "Строка,Неопределено");

    Если РабочийКаталог = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;

    ПроверкаАргументов.ПроверитьЗаполненность("РабочийКаталог", СокрЛП(РабочийКаталог));

    ФайлКаталога = Новый Файл(РабочийКаталог);

    ПроверкаАргументов.ПроверитьДопустимость(
        "РабочийКаталог",
        ФайлКаталога.Существует() И ФайлКаталога.ЭтоКаталог(),
        "Существующий каталог"
    );

    Возврат ФайлКаталога.ПолноеИмя;

КонецФункции

Функция СоздатьКонфигурацию(НастройкиИсточников)

    Конфигурация = Новый КонфигурацияЗапускаДвижка;

    Для Каждого Настройка Из НастройкиИсточников Цикл
        ПрименитьНастройку(Конфигурация, Настройка);
    КонецЦикла;

    Возврат Конфигурация;

КонецФункции

Процедура ПрименитьНастройку(Конфигурация, Настройка)

    Если Настройка.НормализованныйКлюч = "lib.system" Тогда
        Конфигурация.УстановитьСистемныйКаталогБиблиотек(Настройка.Значение, Настройка.База);
        Возврат;
    КонецЕсли;

    Если Настройка.НормализованныйКлюч = "lib.additional" Тогда
        Каталоги = СтрРазделить(Настройка.Значение, ";", Ложь);
        Конфигурация.УстановитьДополнительныеКаталогиБиблиотек(Каталоги, Настройка.База);
        Возврат;
    КонецЕсли;

    Конфигурация.Установить(Настройка.Ключ, Настройка.Значение);

КонецПроцедуры

Процедура СлитьИсточник(Цель, Источник)

    Для Каждого Настройка Из Источник Цикл
        ПроверкаАргументов.ПроверитьТип("Ключ", Настройка.Ключ, "Строка");

        Если ПустаяСтрока(Настройка.Ключ) Тогда
            ВызватьИсключение ФабрикаОшибок.Создать(
                КодыОшибокEngineConfig.НекорректнаяКонфигурация(),
                "Пустой ключ конфигурации."
            );
        КонецЕсли;

        ПроверкаАргументов.ПроверитьТип("Значение", Настройка.Значение, "Строка");

        НастройкаЦели = Цель.Найти(НРег(Настройка.Ключ), "НормализованныйКлюч");
        Если НастройкаЦели = Неопределено Тогда
            НастройкаЦели = Цель.Добавить();
            НастройкаЦели.НормализованныйКлюч = НРег(Настройка.Ключ);
        КонецЕсли;

        НастройкаЦели.Ключ = Настройка.Ключ;
        НастройкаЦели.Значение = Настройка.Значение;
        НастройкаЦели.База = Настройка.База;
    КонецЦикла;

КонецПроцедуры

#КонецОбласти
