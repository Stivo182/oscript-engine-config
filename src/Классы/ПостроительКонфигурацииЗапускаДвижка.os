#Использовать errors
#Использовать "../internal"

Перем _ТочкаВхода; // Строка, Неопределено
Перем _ТочкаВходаЗадана; // Булево
Перем _РабочийКаталог; // Строка
Перем _КаталогДвижка; // Строка, Неопределено
Перем _РежимОкружения; // Строка
Перем _РежимОкруженияЗадан; // Булево
Перем _СтрокаОкружения; // Строка, Неопределено
Перем _ИспользоватьНастройкиТекущегоЗапуска; // Булево

#Область ОбработчикиСобытий

// Создает контекст моделируемого запуска и фиксирует текущий рабочий каталог.
Процедура ПриСозданииОбъекта()

    _ТочкаВхода = Неопределено;
    _ТочкаВходаЗадана = Ложь;
    _РабочийКаталог = ТекущийКаталог();
    _РежимОкружения = РежимыОкруженияКонфигурацииЗапускаДвижка.Текущее();
    _РежимОкруженияЗадан = Ложь;
    _ИспользоватьНастройкиТекущегоЗапуска = Истина;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Задает рабочий каталог моделируемого запуска без изменения текущего каталога процесса.
//
// Параметры:
//  Каталог - Строка - Путь к существующему рабочему каталогу.
//
// Возвращаемое значение:
//  ПостроительКонфигурацииЗапускаДвижка - Этот объект.
Функция УстановитьРабочийКаталог(Каталог) Экспорт
    _РабочийКаталог = ПроверитьКаталог(Каталог);
    Возврат ЭтотОбъект;
КонецФункции

// Задает точку входа или отключает чтение входного CFG.
//
// Параметры:
//  ТочкаВхода - Строка, Неопределено - Путь к существующему файлу сценария или каталогу;
//               Неопределено отключает CFG точки входа.
//
// Возвращаемое значение:
//  ПостроительКонфигурацииЗапускаДвижка - Этот объект.
Функция УстановитьТочкуВхода(ТочкаВхода) Экспорт
    _ТочкаВхода = ПроверитьТочкуВхода(ТочкаВхода);
    _ТочкаВходаЗадана = Истина;
    Возврат ЭтотОбъект;
КонецФункции

// Задает каталог движка.
//
// Параметры:
//  Каталог - Строка - Путь к существующему каталогу.
//
// Возвращаемое значение:
//  ПостроительКонфигурацииЗапускаДвижка - Этот объект.
Функция УстановитьКаталогДвижка(Каталог) Экспорт
    _КаталогДвижка = ПроверитьКаталог(Каталог);
    Возврат ЭтотОбъект;
КонецФункции

// Включает или отключает автоматическое получение настроек текущего запуска.
// Явно заданные точка входа, каталог движка и настройки окружения имеют приоритет.
//
// Параметры:
//  Использовать - Булево - Истина для автоматического получения, Ложь для отключения.
//
// Возвращаемое значение:
//  ПостроительКонфигурацииЗапускаДвижка - Этот объект.
Функция ИспользоватьНастройкиТекущегоЗапуска(Использовать) Экспорт

    ПроверкаАргументов.ПроверитьТип("Использовать", Использовать, Тип("Булево"));

    _ИспользоватьНастройкиТекущегоЗапуска = Использовать;

    Возврат ЭтотОбъект;

КонецФункции

// Выбирает чтение текущего OSCRIPT_CONFIG либо моделирует его отсутствие.
//
// Параметры:
//  Использовать - Булево - Истина для чтения при расчете, Ложь для отключения.
//
// Возвращаемое значение:
//  ПостроительКонфигурацииЗапускаДвижка - Этот объект.
Функция ИспользоватьНастройкиОкружения(Использовать) Экспорт

    ПроверкаАргументов.ПроверитьТип("Использовать", Использовать, Тип("Булево"));

    _РежимОкружения = ?(Использовать,
        РежимыОкруженияКонфигурацииЗапускаДвижка.Текущее(),
        РежимыОкруженияКонфигурацииЗапускаДвижка.Отключено()
    );
    _РежимОкруженияЗадан = Истина;

    Возврат ЭтотОбъект;

КонецФункции

// Задает явную строку OSCRIPT_CONFIG, включая пустую, для следующих расчетов.
//
// Параметры:
//  СтрокаНастроек - Строка - Настройки по грамматике OSCRIPT_CONFIG.
//
// Возвращаемое значение:
//  ПостроительКонфигурацииЗапускаДвижка - Этот объект.
Функция УстановитьНастройкиОкружения(СтрокаНастроек) Экспорт

    ПроверкаАргументов.ПроверитьТип("СтрокаНастроек", СтрокаНастроек, Тип("Строка"));

    _СтрокаОкружения = СтрокаНастроек;
    _РежимОкружения = РежимыОкруженияКонфигурацииЗапускаДвижка.Явное();
    _РежимОкруженияЗадан = Истина;

    Возврат ЭтотОбъект;

КонецФункции

// Строит конфигурацию в порядке системный CFG, необязательный CFG точки входа, окружение.
//
// Возвращаемое значение:
//  КонфигурацияЗапускаДвижка - Независимая изменяемая конфигурация с базами источников.
Функция Построить() Экспорт

    Попытка
        КаталогДвижка = ОпределитьКаталогДвижка();
        НастройкиИсточников = СервисыКонфигурацииЗапускаДвижка.НоваяТаблицаНастроек();

        ДобавитьСистемныйCFG(НастройкиИсточников, КаталогДвижка);
        ДобавитьВходнойCFG(НастройкиИсточников);
        ДобавитьНастройкиОкружения(НастройкиИсточников);

        Возврат СоздатьКонфигурацию(НастройкиИсточников, КаталогДвижка);
    Исключение
        ВызватьИсключение ФабрикаОшибок.Обернуть(
            ИнформацияОбОшибке(),
            КодыОшибокConfigraph.РасчетКонфигурацииНеВыполнен(),
            "Не удалось рассчитать конфигурацию движка."
        );
    КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОпределитьКаталогДвижка()

    Если _КаталогДвижка <> Неопределено Тогда
        Возврат _КаталогДвижка;
    КонецЕсли;

    Если Не _ИспользоватьНастройкиТекущегоЗапуска Тогда
        Возврат Неопределено;
    КонецЕсли;

    Возврат Новый Файл(ОбъединитьПути(КаталогПрограммы(), "..")).ПолноеИмя;

КонецФункции

Процедура ДобавитьСистемныйCFG(Настройки, КаталогДвижка)

    Если КаталогДвижка = Неопределено Тогда
        Возврат;
    КонецЕсли;

    ПутьСистемногоCFG = ОбъединитьПути(КаталогДвижка, "bin", "oscript.cfg");
    ДобавитьCFG(Настройки, ПутьСистемногоCFG);

КонецПроцедуры

Процедура ДобавитьВходнойCFG(Настройки)

    ТочкаВхода = ОпределитьТочкуВхода();
    Если ТочкаВхода = Неопределено Тогда
        Возврат;
    КонецЕсли;

    ФайлТочкиВхода = Новый Файл(ТочкаВхода);
    КаталогТочкиВхода = ?(ФайлТочкиВхода.ЭтоКаталог(), ТочкаВхода, ФайлТочкиВхода.Путь);
    ПутьВходногоCFG = ОбъединитьПути(КаталогТочкиВхода, "oscript.cfg");

    ДобавитьCFG(Настройки, ПутьВходногоCFG);

КонецПроцедуры

Функция ОпределитьТочкуВхода()

    Если _ТочкаВходаЗадана Тогда
        Возврат _ТочкаВхода;
    КонецЕсли;

    Возврат ?(
        _ИспользоватьНастройкиТекущегоЗапуска,
        СтартовыйСценарий().Каталог,
        Неопределено
    );

КонецФункции

Процедура ДобавитьНастройкиОкружения(Настройки)

    СтрокаОкружения = ПолучитьСтрокуОкружения();
    Если СтрокаОкружения = Неопределено Или СтрокаОкружения = "" Тогда
        Возврат;
    КонецЕсли;

    ПредставлениеОкружения = Новый СтрокаОкруженияЗапускаДвижка;
    Источник = ПредставлениеОкружения.Разобрать(СтрокаОкружения, _РабочийКаталог);
    СлитьИсточник(Настройки, Источник);

КонецПроцедуры

Функция ПолучитьСтрокуОкружения()

    Если Не _РежимОкруженияЗадан И Не _ИспользоватьНастройкиТекущегоЗапуска Тогда
        Возврат Неопределено;
    КонецЕсли;

    Если _РежимОкружения = РежимыОкруженияКонфигурацииЗапускаДвижка.Текущее() Тогда
        Возврат ПолучитьПеременнуюСреды("OSCRIPT_CONFIG");
    КонецЕсли;

    Если _РежимОкружения = РежимыОкруженияКонфигурацииЗапускаДвижка.Явное() Тогда
        Возврат _СтрокаОкружения;
    КонецЕсли;

    Возврат Неопределено;

КонецФункции

Функция СоздатьКонфигурацию(НастройкиИсточников, КаталогДвижка)

    Конфигурация = Новый КонфигурацияЗапускаДвижка(_РабочийКаталог);
    Если КаталогДвижка <> Неопределено Тогда
        Конфигурация.УстановитьКаталогДвижка(КаталогДвижка);
    КонецЕсли;

    Для Каждого Настройка Из НастройкиИсточников Цикл
        ПрименитьНастройку(Конфигурация, Настройка);
    КонецЦикла;

    Возврат Конфигурация;

КонецФункции

Процедура ПрименитьНастройку(Конфигурация, Настройка)

    Если Настройка.НормализованныйКлюч = "lib.system" Тогда
        Конфигурация.УстановитьСистемныйКаталогБиблиотек(Настройка.Значение, Настройка.База);
        Возврат;
    КонецЕсли;

    Если Настройка.НормализованныйКлюч = "lib.additional" Тогда
        Каталоги = СтрРазделить(Настройка.Значение, ";", Ложь);
        Конфигурация.УстановитьДополнительныеКаталогиБиблиотек(Каталоги, Настройка.База);
        Возврат;
    КонецЕсли;

    Конфигурация.Установить(Настройка.Ключ, Настройка.Значение);

КонецПроцедуры

Функция ПроверитьТочкуВхода(ТочкаВхода)

    ПроверкаАргументов.ПроверитьТип("ТочкаВхода", ТочкаВхода, "Строка,Неопределено");

    Если ТочкаВхода = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;

    ПроверкаАргументов.ПроверитьЗаполненность("ТочкаВхода", ТочкаВхода);

    ФайлТочкиВхода = Новый Файл(ТочкаВхода);
    ПроверкаАргументов.ПроверитьДопустимость(
        "ТочкаВхода",
        ФайлТочкиВхода.Существует(),
        "Существующий файл или каталог"
    );

    Возврат ФайлТочкиВхода.ПолноеИмя;

КонецФункции

Функция ПроверитьКаталог(Каталог)

    ПроверкаАргументов.ПроверитьТип("Каталог", Каталог, Тип("Строка"));
    ПроверкаАргументов.ПроверитьЗаполненность("Каталог", Каталог);

    ФайлКаталога = Новый Файл(Каталог);

    ПроверкаАргументов.ПроверитьДопустимость(
        "Каталог",
        ФайлКаталога.Существует() И ФайлКаталога.ЭтоКаталог(),
        "Существующий каталог"
    );

    Возврат ФайлКаталога.ПолноеИмя;

КонецФункции

Процедура ДобавитьCFG(Настройки, Путь)

    Если Новый Файл(Путь).Существует() Тогда
        ФайлКонфигурации = Новый ФайлКонфигурацииЗапускаДвижка(Путь);
        Источник = ФайлКонфигурации.Прочитать();
        СлитьИсточник(Настройки, Источник);
    КонецЕсли;

КонецПроцедуры

Процедура СлитьИсточник(Цель, Источник)

    Для Каждого Настройка Из Источник Цикл
        ПроверкаАргументов.ПроверитьТип("Ключ", Настройка.Ключ, "Строка");
        Если ПустаяСтрока(Настройка.Ключ) Тогда
            ВызватьИсключение ФабрикаОшибок.Создать(
                КодыОшибокConfigraph.НекорректнаяКонфигурация(),
                "Пустой ключ конфигурации."
            );
        КонецЕсли;

        ПроверкаАргументов.ПроверитьТип("Значение", Настройка.Значение, "Строка");

        НастройкаЦели = Цель.Найти(НРег(Настройка.Ключ), "НормализованныйКлюч");
        Если НастройкаЦели = Неопределено Тогда
            НастройкаЦели = Цель.Добавить();
            НастройкаЦели.НормализованныйКлюч = НРег(Настройка.Ключ);
        КонецЕсли;

        НастройкаЦели.Ключ = Настройка.Ключ;
        НастройкаЦели.Значение = Настройка.Значение;
        НастройкаЦели.База = Настройка.База;
    КонецЦикла;

КонецПроцедуры

#КонецОбласти
