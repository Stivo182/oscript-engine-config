#Использовать errors
#Использовать "../internal"

Перем _БазовыйКаталог; // Строка, Неопределено
Перем _Настройки; // ТаблицаЗначений
Перем _КлючКодировкиСценариев; // Строка
Перем _КлючСистемногоЯзыка; // Строка
Перем _КлючРежимаЯвныхИмпортов; // Строка
Перем _КлючРежимаИсполненияПоУмолчанию; // Строка
Перем _КлючМаксимальногоРазмераДвоичныхДанныхВПамяти; // Строка
Перем _КлючСистемногоКаталогаБиблиотек; // Строка
Перем _КлючДополнительныхКаталоговБиблиотек; // Строка

#Область ОбработчикиСобытий

// Создает изменяемую конфигурацию движка.
Процедура ПриСозданииОбъекта()

    _КлючКодировкиСценариев = "encoding.script";
    _КлючСистемногоЯзыка = "systemLanguage";
    _КлючРежимаЯвныхИмпортов = "lang.explicitImports";
    _КлючРежимаИсполненияПоУмолчанию = "runtime.default";
    _КлючМаксимальногоРазмераДвоичныхДанныхВПамяти = "binaryData.inMemoryMaxSize";
    _КлючСистемногоКаталогаБиблиотек = "lib.system";
    _КлючДополнительныхКаталоговБиблиотек = "lib.additional";

    _БазовыйКаталог = Неопределено;
    _Настройки = СервисыКонфигурацииЗапускаДвижка.НоваяТаблицаНастроек();

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Проверяет наличие настройки без учета регистра ключа.
//
// Параметры:
//  Ключ - Строка - Ключ настройки.
//
// Возвращаемое значение:
//  Булево - Наличие настройки, в том числе с пустым значением.
Функция Содержит(Ключ) Экспорт
    Возврат НайтиНастройку(Ключ) <> Неопределено;
КонецФункции

// Возвращает значение настройки без учета регистра ключа.
//
// Параметры:
//  Ключ - Строка - Ключ настройки.
//
// Возвращаемое значение:
//  Строка, Неопределено - Значение или Неопределено для отсутствующего ключа.
Функция ПолучитьЗначение(Ключ) Экспорт
    Настройка = НайтиНастройку(Ключ);
    Возврат ?(Настройка = Неопределено, Неопределено, Настройка.Значение);
КонецФункции

// Возвращает независимое представление настройки без учета регистра ключа.
//
// Параметры:
//  Ключ - Строка - Ключ настройки.
//
// Возвращаемое значение:
//  Структура:
//   * НормализованныйКлюч - Строка - Ключ в нижнем регистре;
//   * Значение - Строка - Сохраненное значение настройки;
//   * База - Строка - Базовый каталог настройки.
//  Неопределено - Если ключ отсутствует.
Функция ПолучитьНастройку(Ключ) Экспорт

    Настройка = НайтиНастройку(Ключ);
    Если Настройка = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;

    Возврат Новый Структура(
        "НормализованныйКлюч, Значение, База",
        Настройка.НормализованныйКлюч,
        Настройка.Значение,
        Настройка.База
    );

КонецФункции

// Задает базовый каталог для последующих настроек без преобразования пути.
//
// Параметры:
//  Каталог - Строка, Неопределено - База последующих настроек или Неопределено для текущего каталога.
Процедура УстановитьБазовыйКаталог(Каталог) Экспорт
    ПроверкаАргументов.ПроверитьТип("Каталог", Каталог, "Строка,Неопределено");
    _БазовыйКаталог = Каталог;
КонецПроцедуры

// Возвращает базовый каталог без преобразования в абсолютный путь.
//
// Возвращаемое значение:
//  Строка, Неопределено - База последующих настроек или Неопределено для текущего каталога.
Функция ПолучитьБазовыйКаталог() Экспорт
    Возврат _БазовыйКаталог;
КонецФункции

// Возвращает отдельный массив ключей в порядке без учета регистра.
//
// Возвращаемое значение:
//  Массив из Строка - Последние написания ключей.
Функция Ключи() Экспорт

    Настройки = _Настройки.Скопировать(, "НормализованныйКлюч, Ключ");
    Настройки.Сортировать("НормализованныйКлюч, Ключ");

    Ключи = Новый Массив;
    Для Каждого Настройка Из Настройки Цикл
        Ключи.Добавить(Настройка.Ключ);
    КонецЦикла;

    Возврат Ключи;

КонецФункции

// Добавляет или заменяет настройку без учета регистра ключа.
//
// Параметры:
//  Ключ - Строка - Ключ с сохранением написания и пробелов.
//  Значение - Строка - Значение с сохранением пробелов.
Процедура Установить(Ключ, Значение) Экспорт
    УстановитьНастройку(Ключ, Значение, ОпределитьБазовыйКаталог(Неопределено));
КонецПроцедуры

// Задает кодировку исходных файлов сценариев.
//
// Параметры:
//  Кодировка - Строка - Значение настройки encoding.script.
Процедура УстановитьКодировкуСценариев(Кодировка) Экспорт
    Установить(_КлючКодировкиСценариев, Кодировка);
КонецПроцедуры

// Возвращает кодировку исходных файлов сценариев.
//
// Возвращаемое значение:
//  Строка, Неопределено - Значение настройки encoding.script или Неопределено, если она отсутствует.
Функция ПолучитьКодировкуСценариев() Экспорт
    Возврат ПолучитьЗначение(_КлючКодировкиСценариев);
КонецФункции

// Задает язык сообщений движка.
//
// Параметры:
//  Язык - Строка - Значение настройки systemLanguage.
Процедура УстановитьСистемныйЯзык(Язык) Экспорт
    Установить(_КлючСистемногоЯзыка, Язык);
КонецПроцедуры

// Возвращает язык сообщений движка.
//
// Возвращаемое значение:
//  Строка, Неопределено - Значение настройки systemLanguage или Неопределено, если она отсутствует.
Функция ПолучитьСистемныйЯзык() Экспорт
    Возврат ПолучитьЗначение(_КлючСистемногоЯзыка);
КонецФункции

// Задает режим проверки явных импортов библиотек.
//
// Параметры:
//  Режим - Строка - Значение настройки lang.explicitImports.
Процедура УстановитьРежимЯвныхИмпортов(Режим) Экспорт
    Установить(_КлючРежимаЯвныхИмпортов, Режим);
КонецПроцедуры

// Возвращает режим проверки явных импортов библиотек.
//
// Возвращаемое значение:
//  Строка, Неопределено - Значение настройки lang.explicitImports или Неопределено, если она отсутствует.
Функция ПолучитьРежимЯвныхИмпортов() Экспорт
    Возврат ПолучитьЗначение(_КлючРежимаЯвныхИмпортов);
КонецФункции

// Задает режим исполнения сценариев по умолчанию.
//
// Параметры:
//  Режим - Строка - Значение настройки runtime.default.
Процедура УстановитьРежимИсполненияПоУмолчанию(Режим) Экспорт
    Установить(_КлючРежимаИсполненияПоУмолчанию, Режим);
КонецПроцедуры

// Возвращает режим исполнения сценариев по умолчанию.
//
// Возвращаемое значение:
//  Строка, Неопределено - Значение настройки runtime.default или Неопределено, если она отсутствует.
Функция ПолучитьРежимИсполненияПоУмолчанию() Экспорт
    Возврат ПолучитьЗначение(_КлючРежимаИсполненияПоУмолчанию);
КонецФункции

// Задает максимальный размер двоичных данных, хранимых в памяти.
//
// Параметры:
//  Размер - Строка - Значение настройки binaryData.inMemoryMaxSize.
Процедура УстановитьМаксимальныйРазмерДвоичныхДанныхВПамяти(Размер) Экспорт
    Установить(_КлючМаксимальногоРазмераДвоичныхДанныхВПамяти, Размер);
КонецПроцедуры

// Возвращает максимальный размер двоичных данных, хранимых в памяти.
//
// Возвращаемое значение:
//  Строка, Неопределено - Значение настройки binaryData.inMemoryMaxSize или Неопределено, если она отсутствует.
Функция ПолучитьМаксимальныйРазмерДвоичныхДанныхВПамяти() Экспорт
    Возврат ПолучитьЗначение(_КлючМаксимальногоРазмераДвоичныхДанныхВПамяти);
КонецФункции

// Заменяет системный каталог библиотек.
//
// Параметры:
//  Каталог - Строка - Один путь без разделителя списка `;`.
//  КаталогОтносительныхПутей - Строка, Неопределено - База пути; по умолчанию база конфигурации.
Процедура УстановитьСистемныйКаталогБиблиотек(Каталог, КаталогОтносительныхПутей = Неопределено) Экспорт

    Каталог = ПроверитьКаталогБиблиотек(Каталог);
    База = ОпределитьБазовыйКаталог(КаталогОтносительныхПутей);

    УстановитьНастройку(_КлючСистемногоКаталогаБиблиотек, Каталог, База);

КонецПроцедуры

// Возвращает сохраненный системный каталог библиотек без разрешения относительного пути.
//
// Возвращаемое значение:
//  Строка, Неопределено - Значение настройки lib.system или Неопределено, если она отсутствует.
Функция ПолучитьСистемныйКаталогБиблиотек() Экспорт
    Возврат ПолучитьЗначение(_КлючСистемногоКаталогаБиблиотек);
КонецФункции

// Заменяет список дополнительных каталогов библиотек, сохраняя порядок и повторы непустых путей.
//
// Параметры:
//  Каталоги - Массив из Строка - Пути без разделителя списка `;`; пустые строки пропускаются.
//  КаталогОтносительныхПутей - Строка, Неопределено - Общая база путей; по умолчанию база конфигурации.
Процедура УстановитьДополнительныеКаталогиБиблиотек(Каталоги, КаталогОтносительныхПутей = Неопределено) Экспорт

    ПроверкаАргументов.ПроверитьТип("Каталоги", Каталоги, Тип("Массив"));

    НепустыеКаталоги = Новый Массив;
    Для Каждого Каталог Из Каталоги Цикл
        Каталог = ПроверитьКаталогБиблиотек(Каталог);
        Если ПустаяСтрока(Каталог) Тогда
            Продолжить;
        КонецЕсли;

        НепустыеКаталоги.Добавить(Каталог);
    КонецЦикла;

    База = ОпределитьБазовыйКаталог(КаталогОтносительныхПутей);
    УстановитьНастройку(_КлючДополнительныхКаталоговБиблиотек, СтрСоединить(НепустыеКаталоги, ";"), База);

КонецПроцедуры

// Возвращает сохраненные дополнительные каталоги библиотек без разрешения относительных путей.
//
// Возвращаемое значение:
//  Массив из Строка, Неопределено - Независимый список или Неопределено, если настройка отсутствует.
Функция ПолучитьДополнительныеКаталогиБиблиотек() Экспорт

    Значение = ПолучитьЗначение(_КлючДополнительныхКаталоговБиблиотек);
    Если Значение = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;

    Возврат ?(Значение = "", Новый Массив, СтрРазделить(Значение, ";", Ложь));

КонецФункции

// Добавляет один путь в конец списка дополнительных каталогов библиотек.
// Относительный путь использует базу существующего списка, а для нового списка - базу конфигурации.
//
// Параметры:
//  Каталог - Строка - Путь без разделителя списка `;`; пустая строка пропускается.
Процедура ДобавитьДополнительныйКаталогБиблиотек(Каталог) Экспорт

    Каталог = ПроверитьКаталогБиблиотек(Каталог);
    Если ПустаяСтрока(Каталог) Тогда
        Возврат;
    КонецЕсли;

    Настройка = НайтиНастройку(_КлючДополнительныхКаталоговБиблиотек);
    Если Настройка = Неопределено Тогда
        Установить(_КлючДополнительныхКаталоговБиблиотек, Каталог);
        Возврат;
    КонецЕсли;

    Значение = ?(ПустаяСтрока(Настройка.Значение), Каталог, Настройка.Значение + ";" + Каталог);
    УстановитьНастройку(_КлючДополнительныхКаталоговБиблиотек, Значение, Настройка.База);

КонецПроцедуры

// Удаляет настройку без учета регистра; отсутствие ключа допустимо.
//
// Параметры:
//  Ключ - Строка - Ключ удаляемой настройки.
Процедура Удалить(Ключ) Экспорт

    Настройка = НайтиНастройку(Ключ);

    Если Настройка <> Неопределено Тогда
        _Настройки.Удалить(Настройка);
    КонецЕсли;

КонецПроцедуры

// Полностью заменяет CFG каноническим UTF-8 без BOM с окончаниями строк LF.
//
// Параметры:
//  Путь - Строка - Целевой файл CFG; каталог должен существовать.
//  ПреобразованиеПутей - Строка, Неопределено - Значение ПреобразованияПутейКонфигурацииЗапускаДвижка;
//                        Неопределено выбирает БезПреобразования.
Процедура ЗаписатьВФайл(Путь, ПреобразованиеПутей = Неопределено) Экспорт

    ПроверкаАргументов.ПроверитьТип("Путь", Путь, "Строка");
    ПроверкаАргументов.ПроверитьЗаполненность("Путь", СокрЛП(Путь));

    Если ПреобразованиеПутей = Неопределено Тогда
        ПреобразованиеПутей = ПреобразованияПутейКонфигурацииЗапускаДвижка.БезПреобразования();
    КонецЕсли;

    ПроверкаАргументов.ПроверитьТип("ПреобразованиеПутей", ПреобразованиеПутей, "Строка");
    ПроверкаАргументов.ПроверитьДопустимость(
        "ПреобразованиеПутей",
        ПреобразованиеПутей = ПреобразованияПутейКонфигурацииЗапускаДвижка.БезПреобразования()
            Или ПреобразованиеПутей = ПреобразованияПутейКонфигурацииЗапускаДвижка.ВАбсолютные()
            Или ПреобразованиеПутей = ПреобразованияПутейКонфигурацииЗапускаДвижка.ОтносительноФайла(),
        "Поддерживаемое преобразование путей"
    );

    ФайлКонфигурации = Новый ФайлКонфигурацииЗапускаДвижка(Путь);
    ФайлКонфигурации.Записать(_Настройки, ПреобразованиеПутей);

КонецПроцедуры

// Возвращает OSCRIPT_CONFIG с абсолютными путями библиотек без изменения окружения.
//
// Возвращаемое значение:
//  Строка - Обратимое представление настроек; для пустой конфигурации пустая строка.
Функция ВСтрокуОкружения() Экспорт

    ПредставлениеОкружения = Новый СтрокаОкруженияЗапускаДвижка;
    Возврат ПредставлениеОкружения.Сформировать(_Настройки);

КонецФункции

// Устанавливает OSCRIPT_CONFIG текущего процесса без изменения рабочего каталога.
Процедура УстановитьВПеременнуюОкружения() Экспорт

    Попытка
        УстановитьПеременнуюСреды("OSCRIPT_CONFIG", ВСтрокуОкружения());
    Исключение
        ВызватьИсключение ФабрикаОшибок.Обернуть(
            ИнформацияОбОшибке(),
            КодыОшибокEngineConfig.УстановкаОкруженияНеВыполнена(),
            "Не удалось установить OSCRIPT_CONFIG"
        );
    КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НайтиНастройку(Ключ)
    ПроверкаАргументов.ПроверитьТип("Ключ", Ключ, "Строка");
    Возврат _Настройки.Найти(НРег(Ключ), "НормализованныйКлюч");
КонецФункции

Процедура УстановитьНастройку(Ключ, Значение, База)

    ПроверкаАргументов.ПроверитьТип("Значение", Значение, "Строка");

    Настройка = НайтиНастройку(Ключ);
    Если Настройка = Неопределено Тогда
        Настройка = _Настройки.Добавить();
        Настройка.НормализованныйКлюч = НРег(Ключ);
    КонецЕсли;

    Настройка.Ключ = Ключ;
    Настройка.Значение = Значение;
    Настройка.База = База;

КонецПроцедуры

Функция ОпределитьБазовыйКаталог(Каталог)

    ПроверкаАргументов.ПроверитьТип("КаталогОтносительныхПутей", Каталог, "Строка,Неопределено");

    Если Каталог <> Неопределено Тогда
        Возврат Каталог;
    КонецЕсли;

    Возврат ?(_БазовыйКаталог = Неопределено, ТекущийКаталог(), _БазовыйКаталог);

КонецФункции

Функция ПроверитьКаталогБиблиотек(Каталог)

    ПроверкаАргументов.ПроверитьТип("Каталог", Каталог, Тип("Строка"));

    Каталог = СокрЛП(Каталог);
    ПроверкаАргументов.ПроверитьДопустимость(
        "Каталог",
        Найти(Каталог, ";") = 0,
        "Путь без разделителя `;`"
    );

    Возврат Каталог;

КонецФункции

#КонецОбласти
