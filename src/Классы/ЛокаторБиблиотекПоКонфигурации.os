#Использовать errors
#Использовать "../internal"

Перем _СистемныеКаталоги; // Массив из Строка
Перем _ДополнительныеКаталоги; // Массив из Строка
Перем _КаталогиПоиска; // Массив из Строка

#Область ОбработчикиСобытий

// Создает неизменяемый снимок каталогов поиска библиотек.
//
// Параметры:
//  Конфигурации - КонфигурацияИнтерпретатора, Массив из КонфигурацияИнтерпретатора - Исходные конфигурации запуска.
//
// Исключения:
//  argument.invalid_type - Конфигурации или элемент массива имеют неверный тип.
//  engine_config.path_unresolved - Библиотечный путь не удалось разрешить.
//  engine_config.invalid_configuration - Разрешенный путь lib.additional содержит разделитель списка.
Процедура ПриСозданииОбъекта(Конфигурации)

    ПроверкаАргументов.ПроверитьТип("Конфигурации", Конфигурации, "КонфигурацияИнтерпретатора, Массив");

    Если ТипЗнч(Конфигурации) = Тип("КонфигурацияИнтерпретатора") Тогда
        ИсходныеКонфигурации = Новый Массив;
        ИсходныеКонфигурации.Добавить(Конфигурации);
    Иначе
        ИсходныеКонфигурации = Конфигурации;
    КонецЕсли;

    _СистемныеКаталоги = Новый Массив;
    _ДополнительныеКаталоги = Новый Массив;
    _КаталогиПоиска = Новый Массив;

    Для Каждого Конфигурация Из ИсходныеКонфигурации Цикл
        ПроверкаАргументов.ПроверитьТип(
            "Конфигурации",
            Конфигурация,
            Тип("КонфигурацияИнтерпретатора")
        );

        Дополнительные = Конфигурация.ПолучитьНастройку("lib.additional");
        Если Дополнительные <> Неопределено Тогда
            АбсолютныеПути = ОперацииСНастройкамиКонфигурацииИнтерпретатора.АбсолютноеЗначениеНастройки(Дополнительные);
            Если ЗначениеЗаполнено(АбсолютныеПути) Тогда
                Для Каждого Каталог Из СтрРазделить(АбсолютныеПути, ";", Ложь) Цикл
                    _ДополнительныеКаталоги.Добавить(Каталог);
                    ДобавитьКаталогПоиска(Каталог);
                КонецЦикла;
            КонецЕсли;
        КонецЕсли;

        Системная = Конфигурация.ПолучитьНастройку("lib.system");
        Если Системная <> Неопределено И ЗначениеЗаполнено(Системная.Значение) Тогда
            СистемныйКаталог = ОперацииСНастройкамиКонфигурацииИнтерпретатора.АбсолютноеЗначениеНастройки(Системная);
            _СистемныеКаталоги.Добавить(СистемныйКаталог);
            ДобавитьКаталогПоиска(СистемныйКаталог);
        КонецЕсли;
    КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает системные каталоги поиска библиотек.
//
// Возвращаемое значение:
//  Массив из Строка - Независимый массив абсолютных путей.
Функция ПолучитьСистемныеКаталоги() Экспорт
    Возврат КопияМассива(_СистемныеКаталоги);
КонецФункции

// Возвращает дополнительные каталоги поиска библиотек.
//
// Возвращаемое значение:
//  Массив из Строка - Независимый массив абсолютных путей.
Функция ПолучитьДополнительныеКаталоги() Экспорт
    Возврат КопияМассива(_ДополнительныеКаталоги);
КонецФункции

// Возвращает уникальные каталоги поиска для каждой конфигурации: дополнительные по порядку, затем системный.
//
// Возвращаемое значение:
//  Массив из Строка - Независимый массив абсолютных путей.
Функция ПолучитьКаталогиПоиска() Экспорт
    Возврат КопияМассива(_КаталогиПоиска);
КонецФункции

// Возвращает первый существующий каталог библиотеки без проверки кода и запуска загрузчика.
//
// Параметры:
//  Имя - Строка - Непустое имя без крайних пробелов, разделителей пути, двоеточия и точных . или ..
//
// Исключения:
//  argument.invalid_type - Имя имеет неверный тип.
//  argument.required - Имя пусто или состоит из пробелов.
//  argument.invalid_value - Имя содержит путь, крайние пробелы или равно `.` либо `..`.
//
// Возвращаемое значение:
//  Строка, Неопределено - Абсолютный путь к первому каталогу или Неопределено.
Функция НайтиКаталогБиблиотеки(Имя) Экспорт

    ПроверитьИмяБиблиотеки(Имя);

    Для Каждого Каталог Из ПолучитьКаталогиПоиска() Цикл
        Библиотека = Новый Файл(ОбъединитьПути(Каталог, Имя));
        Если Библиотека.Существует() И Библиотека.ЭтоКаталог() Тогда
            Возврат Библиотека.ПолноеИмя;
        КонецЕсли;
    КонецЦикла;

    Возврат Неопределено;

КонецФункции

// Возвращает все каталоги библиотеки с указанным именем.
//
// Параметры:
//  Имя - Строка - Имя библиотеки.
//
// Исключения:
//  argument.invalid_type - Имя имеет неверный тип.
//  argument.required - Имя пусто или состоит из пробелов.
//  argument.invalid_value - Имя содержит путь, крайние пробелы или равно `.` либо `..`.
//
// Возвращаемое значение:
//  Массив из Строка - Абсолютные пути в порядке поиска. Пустой массив, если библиотека не найдена.
Функция НайтиВсеКаталогиБиблиотеки(Имя) Экспорт

    ПроверитьИмяБиблиотеки(Имя);

    Результат = Новый Массив;
    Для Каждого Каталог Из _КаталогиПоиска Цикл
        Библиотека = Новый Файл(ОбъединитьПути(Каталог, Имя));
        Если Библиотека.Существует() И Библиотека.ЭтоКаталог() Тогда
            Результат.Добавить(Библиотека.ПолноеИмя);
        КонецЕсли;
    КонецЦикла;

    Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьКаталогПоиска(Каталог)

    Если _КаталогиПоиска.Найти(Каталог) = Неопределено Тогда
        _КаталогиПоиска.Добавить(Каталог);
    КонецЕсли;

КонецПроцедуры

Функция КопияМассива(Источник)

    Результат = Новый Массив;
    Для Каждого Элемент Из Источник Цикл
        Результат.Добавить(Элемент);
    КонецЦикла;

    Возврат Результат;

КонецФункции

Процедура ПроверитьИмяБиблиотеки(Имя)

    ПроверкаАргументов.ПроверитьТип("Имя", Имя, "Строка");
    ПроверкаАргументов.ПроверитьЗаполненность("Имя", СокрЛП(Имя));
    ПроверкаАргументов.ПроверитьДопустимость(
        "Имя",
        ЭтоДопустимоеИмяБиблиотеки(Имя),
        "Имя библиотеки без пути и крайних пробелов"
    );

КонецПроцедуры

Функция ЭтоДопустимоеИмяБиблиотеки(Имя)

    Возврат Имя = СокрЛП(Имя)
        И Имя <> "."
        И Имя <> ".."
        И Найти(Имя, "/") = 0
        И Найти(Имя, "\") = 0
        И Найти(Имя, ":") = 0;

КонецФункции

#КонецОбласти
