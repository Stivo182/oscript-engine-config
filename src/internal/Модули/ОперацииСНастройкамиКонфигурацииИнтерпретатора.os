#Использовать errors

#Область СлужебныйПрограммныйИнтерфейс

// Создает таблицу настроек.
//
// Возвращаемое значение:
//  ТаблицаЗначений:
//   * НормализованныйКлюч - Строка - Ключ в нижнем регистре;
//   * Ключ - Строка - Ключ с сохранением написания;
//   * Значение - Строка - Сохраненное значение настройки;
//   * База - Строка - Базовый каталог настройки.
Функция НоваяТаблицаНастроек() Экспорт

    Настройки = Новый ТаблицаЗначений;

    Настройки.Колонки.Добавить("НормализованныйКлюч");
    Настройки.Колонки.Добавить("Ключ");
    Настройки.Колонки.Добавить("Значение");
    Настройки.Колонки.Добавить("База");
    Настройки.Индексы.Добавить("НормализованныйКлюч");

    Возврат Настройки;

КонецФункции

// Добавляет настройку или заменяет точный дубль, сохраняя его позицию.
//
// Параметры:
//  Источник - ТаблицаЗначений - Таблица из НоваяТаблицаНастроек.
//  Ключ - Строка - Ключ с сохранением написания.
//  Значение - Строка - Значение настройки.
//  База - Строка - Базовый каталог настройки.
Процедура УстановитьНастройкуИсточника(Источник, Ключ, Значение, База) Экспорт

    Для Каждого Настройка Из Источник Цикл
        Если Настройка.Ключ = Ключ Тогда
            Настройка.Значение = Значение;
            Настройка.База = База;
            Возврат;
        КонецЕсли;
    КонецЦикла;

    Настройка = Источник.Добавить();
    Настройка.НормализованныйКлюч = НРег(Ключ);
    Настройка.Ключ = Ключ;
    Настройка.Значение = Значение;
    Настройка.База = База;

КонецПроцедуры

// Возвращает значение с абсолютными путями библиотек, сохраняя остальные настройки.
//
// Параметры:
//  Настройка - Структура, СтрокаТаблицыЗначений:
//   * НормализованныйКлюч - Строка - Ключ в нижнем регистре;
//   * Значение - Строка - Сохраненное значение настройки;
//   * База - Строка - Базовый каталог настройки.
//
// Возвращаемое значение:
//  Строка - Значение для экспорта без изменения исходной настройки.
Функция АбсолютноеЗначениеНастройки(Настройка) Экспорт

    Если Настройка.НормализованныйКлюч = "lib.system" Тогда
        Путь = СокрЛП(Настройка.Значение);
        Если ПустаяСтрока(Путь) Тогда
            Возврат "";
        КонецЕсли;

        Возврат РазрешитьАбсолютныйПуть(Путь, Настройка.База);
    ИначеЕсли Настройка.НормализованныйКлюч = "lib.additional" Тогда
        Пути = Новый Массив;
        Для Каждого Путь Из СтрРазделить(Настройка.Значение, ";", Ложь) Цикл
            Путь = СокрЛП(Путь);
            Если Не ПустаяСтрока(Путь) Тогда
                АбсолютныйПуть = РазрешитьАбсолютныйПуть(Путь, Настройка.База);
                Если Найти(АбсолютныйПуть, ";") > 0 Тогда
                    ВызватьИсключение ФабрикаОшибок.Создать(
                        КодыОшибокКонфигурацииИнтерпретатора.НекорректнаяКонфигурация(),
                        "Отдельный путь lib.additional содержит разделитель списка.",
                        Новый Структура("Путь", АбсолютныйПуть)
                    );
                КонецЕсли;

                Пути.Добавить(АбсолютныйПуть);
            КонецЕсли;
        КонецЦикла;

        Возврат СтрСоединить(Пути, ";");
    КонецЕсли;

    Возврат Настройка.Значение;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазрешитьАбсолютныйПуть(Путь, База)

    Попытка
        Возврат Новый Файл(ОбъединитьПути(База, Путь)).ПолноеИмя;
    Исключение
        ВызватьИсключение ФабрикаОшибок.Обернуть(
            ИнформацияОбОшибке(),
            КодыОшибокКонфигурацииИнтерпретатора.ПутьНеРазрешен(),
            "Не удалось разрешить путь библиотеки.",
            Новый Структура("Путь,База", Путь, База)
        );
    КонецПопытки;

КонецФункции

#КонецОбласти
