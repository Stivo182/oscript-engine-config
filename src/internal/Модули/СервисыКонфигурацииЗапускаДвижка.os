#Использовать errors

#Область СлужебныйПрограммныйИнтерфейс

// Создает таблицу настроек.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Колонки НормализованныйКлюч, Ключ, Значение, База.
Функция НоваяТаблицаНастроек() Экспорт

    Настройки = Новый ТаблицаЗначений;

    Настройки.Колонки.Добавить("НормализованныйКлюч");
    Настройки.Колонки.Добавить("Ключ");
    Настройки.Колонки.Добавить("Значение");
    Настройки.Колонки.Добавить("База");

    Возврат Настройки;

КонецФункции

// Возвращает значение с абсолютными путями библиотек, сохраняя остальные настройки.
//
// Параметры:
//  Настройка - СтрокаТаблицыЗначений - Настройка с ключом, значением и базой источника.
//
// Возвращаемое значение:
//  Строка - Значение для экспорта без изменения исходной настройки.
Функция АбсолютноеЗначениеНастройки(Настройка) Экспорт

    Если Настройка.НормализованныйКлюч = "lib.system" Тогда
        Возврат РазрешитьАбсолютныйПуть(СокрЛП(Настройка.Значение), Настройка.База);
    ИначеЕсли Настройка.НормализованныйКлюч = "lib.additional" Тогда
        Пути = Новый Массив;
        Для Каждого Путь Из СтрРазделить(Настройка.Значение, ";", Ложь) Цикл
            Путь = СокрЛП(Путь);
            Если Не ПустаяСтрока(Путь) Тогда
                АбсолютныйПуть = РазрешитьАбсолютныйПуть(Путь, Настройка.База);
                Если Найти(АбсолютныйПуть, ";") > 0 Тогда
                    ВызватьИсключение ФабрикаОшибок.Создать(
                        КодыОшибокConfigraph.НекорректнаяКонфигурация(),
                        "Отдельный путь lib.additional содержит разделитель списка.",
                        Новый Структура("Путь", АбсолютныйПуть)
                    );
                КонецЕсли;

                Пути.Добавить(АбсолютныйПуть);
            КонецЕсли;
        КонецЦикла;

        Возврат СтрСоединить(Пути, ";");
    КонецЕсли;

    Возврат Настройка.Значение;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазрешитьАбсолютныйПуть(Путь, База)

    Попытка
        Возврат Новый Файл(ОбъединитьПути(База, Путь)).ПолноеИмя;
    Исключение
        ВызватьИсключение ФабрикаОшибок.Обернуть(
            ИнформацияОбОшибке(),
            КодыОшибокConfigraph.ПутьНеРазрешен(),
            "Не удалось разрешить путь библиотеки.",
            Новый Структура("Путь,База", Путь, База)
        );
    КонецПопытки;

КонецФункции

#КонецОбласти
