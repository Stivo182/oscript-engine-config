#Использовать errors

Перем _Путь; // Строка

#Область ОбработчикиСобытий

// Создает представление файла конфигурации запуска движка.
//
// Параметры:
//  Путь - Строка - Путь к файлу CFG.
Процедура ПриСозданииОбъекта(Путь)

    ПроверкаАргументов.ПроверитьТип("Путь", Путь, "Строка");
    ПроверкаАргументов.ПроверитьЗаполненность("Путь", СокрЛП(Путь));

    _Путь = Новый Файл(Путь).ПолноеИмя;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Читает CFG, сохраняя порядок и точное написание ключей источника.
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. СервисыКонфигурацииЗапускаДвижка.НоваяТаблицаНастроек.
Функция Прочитать() Экспорт

    Документ = Новый ТекстовыйДокумент;
    Документ.Прочитать(_Путь);

    КаталогCFG = Новый Файл(_Путь).Путь;
    Результат = СервисыКонфигурацииЗапускаДвижка.НоваяТаблицаНастроек();

    Для НомерСтроки = 1 По Документ.КоличествоСтрок() Цикл
        Строка = Документ.ПолучитьСтроку(НомерСтроки);
        Если ПустаяСтрока(СокрЛП(Строка)) Или Лев(Строка, 1) = "#" Тогда
            Продолжить;
        КонецЕсли;

        ПозицияРавно = Найти(Строка, "=");
        Если ПозицияРавно = 0 Тогда
            Продолжить;
        КонецЕсли;

        Ключ = СокрЛП(Лев(Строка, ПозицияРавно - 1));
        Значение = СокрЛП(Сред(Строка, ПозицияРавно + 1));
        СервисыКонфигурацииЗапускаДвижка.УстановитьНастройкуИсточника(Результат, Ключ, Значение, КаталогCFG);
    КонецЦикла;

    Возврат Результат;

КонецФункции

// Записывает проверенный канонический CFG через временный файл и две операции переименования.
//
// Параметры:
//  Настройки - ТаблицаЗначений - см. СервисыКонфигурацииЗапускаДвижка.НоваяТаблицаНастроек.
//  ПреобразованиеПутей - Строка - Способ преобразования библиотечных путей.
Процедура Записать(Знач Настройки, ПреобразованиеПутей) Экспорт

    ВременныйПуть = "";
    ПутьОтката = "";
    ЦельПеремещена = Ложь;
    Данные = Новый Структура("Путь,ПутьОтката", _Путь, ПутьОтката);

    Попытка
        ФайлНазначения = Новый Файл(_Путь);
        Каталог = ФайлНазначения.Путь;
        ИмяФайла = ФайлНазначения.Имя;

        ПроверитьФайлНазначения(ФайлНазначения, Каталог, ИмяФайла, Данные);

        Настройки = Настройки.Скопировать();
        Настройки.Сортировать("НормализованныйКлюч, Ключ");

        ТекстCFG = СформироватьТекстCFG(Настройки, ПреобразованиеПутей, Каталог);
        Идентификатор = СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
        ВременныйПуть = ОбъединитьПути(Каталог, "." + ИмяФайла + ".engine-config-temp-" + Идентификатор);
        ПутьОтката = ОбъединитьПути(Каталог, "." + ИмяФайла + ".engine-config-rollback-" + Идентификатор);
        Данные.ПутьОтката = ПутьОтката;

        ЗаписатьВременныйФайл(ВременныйПуть, ТекстCFG);
        ПроверитьВременныйФайл(ВременныйПуть, Настройки);
        ЗаменитьФайлНазначения(ФайлНазначения, ВременныйПуть, ПутьОтката, ЦельПеремещена);
    Исключение
        ОбработатьОшибкуЗаписи(ИнформацияОбОшибке(), ЦельПеремещена, ВременныйПуть, ПутьОтката, Данные);
    КонецПопытки;

    УдалитьВременныйФайл(ВременныйПуть);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьФайлНазначения(ФайлНазначения, Каталог, ИмяФайла, Данные)

    СтарыеОткаты = НайтиФайлы(Каталог, "." + ИмяФайла + ".engine-config-rollback-*");
    Если СтарыеОткаты.Количество() > 0 Тогда
        Данные.ПутьОтката = СтарыеОткаты[0].ПолноеИмя;
        ВызватьИсключение ФабрикаОшибок.Создать(
            КодыОшибокEngineConfig.ЗаписьКонфигурацииНеВыполнена(),
            "Найден файл незавершенной замены CFG; требуется восстановление."
        );
    КонецЕсли;

    Если ФайлНазначения.Существует() И ФайлНазначения.ЭтоКаталог() Тогда
        ВызватьИсключение ФабрикаОшибок.Создать(
            КодыОшибокEngineConfig.ЗаписьКонфигурацииНеВыполнена(),
            "Целевой путь CFG является каталогом."
        );
    КонецЕсли;

КонецПроцедуры

Функция СформироватьТекстCFG(Настройки, ПреобразованиеПутей, Каталог)

    Строки = Новый Массив;

    Для Каждого Настройка Из Настройки Цикл
        ПроверитьПару(Настройка);
        ПреобразоватьПути(Настройка, ПреобразованиеПутей, Каталог);

        Строки.Добавить(Настройка.Ключ + "=" + Настройка.Значение);
    КонецЦикла;

    Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Процедура ПреобразоватьПути(Настройка, ПреобразованиеПутей, Каталог)

    Если ПреобразованиеПутей <> ПреобразованияПутейКонфигурацииЗапускаДвижка.ВАбсолютные()
        И ПреобразованиеПутей <> ПреобразованияПутейКонфигурацииЗапускаДвижка.ОтносительноФайла() Тогда
        Возврат;
    КонецЕсли;

    Настройка.Значение = СервисыКонфигурацииЗапускаДвижка.АбсолютноеЗначениеНастройки(Настройка);
    Если ПреобразованиеПутей = ПреобразованияПутейКонфигурацииЗапускаДвижка.ОтносительноФайла() Тогда
        ПреобразоватьОтносительныеПути(Настройка, Каталог);
    КонецЕсли;

    ПроверитьПару(Настройка);

КонецПроцедуры

Процедура ЗаписатьВременныйФайл(Путь, Текст)

    Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8NoBOM, Символы.ПС, Ложь, Символы.ПС);

    Попытка
        Запись.Записать(Текст);
    Исключение
        ОшибкаЗаписи = ИнформацияОбОшибке();

        Попытка
            Запись.Закрыть();
        Исключение
            // Ошибка закрытия не должна скрывать исходный отказ записи.
        КонецПопытки;

        ВызватьИсключение ОшибкаЗаписи;
    КонецПопытки;

    Запись.Закрыть();

КонецПроцедуры

Процедура ПроверитьВременныйФайл(Путь, Настройки)

    ФайлПроверки = Новый ФайлКонфигурацииЗапускаДвижка(Путь);
    Прочитанные = ФайлПроверки.Прочитать();

    Если Прочитанные.Количество() <> Настройки.Количество() Тогда
        ВызватьИсключение ФабрикаОшибок.Создать(
            КодыОшибокEngineConfig.НекорректнаяКонфигурация(),
            "CFG изменяет количество настроек при повторном разборе."
        );
    КонецЕсли;

    Для Индекс = 0 По Настройки.Количество() - 1 Цикл
        Если Прочитанные[Индекс].Ключ <> Настройки[Индекс].Ключ
            Или Прочитанные[Индекс].Значение <> Настройки[Индекс].Значение Тогда
            ВызватьИсключение ФабрикаОшибок.Создать(
                КодыОшибокEngineConfig.НекорректнаяКонфигурация(),
                "CFG изменяет настройку при повторном разборе."
            );
        КонецЕсли;
    КонецЦикла;

КонецПроцедуры

Процедура ЗаменитьФайлНазначения(ФайлНазначения, ВременныйПуть, ПутьОтката, ЦельПеремещена)

    Если ФайлНазначения.Существует() Тогда
        ПереместитьФайл(_Путь, ПутьОтката);
        ЦельПеремещена = Истина;
    КонецЕсли;

    ПереместитьФайл(ВременныйПуть, _Путь);
    Если ЦельПеремещена Тогда
        УдалитьФайлы(ПутьОтката);
    КонецЕсли;

КонецПроцедуры

Процедура ОбработатьОшибкуЗаписи(Ошибка, ЦельПеремещена, ВременныйПуть, ПутьОтката, Данные)

    Если ЦельПеремещена Тогда
        Попытка
            ВосстановитьФайлНазначения(ПутьОтката);
        Исключение
            Ошибка = ФабрикаОшибок.Обернуть(
                ИнформацияОбОшибке(),
                КодыОшибокEngineConfig.ЗаписьКонфигурацииНеВыполнена(),
                "Не удалось восстановить CFG из файла отката.",
                Данные
            );
        КонецПопытки;
    КонецЕсли;

    УдалитьВременныйФайл(ВременныйПуть);

    ВызватьИсключение ФабрикаОшибок.Обернуть(
        Ошибка,
        КодыОшибокEngineConfig.ЗаписьКонфигурацииНеВыполнена(),
        "Не удалось записать CFG.",
        Данные
    );

КонецПроцедуры

Процедура ВосстановитьФайлНазначения(ПутьОтката)

    Если Не Новый Файл(_Путь).Существует() И Новый Файл(ПутьОтката).Существует() Тогда
        ПереместитьФайл(ПутьОтката, _Путь);
    КонецЕсли;

КонецПроцедуры

Процедура ПроверитьПару(Настройка)

    Ключ = Настройка.Ключ;
    Значение = Настройка.Значение;

    КлючНепредставим = ПустаяСтрока(Ключ)
        ИЛИ Ключ <> СокрЛП(Ключ)
        Или Найти(Ключ, "=") > 0
        ИЛИ Найти(Ключ, Символы.ВК) > 0
        ИЛИ Найти(Ключ, Символы.ПС) > 0;

    ЗначениеНепредставимо = Найти(Значение, Символы.ВК) > 0
        Или Найти(Значение, Символы.ПС) > 0
        Или Значение <> СокрЛП(Значение);

    Если КлючНепредставим Или ЗначениеНепредставимо Тогда
        ВызватьИсключение ФабрикаОшибок.Создать(
            КодыОшибокEngineConfig.НекорректнаяКонфигурация(),
            "Настройка непредставима в CFG.",
            Новый Структура("Ключ", Ключ)
        );
    КонецЕсли;

КонецПроцедуры

Процедура ПреобразоватьОтносительныеПути(Настройка, Каталог)

    Если Настройка.НормализованныйКлюч = "lib.system" Тогда
        Настройка.Значение = ОтносительныйПуть(Настройка.Значение, Каталог);
    ИначеЕсли Настройка.НормализованныйКлюч = "lib.additional" Тогда
        Пути = Новый Массив;
        Для Каждого АбсолютныйПуть Из СтрРазделить(Настройка.Значение, ";", Ложь) Цикл
            Пути.Добавить(ОтносительныйПуть(АбсолютныйПуть, Каталог));
        КонецЦикла;

        Настройка.Значение = СтрСоединить(Пути, ";");
    КонецЕсли;

КонецПроцедуры

Функция ОтносительныйПуть(АбсолютныйПуть, Каталог)

    Путь = РазобратьАбсолютныйПуть(АбсолютныйПуть);
    База = РазобратьАбсолютныйПуть(Каталог);

    Если Путь.Корень <> База.Корень Тогда
        Возврат АбсолютныйПуть;
    КонецЕсли;

    Разделитель = ?(Лев(Каталог, 1) = "/", "/", "\");
    Общие = 0;
    Пока Общие < Путь.Части.Количество() И Общие < База.Части.Количество() Цикл
        Левая = Путь.Части[Общие];
        Правая = База.Части[Общие];
        Если Разделитель = "\" Тогда
            Левая = НРег(Левая);
            Правая = НРег(Правая);
        КонецЕсли;

        Если Левая <> Правая Тогда
            Прервать;
        КонецЕсли;

        Общие = Общие + 1;
    КонецЦикла;

    Части = Новый Массив;
    Для Индекс = Общие По База.Части.Количество() - 1 Цикл
        Части.Добавить("..");
    КонецЦикла;

    Для Индекс = Общие По Путь.Части.Количество() - 1 Цикл
        Части.Добавить(Путь.Части[Индекс]);
    КонецЦикла;

    Возврат ?(Части.Количество() = 0, ".", СтрСоединить(Части, Разделитель));

КонецФункции

Функция РазобратьАбсолютныйПуть(Путь)

    Части = СтрРазделить(Новый Файл(Путь).ПолноеИмя, "/\", Ложь);
    Корень = "/";

    Если Сред(Путь, 2, 1) = ":" Тогда
        Корень = НРег(Части[0]);
        Части.Удалить(0);
    ИначеЕсли Лев(Путь, 2) = "\\" Тогда
        Корень = "\\" + НРег(Части[0] + "\" + Части[1]);
        Части.Удалить(0);
        Части.Удалить(0);
    КонецЕсли;

    Возврат Новый Структура("Корень,Части", Корень, Части);

КонецФункции

Процедура УдалитьВременныйФайл(Путь)

    Если ПустаяСтрока(Путь) Тогда
        Возврат;
    КонецЕсли;

    Попытка
        Если Новый Файл(Путь).Существует() Тогда
            УдалитьФайлы(Путь);
        КонецЕсли;
    Исключение
        // Сохраняем причину операции; оставшийся временный файл не заменяет целевой.
    КонецПопытки;

КонецПроцедуры

#КонецОбласти
