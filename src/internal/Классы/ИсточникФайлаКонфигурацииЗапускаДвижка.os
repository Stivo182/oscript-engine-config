#Использовать errors

Перем _Путь; // Строка
Перем _Обязательный; // Булево

#Область ОбработчикиСобытий

// Создает источник настроек из CFG-файла.
//
// Параметры:
//  Путь - Строка - Полный путь к CFG-файлу.
//  Обязательный - Булево - Признак ошибки при отсутствии файла.
Процедура ПриСозданииОбъекта(Путь, Обязательный)

    ПроверкаАргументов.ПроверитьТип("Путь", Путь, Тип("Строка"));
    ПроверкаАргументов.ПроверитьТип("Обязательный", Обязательный, Тип("Булево"));

    _Путь = Путь;
    _Обязательный = Обязательный;

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Читает настройки CFG или возвращает пустую таблицу для отсутствующего необязательного файла.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Настройки источника с базой каталога CFG.
Функция ПолучитьНастройки() Экспорт

    Если Не _Обязательный И Не Новый Файл(_Путь).Существует() Тогда
        Возврат СервисыКонфигурацииЗапускаДвижка.НоваяТаблицаНастроек();
    КонецЕсли;

    Возврат Новый ФайлКонфигурацииЗапускаДвижка(_Путь).Прочитать();

КонецФункции

#КонецОбласти
