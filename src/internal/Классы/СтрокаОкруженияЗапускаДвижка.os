#Использовать errors

#Область ПрограммныйИнтерфейс

// Разбирает строку OSCRIPT_CONFIG по грамматике параметров движка.
//
// Параметры:
//  Текст - Строка - Текст переменной окружения.
//  БазовыйКаталог - Строка - Базовый каталог значений источника.
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. СервисыКонфигурацииЗапускаДвижка.НоваяТаблицаНастроек.
Функция Разобрать(Текст, БазовыйКаталог) Экспорт

    Результат = СервисыКонфигурацииЗапускаДвижка.НоваяТаблицаНастроек();

    Буква = Новый РегулярноеВыражение("^\p{L}$");
    БукваИлиЦифра = Новый РегулярноеВыражение("^[\p{L}\p{Nd}]$");
    Пробел = Новый РегулярноеВыражение("^\s$");
    Длина = СтрДлина(Текст);
    Позиция = 1;

    Пока Позиция <= Длина Цикл
        ПропуститьПробелы(Текст, Позиция, Длина, Пробел);
        ПроверитьНаличиеИмени(Позиция, Длина);

        Если Не Буква.Совпадает(Сред(Текст, Позиция, 1)) Тогда
            Прервать;
        КонецЕсли;

        Ключ = ПрочитатьКлюч(Текст, Позиция, Длина, БукваИлиЦифра, Пробел);
        Если Ключ = Неопределено Тогда
            Прервать;
        КонецЕсли;

        ПропуститьПробелы(Текст, Позиция, Длина, Пробел);
        Значение = ПрочитатьЗначение(Текст, Позиция, Длина);
        ПропуститьПробелы(Текст, Позиция, Длина, Пробел);
        ПропуститьРазделитель(Текст, Позиция);

        СервисыКонфигурацииЗапускаДвижка.УстановитьНастройкуИсточника(
            Результат,
            Ключ,
            Значение,
            БазовыйКаталог
        );
    КонецЦикла;

    Возврат Результат;

КонецФункции

// Сериализует настройки в OSCRIPT_CONFIG и проверяет обратимость представления.
//
// Параметры:
//  Настройки - ТаблицаЗначений - см. СервисыКонфигурацииЗапускаДвижка.НоваяТаблицаНастроек.
//
// Возвращаемое значение:
//  Строка - Упорядоченные пары с абсолютными путями библиотек.
Функция Сформировать(Знач Настройки) Экспорт

    Настройки = Настройки.Скопировать();
    Настройки.Сортировать("НормализованныйКлюч, Ключ");

    ДопустимыйКлюч = Новый РегулярноеВыражение("^[A-Za-z][A-Za-z0-9._]*$");
    Пары = Новый Массив;

    Для Каждого Настройка Из Настройки Цикл
        ПроверитьНастройку(Настройка, ДопустимыйКлюч);

        Настройка.Значение = СервисыКонфигурацииЗапускаДвижка.АбсолютноеЗначениеНастройки(Настройка);
        Пары.Добавить(Настройка.Ключ + "=""" + СтрЗаменить(Настройка.Значение, """", """""") + """");
    КонецЦикла;

    Текст = СтрСоединить(Пары, ";");
    ПроверитьОбратимость(Текст, Настройки);

    Возврат Текст;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПропуститьПробелы(Текст, Позиция, Длина, Пробел)

    Пока Позиция <= Длина И Пробел.Совпадает(Сред(Текст, Позиция, 1)) Цикл
        Позиция = Позиция + 1;
    КонецЦикла;

КонецПроцедуры

Процедура ПроверитьНаличиеИмени(Позиция, Длина)

    Если Позиция > Длина Тогда
        ВызватьИсключение ФабрикаОшибок.Создать(
            КодыОшибокEngineConfig.НекорректнаяКонфигурация(),
            "После пробелов OSCRIPT_CONFIG ожидалось имя настройки."
        );
    КонецЕсли;

КонецПроцедуры

Функция ПрочитатьКлюч(Текст, Позиция, Длина, БукваИлиЦифра, Пробел)

    НачалоИмени = Позиция;
    Позиция = Позиция + 1;

    Пока Позиция <= Длина Цикл
        Символ = Сред(Текст, Позиция, 1);
        Если Символ = "=" Тогда
            Прервать;
        КонецЕсли;

        Если Не ДопустимыйСимволКлюча(Символ, БукваИлиЦифра, Пробел) Тогда
            Возврат Неопределено;
        КонецЕсли;

        Позиция = Позиция + 1;
    КонецЦикла;

    Если Позиция > Длина Тогда
        Возврат Неопределено;
    КонецЕсли;

    Ключ = СокрЛП(Сред(Текст, НачалоИмени, Позиция - НачалоИмени));
    Позиция = Позиция + 1;

    Возврат Ключ;

КонецФункции

Функция ДопустимыйСимволКлюча(Символ, БукваИлиЦифра, Пробел)
    Возврат БукваИлиЦифра.Совпадает(Символ) Или Символ = "." Или Символ = "_" Или Пробел.Совпадает(Символ);
КонецФункции

Функция ПрочитатьЗначение(Текст, Позиция, Длина)

    ПервыйСимвол = Сред(Текст, Позиция, 1);
    Терминатор = ?(ПервыйСимвол = "'" Или ПервыйСимвол = """", ПервыйСимвол, " ");
    Если Терминатор <> " " Тогда
        Позиция = Позиция + 1;
    КонецЕсли;

    Значение = "";
    Пока Позиция <= Длина Цикл
        Символ = Сред(Текст, Позиция, 1);
        Если Символ = Терминатор Тогда
            Если Сред(Текст, Позиция + 1, 1) = Терминатор Тогда
                Значение = Значение + Терминатор;
                Позиция = Позиция + 2;
                Продолжить;
            КонецЕсли;

            Позиция = Позиция + 1;
            Прервать;
        КонецЕсли;

        Если Терминатор = " " И Символ = ";" Тогда
            Прервать;
        КонецЕсли;

        Значение = Значение + Символ;
        Позиция = Позиция + 1;
    КонецЦикла;

    Возврат Значение;

КонецФункции

Процедура ПропуститьРазделитель(Текст, Позиция)

    Если Сред(Текст, Позиция, 1) = ";" Тогда
        Позиция = Позиция + 1;
    КонецЕсли;

КонецПроцедуры

Процедура ПроверитьНастройку(Настройка, ДопустимыйКлюч)

    Если Не ДопустимыйКлюч.Совпадает(Настройка.Ключ) Или Найти(Настройка.Значение, Символ(0)) > 0 Тогда
        ВызватьИсключение ФабрикаОшибок.Создать(
            КодыОшибокEngineConfig.НекорректнаяКонфигурация(),
            "Настройка непредставима в OSCRIPT_CONFIG.",
            Новый Структура("Ключ", Настройка.Ключ)
        );
    КонецЕсли;

КонецПроцедуры

Процедура ПроверитьОбратимость(Текст, Настройки)

    Прочитанные = Разобрать(Текст, "");
    Если Прочитанные.Количество() <> Настройки.Количество() Тогда
        ВызватьИсключение ФабрикаОшибок.Создать(
            КодыОшибокEngineConfig.НекорректнаяКонфигурация(),
            "OSCRIPT_CONFIG изменяет количество настроек при повторном разборе."
        );
    КонецЕсли;

    Для Индекс = 0 По Настройки.Количество() - 1 Цикл
        Если Прочитанные[Индекс].Ключ <> Настройки[Индекс].Ключ
            Или Прочитанные[Индекс].Значение <> Настройки[Индекс].Значение Тогда
            ВызватьИсключение ФабрикаОшибок.Создать(
                КодыОшибокEngineConfig.НекорректнаяКонфигурация(),
                "OSCRIPT_CONFIG изменяет настройку при повторном разборе.",
                Новый Структура("Ключ", Настройки[Индекс].Ключ)
            );
        КонецЕсли;
    КонецЦикла;

КонецПроцедуры

#КонецОбласти
