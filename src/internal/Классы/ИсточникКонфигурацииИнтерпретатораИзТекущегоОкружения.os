#Использовать errors

Перем _База; // Строка, Неопределено

#Область ОбработчикиСобытий

// Создает динамический источник текущего OSCRIPT_CONFIG.
//
// Параметры:
//  База - Строка, Неопределено - База относительных путей источника;
//         Неопределено использует текущий каталог при получении настроек.
Процедура ПриСозданииОбъекта(База = Неопределено)

    ПроверкаАргументов.ПроверитьТип("База", База, "Строка,Неопределено");

    _База = База;

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Читает текущее OSCRIPT_CONFIG с переданной или текущей базой.
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. ОперацииСНастройкамиКонфигурацииИнтерпретатора.НоваяТаблицаНастроек.
Функция ПолучитьНастройки() Экспорт

    СтрокаНастроек = ПолучитьПеременнуюСреды("OSCRIPT_CONFIG");
    Если СтрокаНастроек = Неопределено Тогда
        СтрокаНастроек = "";
    КонецЕсли;

    База = ?(_База = Неопределено, ТекущийКаталог(), _База);
    Возврат Новый СтрокаОкруженияКонфигурацииИнтерпретатора().Разобрать(СтрокаНастроек, База);

КонецФункции

#КонецОбласти
