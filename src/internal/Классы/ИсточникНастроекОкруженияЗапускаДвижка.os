#Использовать errors

Перем _СтрокаНастроек; // Строка
Перем _База; // Строка, Неопределено

#Область ОбработчикиСобытий

// Создает источник из явно заданной строки OSCRIPT_CONFIG.
//
// Параметры:
//  СтрокаНастроек - Строка - Настройки по грамматике OSCRIPT_CONFIG.
//  База - Строка, Неопределено - База относительных путей источника;
//         Неопределено использует текущий каталог при получении настроек.
Процедура ПриСозданииОбъекта(СтрокаНастроек, База = Неопределено)

    ПроверкаАргументов.ПроверитьТип("СтрокаНастроек", СтрокаНастроек, Тип("Строка"));
    ПроверкаАргументов.ПроверитьТип("База", База, "Строка,Неопределено");

    _СтрокаНастроек = СтрокаНастроек;
    _База = База;

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Разбирает сохраненную строку настроек.
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. СервисыКонфигурацииЗапускаДвижка.НоваяТаблицаНастроек.
Функция ПолучитьНастройки() Экспорт
    База = ?(_База = Неопределено, ТекущийКаталог(), _База);
    Возврат Новый СтрокаОкруженияЗапускаДвижка().Разобрать(_СтрокаНастроек, База);
КонецФункции

#КонецОбласти
